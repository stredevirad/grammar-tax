PayloadDescription-kv ::= "\"PayloadDescription\"" space ":" space string
PayloadDescription-rest ::= ( "," space PayloadDisplayName-kv )? PayloadDisplayName-rest
PayloadDisplayName-kv ::= "\"PayloadDisplayName\"" space ":" space string
PayloadDisplayName-rest ::= ( "," space PayloadIdentifier-kv )? PayloadIdentifier-rest
PayloadIdentifier-kv ::= "\"PayloadIdentifier\"" space ":" space string
PayloadIdentifier-rest ::= ( "," space PayloadOrganization-kv )? PayloadOrganization-rest
PayloadOrganization-kv ::= "\"PayloadOrganization\"" space ":" space string
PayloadOrganization-rest ::= ( "," space PayloadType-kv )? PayloadType-rest
PayloadType-kv ::= "\"PayloadType\"" space ":" space string
PayloadType-rest ::= ( "," space PayloadUUID-kv )? PayloadUUID-rest
PayloadUUID ::= "\"" (PayloadUUID-1{8,8} "-" PayloadUUID-1{4,4} "-" PayloadUUID-1{4,4} "-" PayloadUUID-1{4,4} "-" PayloadUUID-1{12,12}) "\""
PayloadUUID-1 ::= [0-9A-Za-z]
PayloadUUID-kv ::= "\"PayloadUUID\"" space ":" space PayloadUUID
PayloadUUID-rest ::= ( "," space PayloadVersion-kv )? PayloadVersion-rest
PayloadVersion-kv ::= "\"PayloadVersion\"" space ":" space number
PayloadVersion-rest ::= ( "," space familyControlsEnabled-kv )? familyControlsEnabled-rest
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
familyControlsEnabled-kv ::= "\"familyControlsEnabled\"" space ":" space boolean
familyControlsEnabled-rest ::= ( "," space limits-list-kv )?
integral-part ::= [0] | [1-9] [0-9]{0,15}
limits-list ::= "{" space  (limits-list-weekday-allowance-kv limits-list-weekday-allowance-rest | limits-list-weekday-curfew-kv limits-list-weekday-curfew-rest | limits-list-weekend-allowance-kv limits-list-weekend-allowance-rest | limits-list-weekend-curfew-kv )? space "}"
limits-list-kv ::= "\"limits-list\"" space ":" space limits-list
limits-list-weekday-allowance ::= "{" space  (limits-list-weekday-allowance-enabled-kv limits-list-weekday-allowance-enabled-rest | limits-list-weekday-allowance-end-kv limits-list-weekday-allowance-end-rest | limits-list-weekday-allowance-rangeType-kv limits-list-weekday-allowance-rangeType-rest | limits-list-weekday-allowance-secondsPerDay-kv limits-list-weekday-allowance-secondsPerDay-rest | limits-list-weekday-allowance-start-kv )? space "}"
limits-list-weekday-allowance-enabled-kv ::= "\"enabled\"" space ":" space boolean
limits-list-weekday-allowance-enabled-rest ::= ( "," space limits-list-weekday-allowance-end-kv )? limits-list-weekday-allowance-end-rest
limits-list-weekday-allowance-end-kv ::= "\"end\"" space ":" space string
limits-list-weekday-allowance-end-rest ::= ( "," space limits-list-weekday-allowance-rangeType-kv )? limits-list-weekday-allowance-rangeType-rest
limits-list-weekday-allowance-kv ::= "\"weekday-allowance\"" space ":" space limits-list-weekday-allowance
limits-list-weekday-allowance-rangeType-kv ::= "\"rangeType\"" space ":" space number
limits-list-weekday-allowance-rangeType-rest ::= ( "," space limits-list-weekday-allowance-secondsPerDay-kv )? limits-list-weekday-allowance-secondsPerDay-rest
limits-list-weekday-allowance-rest ::= ( "," space limits-list-weekday-curfew-kv )? limits-list-weekday-curfew-rest
limits-list-weekday-allowance-secondsPerDay-kv ::= "\"secondsPerDay\"" space ":" space number
limits-list-weekday-allowance-secondsPerDay-rest ::= ( "," space limits-list-weekday-allowance-start-kv )?
limits-list-weekday-allowance-start-kv ::= "\"start\"" space ":" space string
limits-list-weekday-curfew ::= "{" space  (limits-list-weekday-curfew-enabled-kv limits-list-weekday-curfew-enabled-rest | limits-list-weekday-curfew-end-kv limits-list-weekday-curfew-end-rest | limits-list-weekday-curfew-rangeType-kv limits-list-weekday-curfew-rangeType-rest | limits-list-weekday-curfew-secondsPerDay-kv limits-list-weekday-curfew-secondsPerDay-rest | limits-list-weekday-curfew-start-kv )? space "}"
limits-list-weekday-curfew-enabled-kv ::= "\"enabled\"" space ":" space boolean
limits-list-weekday-curfew-enabled-rest ::= ( "," space limits-list-weekday-curfew-end-kv )? limits-list-weekday-curfew-end-rest
limits-list-weekday-curfew-end-kv ::= "\"end\"" space ":" space string
limits-list-weekday-curfew-end-rest ::= ( "," space limits-list-weekday-curfew-rangeType-kv )? limits-list-weekday-curfew-rangeType-rest
limits-list-weekday-curfew-kv ::= "\"weekday-curfew\"" space ":" space limits-list-weekday-curfew
limits-list-weekday-curfew-rangeType-kv ::= "\"rangeType\"" space ":" space number
limits-list-weekday-curfew-rangeType-rest ::= ( "," space limits-list-weekday-curfew-secondsPerDay-kv )? limits-list-weekday-curfew-secondsPerDay-rest
limits-list-weekday-curfew-rest ::= ( "," space limits-list-weekend-allowance-kv )? limits-list-weekend-allowance-rest
limits-list-weekday-curfew-secondsPerDay-kv ::= "\"secondsPerDay\"" space ":" space number
limits-list-weekday-curfew-secondsPerDay-rest ::= ( "," space limits-list-weekday-curfew-start-kv )?
limits-list-weekday-curfew-start-kv ::= "\"start\"" space ":" space string
limits-list-weekend-allowance ::= "{" space  (limits-list-weekend-allowance-enabled-kv limits-list-weekend-allowance-enabled-rest | limits-list-weekend-allowance-end-kv limits-list-weekend-allowance-end-rest | limits-list-weekend-allowance-rangeType-kv limits-list-weekend-allowance-rangeType-rest | limits-list-weekend-allowance-secondsPerDay-kv limits-list-weekend-allowance-secondsPerDay-rest | limits-list-weekend-allowance-start-kv )? space "}"
limits-list-weekend-allowance-enabled-kv ::= "\"enabled\"" space ":" space boolean
limits-list-weekend-allowance-enabled-rest ::= ( "," space limits-list-weekend-allowance-end-kv )? limits-list-weekend-allowance-end-rest
limits-list-weekend-allowance-end-kv ::= "\"end\"" space ":" space string
limits-list-weekend-allowance-end-rest ::= ( "," space limits-list-weekend-allowance-rangeType-kv )? limits-list-weekend-allowance-rangeType-rest
limits-list-weekend-allowance-kv ::= "\"weekend-allowance\"" space ":" space limits-list-weekend-allowance
limits-list-weekend-allowance-rangeType-kv ::= "\"rangeType\"" space ":" space number
limits-list-weekend-allowance-rangeType-rest ::= ( "," space limits-list-weekend-allowance-secondsPerDay-kv )? limits-list-weekend-allowance-secondsPerDay-rest
limits-list-weekend-allowance-rest ::= ( "," space limits-list-weekend-curfew-kv )?
limits-list-weekend-allowance-secondsPerDay-kv ::= "\"secondsPerDay\"" space ":" space number
limits-list-weekend-allowance-secondsPerDay-rest ::= ( "," space limits-list-weekend-allowance-start-kv )?
limits-list-weekend-allowance-start-kv ::= "\"start\"" space ":" space string
limits-list-weekend-curfew ::= "{" space  (limits-list-weekend-curfew-enabled-kv limits-list-weekend-curfew-enabled-rest | limits-list-weekend-curfew-end-kv limits-list-weekend-curfew-end-rest | limits-list-weekend-curfew-rangeType-kv limits-list-weekend-curfew-rangeType-rest | limits-list-weekend-curfew-secondsPerDay-kv limits-list-weekend-curfew-secondsPerDay-rest | limits-list-weekend-curfew-start-kv )? space "}"
limits-list-weekend-curfew-enabled-kv ::= "\"enabled\"" space ":" space boolean
limits-list-weekend-curfew-enabled-rest ::= ( "," space limits-list-weekend-curfew-end-kv )? limits-list-weekend-curfew-end-rest
limits-list-weekend-curfew-end-kv ::= "\"end\"" space ":" space string
limits-list-weekend-curfew-end-rest ::= ( "," space limits-list-weekend-curfew-rangeType-kv )? limits-list-weekend-curfew-rangeType-rest
limits-list-weekend-curfew-kv ::= "\"weekend-curfew\"" space ":" space limits-list-weekend-curfew
limits-list-weekend-curfew-rangeType-kv ::= "\"rangeType\"" space ":" space number
limits-list-weekend-curfew-rangeType-rest ::= ( "," space limits-list-weekend-curfew-secondsPerDay-kv )? limits-list-weekend-curfew-secondsPerDay-rest
limits-list-weekend-curfew-secondsPerDay-kv ::= "\"secondsPerDay\"" space ":" space number
limits-list-weekend-curfew-secondsPerDay-rest ::= ( "," space limits-list-weekend-curfew-start-kv )?
limits-list-weekend-curfew-start-kv ::= "\"start\"" space ":" space string
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
root ::= "{" space  (PayloadDescription-kv PayloadDescription-rest | PayloadDisplayName-kv PayloadDisplayName-rest | PayloadIdentifier-kv PayloadIdentifier-rest | PayloadOrganization-kv PayloadOrganization-rest | PayloadType-kv PayloadType-rest | PayloadUUID-kv PayloadUUID-rest | PayloadVersion-kv PayloadVersion-rest | familyControlsEnabled-kv familyControlsEnabled-rest | limits-list-kv )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""

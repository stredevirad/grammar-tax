char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
email ::= "\"" char{0,120} "\""
email-kv ::= "\"email\"" space ":" space email
lists ::= ("\"Daily New\"" | "\"Promotion\"")
lists-kv ::= "\"lists\"" space ":" space lists
name ::= "\"" char{8,80} "\""
name-kv ::= "\"name\"" space ":" space name
root ::= "{" space name-kv "," space email-kv "," space lists-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}

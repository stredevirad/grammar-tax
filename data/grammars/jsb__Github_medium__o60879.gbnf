bundles ::= "{" space "}"
bundles-kv ::= "\"bundles\"" space ":" space bundles
bundles-rest ::= ( "," space next-version-kv )? next-version-rest
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
format ::= string
format-kv ::= "\"format\"" space ":" space format
id ::= "\"" char+ "\""
id-kv ::= "\"id\"" space ":" space id
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
next-version-kv ::= "\"next_version\"" space ":" space integer
next-version-rest ::= ( "," space versions-kv )?
root ::= "{" space id-kv "," space format-kv ( "," space ( bundles-kv bundles-rest | next-version-kv next-version-rest | versions-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
versions ::= "[" space (versions-item ("," space versions-item)*)? space "]"
versions-item ::= ([1-9] [0-9]{0,15})
versions-kv ::= "\"versions\"" space ":" space versions

ref-definitions-total-shares ::= "{" space ref-definitions-total-shares-number-kv ( "," space ( ref-definitions-total-shares-share-class-kv ) )? space "}"
ref-definitions-total-shares-number-kv ::= "\"number\"" space ":" space integer
ref-definitions-total-shares-share-class ::= "\"" char+ "\""
ref-definitions-total-shares-share-class-kv ::= "\"share_class\"" space ":" space ref-definitions-total-shares-share-class
registered-address ::= ref-definitions-address
registered-address-kv ::= "\"registered_address\"" space ":" space registered-address
registered-address-rest ::= ( "," space headquarters-address-kv )? headquarters-address-rest
registry-url ::= string | null
registry-url-kv ::= "\"registry_url\"" space ":" space registry-url
registry-url-rest ::= ( "," space website-kv )? website-rest
retrieved-at-kv ::= "\"retrieved_at\"" space ":" space string
root ::= "{" space company-number-kv "," space name-kv "," space jurisdiction-code-kv "," space retrieved-at-kv ( "," space ( incorporation-date-kv incorporation-date-rest | dissolution-date-kv dissolution-date-rest | current-status-kv current-status-rest | company-type-kv company-type-rest | registry-url-kv registry-url-rest | website-kv website-rest | telephone-number-kv telephone-number-rest | fax-number-kv fax-number-rest | registered-address-kv registered-address-rest | headquarters-address-kv headquarters-address-rest | mailing-address-kv mailing-address-rest | officers-kv officers-rest | share-parcels-kv share-parcels-rest | total-shares-kv total-shares-rest | filings-kv filings-rest | identifiers-kv identifiers-rest | industry-codes-kv industry-codes-rest | previous-names-kv previous-names-rest | alternative-names-kv alternative-names-rest | subsequent-registrations-kv subsequent-registrations-rest | alternate-registrations-kv alternate-registrations-rest | branch-kv branch-rest | all-attributes-kv ) )? space "}"
share-parcels ::= "[" space (share-parcels-item ("," space share-parcels-item)*)? space "]"
share-parcels-item ::= ref-definitions-share-parcel
share-parcels-kv ::= "\"share_parcels\"" space ":" space share-parcels
share-parcels-rest ::= ( "," space total-shares-kv )? total-shares-rest
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
subsequent-registrations ::= "[" space (subsequent-registrations-item ("," space subsequent-registrations-item)*)? space "]"
subsequent-registrations-item ::= ref-definitions-subsequent-registration-schema
subsequent-registrations-kv ::= "\"subsequent_registrations\"" space ":" space subsequent-registrations
subsequent-registrations-rest ::= ( "," space alternate-registrations-kv )? alternate-registrations-rest
telephone-number ::= "\"" char{4,} "\""
telephone-number-kv ::= "\"telephone_number\"" space ":" space telephone-number
telephone-number-rest ::= ( "," space fax-number-kv )? fax-number-rest
total-shares ::= ref-definitions-total-shares
total-shares-kv ::= "\"total_shares\"" space ":" space total-shares
total-shares-rest ::= ( "," space filings-kv )? filings-rest
value ::= object | array | string | number | boolean | null
website ::= website-0 | website-1
website-0 ::= "\"" char{5,} "\""
website-1 ::= website-1-0 | null
website-1-0 ::= "[" space (website-1-0-item ("," space website-1-0-item)*)? space "]"
website-1-0-item ::= "\"" char{5,} "\""
website-kv ::= "\"website\"" space ":" space website
website-rest ::= ( "," space telephone-number-kv )? telephone-number-rest

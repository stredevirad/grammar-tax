boolean ::= ("true" | "false")
include-digits-kv ::= "\"include_digits\"" space ":" space boolean
include-digits-rest ::= ( "," space include-lowercase-kv )? include-lowercase-rest
include-lowercase-kv ::= "\"include_lowercase\"" space ":" space boolean
include-lowercase-rest ::= ( "," space include-symbols-kv )? include-symbols-rest
include-symbols-kv ::= "\"include_symbols\"" space ":" space boolean
include-symbols-rest ::= ( "," space include-uppercase-kv )?
include-uppercase-kv ::= "\"include_uppercase\"" space ":" space boolean
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
length-kv ::= "\"length\"" space ":" space integer
root ::= "{" space length-kv ( "," space ( include-digits-kv include-digits-rest | include-lowercase-kv include-lowercase-rest | include-symbols-kv include-symbols-rest | include-uppercase-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}

array ::= "[" space ( value ("," space value)* )? space "]"
autoPlay-kv ::= "\"autoPlay\"" space ":" space boolean
avaliablePlaybackRates ::= "[" space (number ("," space number)*)? space "]"
avaliablePlaybackRates-kv ::= "\"avaliablePlaybackRates\"" space ":" space avaliablePlaybackRates
avaliableQualityLevels ::= avaliableQualityLevels-0 | null
avaliableQualityLevels-0 ::= "[" space (avaliableQualityLevels-0-item ("," space avaliableQualityLevels-0-item)*)? space "]"
avaliableQualityLevels-0-item ::= "\"" char{0,128} "\""
avaliableQualityLevels-kv ::= "\"avaliableQualityLevels\"" space ":" space avaliableQualityLevels
avaliableQualityLevels-rest ::= ( "," space error-kv )? error-rest
boolean ::= ("true" | "false")
buffering-kv ::= "\"buffering\"" space ":" space boolean
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
controls-kv ::= "\"controls\"" space ":" space boolean
cued-kv ::= "\"cued\"" space ":" space boolean
decimal-part ::= [0-9]{1,16}
error ::= error-0 | error-1
error-0 ::= ("\"INVALID_PARAMETER\"" | "\"HTML5_PLAYER_ERROR\"" | "\"NOT_FOUND\"" | "\"EMBED_DISALLOWED\"")
error-1 ::= ("\"INVALID_PARAMETER\"" | "\"HTML5_PLAYER_ERROR\"" | "\"NOT_FOUND\"" | "\"EMBED_DISALLOWED\"")
error-kv ::= "\"error\"" space ":" space error
error-rest ::= ( "," space fov-kv )? fov-rest
fov ::= number | null
fov-kv ::= "\"fov\"" space ":" space fov
fov-rest ::= ( "," space origin-kv )? origin-rest
integral-part ::= [0] | [1-9] [0-9]{0,15}
loaded ::= ([0-9] | ([1-8] [0-9] | [9] [0-9]) | "100")
loaded-kv ::= "\"loaded\"" space ":" space loaded
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
origin ::= origin-0 | null
origin-0 ::= "\"" char{0,65535} "\""
origin-kv ::= "\"origin\"" space ":" space origin
origin-rest ::= ( "," space pitch-kv )? pitch-rest
pitch ::= number | null
pitch-kv ::= "\"pitch\"" space ":" space pitch
pitch-rest ::= ( "," space playlist-kv )? playlist-rest
playbackQuality ::= "\"" char{0,128} "\""
playbackQuality-kv ::= "\"playbackQuality\"" space ":" space playbackQuality
playerId ::= "\"" char{0,65535} "\""
playerId-kv ::= "\"playerId\"" space ":" space playerId
playlist ::= array | null
playlist-kv ::= "\"playlist\"" space ":" space playlist
playlist-rest ::= ( "," space playlistIndex-kv )? playlistIndex-rest
playlistIndex ::= number | null
playlistIndex-kv ::= "\"playlistIndex\"" space ":" space playlistIndex
playlistIndex-rest ::= ( "," space roll-kv )? roll-rest
roll ::= number | null
roll-kv ::= "\"roll\"" space ":" space roll
roll-rest ::= ( "," space yaw-kv )?
root ::= "{" space autoPlay-kv "," space avaliablePlaybackRates-kv "," space buffering-kv "," space controls-kv "," space cued-kv "," space loaded-kv "," space playbackQuality-kv "," space playerId-kv "," space unstarted-kv "," space url-kv ( "," space ( avaliableQualityLevels-kv avaliableQualityLevels-rest | error-kv error-rest | fov-kv fov-rest | origin-kv origin-rest | pitch-kv pitch-rest | playlist-kv playlist-rest | playlistIndex-kv playlistIndex-rest | roll-kv roll-rest | yaw-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
unstarted-kv ::= "\"unstarted\"" space ":" space boolean
url ::= "\"" char{0,65535} "\""
url-kv ::= "\"url\"" space ":" space url
value ::= object | array | string | number | boolean | null
yaw ::= number | null
yaw-kv ::= "\"yaw\"" space ":" space yaw

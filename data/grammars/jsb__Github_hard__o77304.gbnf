r+ | [^"l] char*) | [^"l] char*) | [^"a] char*) | [^"t] char*) | [^"s] char*) | [^"n] char*) | [^"i] char*) | [^"n] char*) | [v] ([e] ([r] ([s] ([i] ([o] ([n] char+ | [^"n] char*) | [^"o] char*) | [^"i] char*) | [^"s] char*) | [^"r] char*) | [^"e] char*) | [^"iprstuv] char*) | [^"e] char*) | [u] ([b] ([l] ([i] ([s] ([h] char+ | [^"h] char*) | [^"s] char*) | [^"i] char*) | [^"l] char*) | [^"b] char*) | [^"oru] char*) | [r] ([e] ([s] ([t] ([a] ([r] ([t] char+ | [^"t] char*) | [^"r] char*) | [^"a] char*) | [^"t] char*) | [^"s] char*) | [^"e] char*) | [s] ([t] ([a] ([r] ([t] char+ | [^"t] char*) | [^"r] char*) | [o] ([p] char+ | [^"p] char*) | [^"ao] char*) | [^"t] char*) | [t] ([e] ([s] ([t] char+ | [^"t] char*) | [^"s] char*) | [^"e] char*) | [u] ([n] ([i] ([n] ([s] ([t] ([a] ([l] ([l] char+ | [^"l] char*) | [^"l] char*) | [^"a] char*) | [^"t] char*) | [^"s] char*) | [^"n] char*) | [^"i] char*) | [^"n] char*) | [v] ([e] ([r] ([s] ([i] ([o] ([n] char+ | [^"n] char*) | [^"o] char*) | [^"i] char*) | [^"s] char*) | [^"r] char*) | [^"e] char*) | [^"iprstuv] char* )? ["]
scripts-additional-kv ::= scripts-additional-k ":" space string
scripts-install ::= string
scripts-install-kv ::= "\"install\"" space ":" space scripts-install
scripts-install-rest ::= ( "," space scripts-postinstall-kv )? scripts-postinstall-rest
scripts-kv ::= "\"scripts\"" space ":" space scripts
scripts-postinstall ::= string
scripts-postinstall-kv ::= "\"postinstall\"" space ":" space scripts-postinstall
scripts-postinstall-rest ::= ( "," space scripts-preuninstall-kv )? scripts-preuninstall-rest
scripts-postpack-kv ::= "\"postpack\"" space ":" space string
scripts-postpack-rest ::= ( "," space scripts-publish-kv )? scripts-publish-rest
scripts-postpublish ::= string
scripts-postpublish-kv ::= "\"postpublish\"" space ":" space scripts-postpublish
scripts-postpublish-rest ::= ( "," space scripts-preinstall-kv )? scripts-preinstall-rest
scripts-postrestart ::= string
scripts-postrestart-kv ::= "\"postrestart\"" space ":" space scripts-postrestart
scripts-postrestart-rest ::= ( "," space scripts-additional-kv )*
scripts-poststart ::= string
scripts-poststart-kv ::= "\"poststart\"" space ":" space scripts-poststart
scripts-poststart-rest ::= ( "," space scripts-prerestart-kv )? scripts-prerestart-rest
scripts-poststop ::= string
scripts-poststop-kv ::= "\"poststop\"" space ":" space scripts-poststop
scripts-poststop-rest ::= ( "," space scripts-prestart-kv )? scripts-prestart-rest
scripts-posttest ::= string
scripts-posttest-kv ::= "\"posttest\"" space ":" space scripts-posttest
scripts-posttest-rest ::= ( "," space scripts-prestop-kv )? scripts-prestop-rest
scripts-postuninstall-kv ::= "\"postuninstall\"" space ":" space string
scripts-postuninstall-rest ::= ( "," space scripts-preversion-kv )? scripts-preversion-rest
scripts-postversion-kv ::= "\"postversion\"" space ":" space string
scripts-postversion-rest ::= ( "," space scripts-pretest-kv )? scripts-pretest-rest
scripts-preinstall-kv ::= "\"preinstall\"" space ":" space string
scripts-preinstall-rest ::= ( "," space scripts-install-kv )? scripts-install-rest
scripts-prepack-kv ::= "\"prepack\"" space ":" space string
scripts-prepack-rest ::= ( "," space scripts-postpack-kv )? scripts-postpack-rest
scripts-prepare-kv ::= "\"prepare\"" space ":" space string
scripts-prepare-rest ::= ( "," space scripts-prepublishOnly-kv )? scripts-prepublishOnly-rest
scripts-prepublish-kv ::= "\"prepublish\"" space ":" space string
scripts-prepublish-rest ::= ( "," space scripts-prepare-kv )? scripts-prepare-rest
scripts-prepublishOnly-kv ::= "\"prepublishOnly\"" space ":" space string
scripts-prepublishOnly-rest ::= ( "," space scripts-prepack-kv )? scripts-prepack-rest
scripts-prerestart ::= string
scripts-prerestart-kv ::= "\"prerestart\"" space ":" space scripts-prerestart
scripts-prerestart-rest ::= ( "," space scripts-restart-kv )? scripts-restart-rest
scripts-prestart ::= string
scripts-prestart-kv ::= "\"prestart\"" space ":" space scripts-prestart
scripts-prestart-rest ::= ( "," space scripts-start-kv )? scripts-start-rest
scripts-prestop ::= string
scripts-prestop-kv ::= "\"prestop\"" space ":" space scripts-prestop
scripts-prestop-rest ::= ( "," space scripts-stop-kv )? scripts-stop-rest
scripts-pretest ::= string
scripts-pretest-kv ::= "\"pretest\"" space ":" space scripts-pretest
scripts-pretest-rest ::= ( "," space scripts-test-kv )? scripts-test-rest
scripts-preuninstall ::= string
scripts-preuninstall-kv ::= "\"preuninstall\"" space ":" space scripts-preuninstall
scripts-preuninstall-rest ::= ( "," space scripts-uninstall-kv )? scripts-uninstall-rest
scripts-preversion ::= string
scripts-preversion-kv ::= "\"preversion\"" space ":" space scripts-preversion
scripts-preversion-rest ::= ( "," space scripts-version-kv )? scripts-version-rest
scripts-publish ::= string
scripts-publish-kv ::= "\"publish\"" space ":" space scripts-publish
scripts-publish-rest ::= ( "," space scripts-postpublish-kv )? scripts-postpublish-rest
scripts-restart ::= string
scripts-restart-kv ::= "\"restart\"" space ":" space scripts-restart
scripts-restart-rest ::= ( "," space scripts-postrestart-kv )? scripts-postrestart-rest
scripts-start ::= string
scripts-start-kv ::= "\"start\"" space ":" space scripts-start
scripts-start-rest ::= ( "," space scripts-poststart-kv )? scripts-poststart-rest
scripts-stop ::= string
scripts-stop-kv ::= "\"stop\"" space ":" space scripts-stop
scripts-stop-rest ::= ( "," space scripts-poststop-kv )? scripts-poststop-rest
scripts-test ::= string
scripts-test-kv ::= "\"test\"" space ":" space scripts-test
scripts-test-rest ::= ( "," space scripts-posttest-kv )? scripts-posttest-rest
scripts-uninstall ::= string
scripts-uninstall-kv ::= "\"uninstall\"" space ":" space scripts-uninstall
scripts-uninstall-rest ::= ( "," space scripts-postuninstall-kv )? scripts-postuninstall-rest
scripts-version ::= string
scripts-version-kv ::= "\"version\"" space ":" space scripts-version
scripts-version-rest ::= ( "," space scripts-postversion-kv )? scripts-postversion-rest
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
types-kv ::= "\"types\"" space ":" space string
typings-kv ::= "\"typings\"" space ":" space string
value ::= object | array | string | number | boolean | null
version-kv ::= "\"version\"" space ":" space string

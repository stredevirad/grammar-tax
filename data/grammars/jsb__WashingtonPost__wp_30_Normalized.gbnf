-id ::= string
-id-kv ::= "\"_id\"" space ":" space -id
-id-rest ::= ( "," space additional-properties-kv )? additional-properties-rest
additional-properties ::= ref-definitions-traits-trait-additional-properties-json
additional-properties-kv ::= "\"additional_properties\"" space ":" space additional-properties
additional-properties-rest ::= ( "," space alignment-kv )? alignment-rest
alignment ::= ref-definitions-traits-trait-alignment-json
alignment-kv ::= "\"alignment\"" space ":" space alignment
alignment-rest ::= ( "," space channels-kv )? channels-rest
array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
channels ::= ref-definitions-traits-trait-channel-json
channels-kv ::= "\"channels\"" space ":" space channels
channels-rest ::= ( "," space max-kv )? max-rest
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
max-kv ::= "\"max\"" space ":" space number
max-rest ::= ( "," space min-kv )? min-rest
min-kv ::= "\"min\"" space ":" space number
min-rest ::= ( "," space subtype-kv )? subtype-rest
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
numeric-rating-kv ::= "\"numeric_rating\"" space ":" space number
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
ref-definitions-traits-trait-additional-properties-json ::= object
ref-definitions-traits-trait-alignment-json ::= ("\"left\"" | "\"right\"" | "\"center\"")
ref-definitions-traits-trait-channel-json ::= "[" space (string ("," space string)*)? space "]"
root ::= "{" space numeric-rating-kv ( "," space ( -id-kv -id-rest | additional-properties-kv additional-properties-rest | alignment-kv alignment-rest | channels-kv channels-rest | max-kv max-rest | min-kv min-rest | subtype-kv subtype-rest | type-kv type-rest | units-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
subtype ::= string
subtype-kv ::= "\"subtype\"" space ":" space subtype
subtype-rest ::= ( "," space type-kv )? type-rest
type ::= ("\"numeric_rating\"")
type-kv ::= "\"type\"" space ":" space type
type-rest ::= ( "," space units-kv )?
units-kv ::= "\"units\"" space ":" space string
value ::= object | array | string | number | boolean | null

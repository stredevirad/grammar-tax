AWSTemplateFormatVersion ::= ("\"2010-09-09\"")
AWSTemplateFormatVersion-kv ::= "\"AWSTemplateFormatVersion\"" space ":" space AWSTemplateFormatVersion
AWSTemplateFormatVersion-rest ::= ( "," space Conditions-kv )? Conditions-rest
Conditions ::= "{" space "}"
Conditions-kv ::= "\"Conditions\"" space ":" space Conditions
Conditions-rest ::= ( "," space Description-kv )? Description-rest
Description ::= "\"" char{0,1024} "\""
Description-kv ::= "\"Description\"" space ":" space Description
Description-rest ::= ( "," space Mappings-kv )? Mappings-rest
Mappings ::= "{" space "}"
Mappings-kv ::= "\"Mappings\"" space ":" space Mappings
Mappings-rest ::= ( "," space Metadata-kv )? Metadata-rest
Metadata ::= object
Metadata-kv ::= "\"Metadata\"" space ":" space Metadata
Metadata-rest ::= ( "," space Outputs-kv )? Outputs-rest
Outputs ::= "{" space "}"
Outputs-kv ::= "\"Outputs\"" space ":" space Outputs
Outputs-rest ::= ( "," space Parameters-kv )? Parameters-rest
Parameters ::= "{" space "}"
Parameters-kv ::= "\"Parameters\"" space ":" space Parameters
Parameters-rest ::= ( "," space Transform-kv )?
Resources ::= "{" space "}"
Resources-kv ::= "\"Resources\"" space ":" space Resources
Transform ::= Transform-0 | Transform-1
Transform-0 ::= string
Transform-1 ::= "[" space (string ("," space string)*)? space "]"
Transform-kv ::= "\"Transform\"" space ":" space Transform
array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
root ::= "{" space Resources-kv ( "," space ( AWSTemplateFormatVersion-kv AWSTemplateFormatVersion-rest | Conditions-kv Conditions-rest | Description-kv Description-rest | Mappings-kv Mappings-rest | Metadata-kv Metadata-rest | Outputs-kv Outputs-rest | Parameters-kv Parameters-rest | Transform-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
value ::= object | array | string | number | boolean | null

array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
item ::= item-0 | item-1 | item-2
item-0 ::= "{" space item-0-path-kv "," space item-0-op-kv "," space item-0-value-kv space "}"
item-0-op ::= ("\"add\"" | "\"replace\"" | "\"test\"")
item-0-op-kv ::= "\"op\"" space ":" space item-0-op
item-0-path ::= string
item-0-path-kv ::= "\"path\"" space ":" space item-0-path
item-0-value ::= value
item-0-value-kv ::= "\"value\"" space ":" space item-0-value
item-1 ::= "{" space item-1-path-kv "," space item-1-op-kv space "}"
item-1-op ::= ("\"remove\"")
item-1-op-kv ::= "\"op\"" space ":" space item-1-op
item-1-path ::= string
item-1-path-kv ::= "\"path\"" space ":" space item-1-path
item-2 ::= "{" space item-2-path-kv "," space item-2-op-kv "," space item-2-from-kv space "}"
item-2-from ::= string
item-2-from-kv ::= "\"from\"" space ":" space item-2-from
item-2-op ::= ("\"move\"" | "\"copy\"")
item-2-op-kv ::= "\"op\"" space ":" space item-2-op
item-2-path ::= string
item-2-path-kv ::= "\"path\"" space ":" space item-2-path
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
root ::= "[" space (item ("," space item)*)? space "]"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
value ::= object | array | string | number | boolean | null

char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
created-at-kv ::= "\"created_at\"" space ":" space string
ended-at ::= string | null
ended-at-kv ::= "\"ended_at\"" space ":" space ended-at
ended-at-rest ::= ( "," space last-state-change-reason-kv )?
jobflow-id ::= "\"" char{0,32} "\""
jobflow-id-kv ::= "\"jobflow_id\"" space ":" space jobflow-id
last-state-change-reason ::= last-state-change-reason-0 | null
last-state-change-reason-0 ::= "\"" char{0,255} "\""
last-state-change-reason-kv ::= "\"last_state_change_reason\"" space ":" space last-state-change-reason
name ::= "\"" char{0,255} "\""
name-kv ::= "\"name\"" space ":" space name
null ::= "null"
root ::= "{" space created-at-kv "," space jobflow-id-kv "," space name-kv "," space state-kv ( "," space ( ended-at-kv ended-at-rest | last-state-change-reason-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
state ::= ("\"STARTING\"" | "\"BOOTSTRAPPING\"" | "\"RUNNING\"" | "\"WAITING\"" | "\"TERMINATING\"" | "\"TERMINATED\"" | "\"TERMINATED_WITH_ERRORS\"")
state-kv ::= "\"state\"" space ":" space state
string ::= "\"" char* "\""

aal ::= ("\"/ndmg_atlases/labels/AAL.nii.gz\"")
aal-kv ::= "\"aal\"" space ":" space aal
aal-rest ::= ( "," space clean-kv )? clean-rest
atlas ::= ("\"/ndmg_atlases/atlas/MNI152_T1_1mm.nii.gz\"")
atlas-kv ::= "\"atlas\"" space ":" space atlas
boolean ::= ("true" | "false")
bval-file-kv ::= "\"bval_file\"" space ":" space string
bvec-file-kv ::= "\"bvec_file\"" space ":" space string
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
clean-kv ::= "\"clean\"" space ":" space boolean
clean-rest ::= ( "," space cpac200-kv )? cpac200-rest
cpac200 ::= ("\"/ndmg_atlases/labels/CPAC200.nii.gz\"")
cpac200-kv ::= "\"cpac200\"" space ":" space cpac200
cpac200-rest ::= ( "," space desikan-kv )? desikan-rest
desikan ::= ("\"/ndmg_atlases/labels/desikan.nii.gz\"")
desikan-kv ::= "\"desikan\"" space ":" space desikan
desikan-rest ::= ( "," space dti-file-kv )? dti-file-rest
dti-file-kv ::= "\"dti_file\"" space ":" space string
dti-file-minc-kv ::= "\"dti_file_minc\"" space ":" space string
dti-file-minc-rest ::= ( "," space extra1-kv )? extra1-rest
dti-file-rest ::= ( "," space dti-file-minc-kv )? dti-file-minc-rest
extra1-kv ::= "\"extra1\"" space ":" space string
extra1-rest ::= ( "," space extra2-kv )? extra2-rest
extra2-kv ::= "\"extra2\"" space ":" space string
extra2-rest ::= ( "," space extra3-kv )? extra3-rest
extra3-kv ::= "\"extra3\"" space ":" space string
extra3-rest ::= ( "," space harvardoxford-kv )? harvardoxford-rest
harvardoxford ::= ("\"/ndmg_atlases/labels/HarvardOxford.nii.gz\"")
harvardoxford-kv ::= "\"harvardoxford\"" space ":" space harvardoxford
harvardoxford-rest ::= ( "," space jhu-kv )? jhu-rest
jhu ::= ("\"/ndmg_atlases/labels/JHU.nii.gz\"")
jhu-kv ::= "\"jhu\"" space ":" space jhu
jhu-rest ::= ( "," space talairach-kv )?
mask ::= ("\"/ndmg_atlases/atlas/MNI152_T1_1mm_brain_mask.nii.gz\"")
mask-kv ::= "\"mask\"" space ":" space mask
mprage-file-kv ::= "\"mprage_file\"" space ":" space string
outdir-kv ::= "\"outdir\"" space ":" space string
root ::= "{" space atlas-kv "," space bval-file-kv "," space bvec-file-kv "," space mask-kv "," space mprage-file-kv "," space outdir-kv ( "," space ( aal-kv aal-rest | clean-kv clean-rest | cpac200-kv cpac200-rest | desikan-kv desikan-rest | dti-file-kv dti-file-rest | dti-file-minc-kv dti-file-minc-rest | extra1-kv extra1-rest | extra2-kv extra2-rest | extra3-kv extra3-rest | harvardoxford-kv harvardoxford-rest | jhu-kv jhu-rest | talairach-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
talairach ::= ("\"/ndmg_atlases/labels/Talairach.nii.gz\"")
talairach-kv ::= "\"talairach\"" space ":" space talairach

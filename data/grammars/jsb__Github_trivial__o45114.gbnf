char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
item ::= null | item-1
item-1 ::= "{" space  (item-1-id-kv item-1-id-rest | item-1-count-kv item-1-count-rest | item-1-binding-kv item-1-binding-rest | item-1-bound-to-kv item-1-bound-to-rest | item-1-dyes-kv )? space "}"
item-1-binding-kv ::= "\"binding\"" space ":" space string
item-1-binding-rest ::= ( "," space item-1-bound-to-kv )? item-1-bound-to-rest
item-1-bound-to-kv ::= "\"bound_to\"" space ":" space string
item-1-bound-to-rest ::= ( "," space item-1-dyes-kv )?
item-1-count-kv ::= "\"count\"" space ":" space number
item-1-count-rest ::= ( "," space item-1-binding-kv )? item-1-binding-rest
item-1-dyes ::= "[" space (number ("," space number)*)? space "]"
item-1-dyes-kv ::= "\"dyes\"" space ":" space item-1-dyes
item-1-id-kv ::= "\"id\"" space ":" space number
item-1-id-rest ::= ( "," space item-1-count-kv )? item-1-count-rest
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
root ::= "[" space (item ("," space item)*)? space "]"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""

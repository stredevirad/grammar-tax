account-kv ::= "\"account\"" space ":" space string
boolean ::= ("true" | "false")
brand-kv ::= "\"brand\"" space ":" space string
ccNames-kv ::= "\"ccNames\"" space ":" space string
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
createdAt-kv ::= "\"createdAt\"" space ":" space string
dueDate ::= string | null
dueDate-kv ::= "\"dueDate\"" space ":" space dueDate
externalId ::= string | null
externalId-kv ::= "\"externalId\"" space ":" space externalId
groupAssigned ::= string | null
groupAssigned-kv ::= "\"groupAssigned\"" space ":" space groupAssigned
inBusinessHours-kv ::= "\"inBusinessHours\"" space ":" space boolean
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
latestComment-kv ::= "\"latestComment\"" space ":" space string
latestCommentAuthorName-kv ::= "\"latestCommentAuthorName\"" space ":" space string
latestCommentIsPublic-kv ::= "\"latestCommentIsPublic\"" space ":" space boolean
null ::= "null"
organizationId ::= integer | null
organizationId-kv ::= "\"organizationId\"" space ":" space organizationId
organizationName ::= string | null
organizationName-kv ::= "\"organizationName\"" space ":" space organizationName
priority ::= priority-0 | priority-1
priority-0 ::= ("\"Low\"" | "\"Normal\"" | "\"High\"" | "\"Urgent\"" | "null")
priority-1 ::= ("\"Low\"" | "\"Normal\"" | "\"High\"" | "\"Urgent\"" | "null")
priority-kv ::= "\"priority\"" space ":" space priority
root ::= "{" space account-kv "," space brand-kv "," space ccNames-kv "," space createdAt-kv "," space dueDate-kv "," space externalId-kv "," space groupAssigned-kv "," space inBusinessHours-kv "," space latestComment-kv "," space latestCommentAuthorName-kv "," space latestCommentIsPublic-kv "," space organizationId-kv "," space organizationName-kv "," space priority-kv "," space status-kv "," space tags-kv "," space ticketId-kv "," space ticketTitle-kv "," space ticketType-kv "," space updatedAt-kv "," space url-kv "," space via-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
status ::= ("\"New\"" | "\"Open\"" | "\"Pending\"" | "\"On-hold\"" | "\"Solved\"" | "\"Closed\"")
status-kv ::= "\"status\"" space ":" space status
string ::= "\"" char* "\""
tags ::= string | null
tags-kv ::= "\"tags\"" space ":" space tags
ticketId-kv ::= "\"ticketId\"" space ":" space integer
ticketTitle-kv ::= "\"ticketTitle\"" space ":" space string
ticketType ::= ticketType-0 | ticketType-1
ticketType-0 ::= ("\"Question\"" | "\"Incident\"" | "\"Problem\"" | "\"Task\"" | "\"Ticket\"" | "null")
ticketType-1 ::= ("\"Question\"" | "\"Incident\"" | "\"Problem\"" | "\"Task\"" | "\"Ticket\"" | "null")
ticketType-kv ::= "\"ticketType\"" space ":" space ticketType
updatedAt-kv ::= "\"updatedAt\"" space ":" space string
url-kv ::= "\"url\"" space ":" space string
via-kv ::= "\"via\"" space ":" space string

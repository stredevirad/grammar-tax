boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
comments ::= "[" space (comments-item ("," space comments-item)*)? space "]"
comments-item ::= "{" space comments-item-commentBy-kv "," space comments-item-commentTime-kv "," space comments-item-content-kv space "}"
comments-item-commentBy-kv ::= "\"commentBy\"" space ":" space string
comments-item-commentTime-kv ::= "\"commentTime\"" space ":" space string
comments-item-content-kv ::= "\"content\"" space ":" space string
comments-kv ::= "\"comments\"" space ":" space comments
comments-rest ::= ( "," space context-kv )? context-rest
context ::= "{" space  (context-documentTime-kv context-documentTime-rest | context-dueDateTime-kv )? space "}"
context-documentTime-kv ::= "\"documentTime\"" space ":" space string
context-documentTime-rest ::= ( "," space context-dueDateTime-kv )?
context-dueDateTime-kv ::= "\"dueDateTime\"" space ":" space string
context-kv ::= "\"context\"" space ":" space context
context-rest ::= ( "," space createdBy-kv )? createdBy-rest
createdBy-kv ::= "\"createdBy\"" space ":" space string
createdBy-rest ::= ( "," space directory-kv )? directory-rest
createdTime-kv ::= "\"createdTime\"" space ":" space string
directory-kv ::= "\"directory\"" space ":" space string
directory-rest ::= ( "," space idSystem-kv )? idSystem-rest
documentFiles ::= "[" space documentFiles-item ("," space documentFiles-item)* space "]"
documentFiles-item ::= "{" space documentFiles-item-filename-kv "," space documentFiles-item-revisions-kv ( "," space ( documentFiles-item-rotation-kv ) )? space "}"
documentFiles-item-filename-kv ::= "\"filename\"" space ":" space string
documentFiles-item-revisions ::= "[" space (documentFiles-item-revisions-item ("," space documentFiles-item-revisions-item)*)? space "]"
documentFiles-item-revisions-item ::= "{" space documentFiles-item-revisions-item-addedTime-kv ( "," space ( documentFiles-item-revisions-item-addedBy-kv ) )? space "}"
documentFiles-item-revisions-item-addedBy-kv ::= "\"addedBy\"" space ":" space string
documentFiles-item-revisions-item-addedTime-kv ::= "\"addedTime\"" space ":" space string
documentFiles-item-revisions-kv ::= "\"revisions\"" space ":" space documentFiles-item-revisions
documentFiles-item-rotation ::= ("0" | "90" | "180" | "270")
documentFiles-item-rotation-kv ::= "\"rotation\"" space ":" space documentFiles-item-rotation
documentFiles-kv ::= "\"documentFiles\"" space ":" space documentFiles
idSystem-kv ::= "\"idSystem\"" space ":" space string
idSystem-rest ::= ( "," space idUser-kv )? idUser-rest
idUser-kv ::= "\"idUser\"" space ":" space string
idUser-rest ::= ( "," space labels-kv )? labels-rest
labels ::= "[" space (string ("," space string)*)? space "]"
labels-kv ::= "\"labels\"" space ":" space labels
labels-rest ::= ( "," space location-kv )? location-rest
location-kv ::= "\"location\"" space ":" space string
location-rest ::= ( "," space note-kv )? note-rest
note-kv ::= "\"note\"" space ":" space string
note-rest ::= ( "," space optionIndexed-kv )? optionIndexed-rest
optionIndexed-kv ::= "\"optionIndexed\"" space ":" space boolean
optionIndexed-rest ::= ( "," space optionOcr-kv )? optionOcr-rest
optionOcr-kv ::= "\"optionOcr\"" space ":" space boolean
optionOcr-rest ::= ( "," space project-kv )? project-rest
project-kv ::= "\"project\"" space ":" space string
project-rest ::= ( "," space source-kv )?
root ::= "{" space createdTime-kv "," space documentFiles-kv "," space version-kv ( "," space ( comments-kv comments-rest | context-kv context-rest | createdBy-kv createdBy-rest | directory-kv directory-rest | idSystem-kv idSystem-rest | idUser-kv idUser-rest | labels-kv labels-rest | location-kv location-rest | note-kv note-rest | optionIndexed-kv optionIndexed-rest | optionOcr-kv optionOcr-rest | project-kv project-rest | source-kv ) )? space "}"
source ::= "{" space  (source-email-kv source-email-rest | source-name-kv source-name-rest | source-url-kv source-url-rest | source-version-kv )? space "}"
source-email-kv ::= "\"email\"" space ":" space string
source-email-rest ::= ( "," space source-name-kv )? source-name-rest
source-kv ::= "\"source\"" space ":" space source
source-name-kv ::= "\"name\"" space ":" space string
source-name-rest ::= ( "," space source-url-kv )? source-url-rest
source-url-kv ::= "\"url\"" space ":" space string
source-url-rest ::= ( "," space source-version-kv )?
source-version-kv ::= "\"version\"" space ":" space string
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
version ::= ("\"1.0.0\"")
version-kv ::= "\"version\"" space ":" space version

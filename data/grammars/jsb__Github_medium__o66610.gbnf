activeSessions ::= "[" space (activeSessions-item ("," space activeSessions-item)*)? space "]"
activeSessions-item ::= "{" space activeSessions-item-ip-kv "," space activeSessions-item-started-kv "," space activeSessions-item-ua-kv space "}"
activeSessions-item-ip-kv ::= "\"ip\"" space ":" space string
activeSessions-item-started-kv ::= "\"started\"" space ":" space string
activeSessions-item-ua-kv ::= "\"ua\"" space ":" space string
activeSessions-kv ::= "\"activeSessions\"" space ":" space activeSessions
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
endedSessions ::= "[" space (endedSessions-item ("," space endedSessions-item)*)? space "]"
endedSessions-item ::= "{" space endedSessions-item-ended-kv "," space endedSessions-item-ip-kv "," space endedSessions-item-started-kv "," space endedSessions-item-ua-kv space "}"
endedSessions-item-ended-kv ::= "\"ended\"" space ":" space string
endedSessions-item-ip-kv ::= "\"ip\"" space ":" space string
endedSessions-item-started-kv ::= "\"started\"" space ":" space string
endedSessions-item-ua-kv ::= "\"ua\"" space ":" space string
endedSessions-kv ::= "\"endedSessions\"" space ":" space endedSessions
hitSamples ::= "[" space (hitSamples-item ("," space hitSamples-item)*)? space "]"
hitSamples-item ::= "{" space hitSamples-item-ip-kv "," space hitSamples-item-ts-kv "," space hitSamples-item-ua-kv ( "," space ( hitSamples-item-host-kv hitSamples-item-host-rest | hitSamples-item-url-kv ) )? space "}"
hitSamples-item-host-kv ::= "\"host\"" space ":" space string
hitSamples-item-host-rest ::= ( "," space hitSamples-item-url-kv )?
hitSamples-item-ip-kv ::= "\"ip\"" space ":" space string
hitSamples-item-ts-kv ::= "\"ts\"" space ":" space string
hitSamples-item-ua-kv ::= "\"ua\"" space ":" space string
hitSamples-item-url-kv ::= "\"url\"" space ":" space string
hitSamples-kv ::= "\"hitSamples\"" space ":" space hitSamples
root ::= "{" space activeSessions-kv "," space endedSessions-kv "," space hitSamples-kv "," space startedSessions-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
startedSessions ::= "[" space (startedSessions-item ("," space startedSessions-item)*)? space "]"
startedSessions-item ::= "{" space startedSessions-item-ip-kv "," space startedSessions-item-started-kv "," space startedSessions-item-ua-kv space "}"
startedSessions-item-ip-kv ::= "\"ip\"" space ":" space string
startedSessions-item-started-kv ::= "\"started\"" space ":" space string
startedSessions-item-ua-kv ::= "\"ua\"" space ":" space string
startedSessions-kv ::= "\"startedSessions\"" space ":" space startedSessions
string ::= "\"" char* "\""

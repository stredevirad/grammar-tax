char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
root ::= "{" space sign-kv "," space tx-kv space "}"
sign ::= "[" space string ("," space string)* space "]"
sign-kv ::= "\"sign\"" space ":" space sign
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
tx ::= "{" space tx-fee-kv "," space tx-from-kv "," space tx-id-kv "," space tx-msg-kv "," space tx-to-kv space "}"
tx-fee ::= ([1-9] [0-9]{0,15})
tx-fee-kv ::= "\"fee\"" space ":" space tx-fee
tx-from ::= "[" space string ("," space string)* space "]"
tx-from-kv ::= "\"from\"" space ":" space tx-from
tx-id ::= "\"" (tx-id-1{64,64}) "\""
tx-id-1 ::= [0-9a-f]
tx-id-kv ::= "\"id\"" space ":" space tx-id
tx-kv ::= "\"tx\"" space ":" space tx
tx-msg ::= "\"" char{0,254} "\""
tx-msg-kv ::= "\"msg\"" space ":" space tx-msg
tx-to ::= "[" space tx-to-item ("," space tx-to-item)* space "]"
tx-to-item ::= "{" space tx-to-item-address-kv "," space tx-to-item-amount-kv space "}"
tx-to-item-address-kv ::= "\"address\"" space ":" space string
tx-to-item-amount ::= ([1-9] [0-9]{0,15})
tx-to-item-amount-kv ::= "\"amount\"" space ":" space tx-to-item-amount
tx-to-kv ::= "\"to\"" space ":" space tx-to

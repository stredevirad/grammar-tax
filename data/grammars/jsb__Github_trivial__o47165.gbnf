boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
ref-definitions-expr ::= boolean | number | string | ref-definitions-expr-3 | ref-definitions-expr-4 | ref-definitions-expr-5 | ref-definitions-expr-6 | ref-definitions-expr-7 | ref-definitions-expr-8 | ref-definitions-expr-9 | ref-definitions-expr-10 | ref-definitions-expr-11 | ref-definitions-expr-12
ref-definitions-expr-10 ::= "{" space ref-definitions-expr-10---kv space "}"
ref-definitions-expr-10-- ::= "[" space ref-definitions-expr-10---item ("," space ref-definitions-expr-10---item){1,1} space "]"
ref-definitions-expr-10---item ::= ref-definitions-expr
ref-definitions-expr-10---kv ::= "\"/\"" space ":" space ref-definitions-expr-10--
ref-definitions-expr-11 ::= "{" space ref-definitions-expr-11---kv space "}"
ref-definitions-expr-11-- ::= "[" space ref-definitions-expr-11---item ("," space ref-definitions-expr-11---item){1,1} space "]"
ref-definitions-expr-11---item ::= ref-definitions-expr
ref-definitions-expr-11---kv ::= "\"-\"" space ":" space ref-definitions-expr-11--
ref-definitions-expr-12 ::= "{" space ref-definitions-expr-12-pow-kv space "}"
ref-definitions-expr-12-pow ::= "[" space ref-definitions-expr-12-pow-item ("," space ref-definitions-expr-12-pow-item){1,1} space "]"
ref-definitions-expr-12-pow-item ::= ref-definitions-expr
ref-definitions-expr-12-pow-kv ::= "\"pow\"" space ":" space ref-definitions-expr-12-pow
ref-definitions-expr-3 ::= "{" space ref-definitions-expr-3-expr-kv space "}"
ref-definitions-expr-3-expr-kv ::= "\"expr\"" space ":" space string
ref-definitions-expr-4 ::= "{" space ref-definitions-expr-4-log-kv space "}"
ref-definitions-expr-4-log ::= ref-definitions-expr
ref-definitions-expr-4-log-kv ::= "\"log\"" space ":" space ref-definitions-expr-4-log
ref-definitions-expr-5 ::= "{" space ref-definitions-expr-5-exp-kv space "}"
ref-definitions-expr-5-exp ::= ref-definitions-expr
ref-definitions-expr-5-exp-kv ::= "\"exp\"" space ":" space ref-definitions-expr-5-exp
ref-definitions-expr-6 ::= "{" space ref-definitions-expr-6-geomsum-kv space "}"
ref-definitions-expr-6-geomsum ::= ref-definitions-expr
ref-definitions-expr-6-geomsum-kv ::= "\"geomsum\"" space ":" space ref-definitions-expr-6-geomsum
ref-definitions-expr-7 ::= "{" space ref-definitions-expr-7-not-kv space "}"
ref-definitions-expr-7-not ::= ref-definitions-expr
ref-definitions-expr-7-not-kv ::= "\"not\"" space ":" space ref-definitions-expr-7-not
ref-definitions-expr-8 ::= "{" space ref-definitions-expr-8---kv space "}"
ref-definitions-expr-8-- ::= "[" space ref-definitions-expr-8---item ("," space ref-definitions-expr-8---item){1,1} space "]"
ref-definitions-expr-8---item ::= ref-definitions-expr
ref-definitions-expr-8---kv ::= "\"*\"" space ":" space ref-definitions-expr-8--
ref-definitions-expr-9 ::= "{" space ref-definitions-expr-9---kv space "}"
ref-definitions-expr-9-- ::= "[" space ref-definitions-expr-9---item ("," space ref-definitions-expr-9---item){1,1} space "]"
ref-definitions-expr-9---item ::= ref-definitions-expr
ref-definitions-expr-9---kv ::= "\"+\"" space ":" space ref-definitions-expr-9--
root ::= ref-definitions-expr
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""

-schema-kv ::= "\"$schema\"" space ":" space string
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
description-kv ::= "\"description\"" space ":" space string
entries ::= "[" space (entries-item ("," space entries-item)*)? space "]"
entries-item ::= "{" space entries-item-description-kv "," space entries-item-exchange-kv "," space entries-item-name-kv "," space entries-item-routingKey-kv "," space entries-item-schema-kv "," space entries-item-title-kv "," space entries-item-type-kv space "}"
entries-item-description-kv ::= "\"description\"" space ":" space string
entries-item-exchange-kv ::= "\"exchange\"" space ":" space string
entries-item-name-kv ::= "\"name\"" space ":" space string
entries-item-routingKey ::= "[" space (entries-item-routingKey-item ("," space entries-item-routingKey-item)*)? space "]"
entries-item-routingKey-item ::= "{" space entries-item-routingKey-item-multipleWords-kv "," space entries-item-routingKey-item-name-kv "," space entries-item-routingKey-item-required-kv "," space entries-item-routingKey-item-summary-kv ( "," space ( entries-item-routingKey-item-constant-kv ) )? space "}"
entries-item-routingKey-item-constant-kv ::= "\"constant\"" space ":" space string
entries-item-routingKey-item-multipleWords-kv ::= "\"multipleWords\"" space ":" space boolean
entries-item-routingKey-item-name-kv ::= "\"name\"" space ":" space string
entries-item-routingKey-item-required-kv ::= "\"required\"" space ":" space boolean
entries-item-routingKey-item-summary-kv ::= "\"summary\"" space ":" space string
entries-item-routingKey-kv ::= "\"routingKey\"" space ":" space entries-item-routingKey
entries-item-schema-kv ::= "\"schema\"" space ":" space string
entries-item-title-kv ::= "\"title\"" space ":" space string
entries-item-type ::= ("\"topic-exchange\"")
entries-item-type-kv ::= "\"type\"" space ":" space entries-item-type
entries-kv ::= "\"entries\"" space ":" space entries
exchangePrefix-kv ::= "\"exchangePrefix\"" space ":" space string
root ::= "{" space -schema-kv "," space description-kv "," space entries-kv "," space exchangePrefix-kv "," space title-kv "," space version-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
title-kv ::= "\"title\"" space ":" space string
version ::= ("0" | "\"0.2.0\"")
version-kv ::= "\"version\"" space ":" space version

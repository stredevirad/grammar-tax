builtin ::= ("\"MODIFIABLE\"" | "\"DELETABLE\"" | "\"IMMUTABLE\"" | "\"PARTITION_ALL\"")
builtin-kv ::= "\"builtin\"" space ":" space builtin
builtin-rest ::= ( "," space feature-kv )? feature-rest
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
feature ::= ("\"WL\"" | "\"WebLogging\"" | "\"SP\"" | "\"SurgeProtection\"" | "\"LB\"" | "\"LoadBalancing\"" | "\"CS\"" | "\"ContentSwitching\"" | "\"CR\"" | "\"CacheRedirection\"" | "\"SC\"" | "\"SureConnect\"" | "\"CMP\"" | "\"CMPcntl\"" | "\"CompressionControl\"" | "\"PQ\"" | "\"PriorityQueuing\"" | "\"HDOSP\"" | "\"HttpDoSProtection\"" | "\"SSLVPN\"" | "\"AAA\"" | "\"GSLB\"" | "\"GlobalServerLoadBalancing\"" | "\"SSL\"" | "\"SSLOffload\"" | "\"SSLOffloading\"" | "\"CF\"" | "\"ContentFiltering\"" | "\"IC\"" | "\"IntegratedCaching\"" | "\"OSPF\"" | "\"OSPFRouting\"" | "\"RIP\"" | "\"RIPRouting\"" | "\"BGP\"" | "\"BGPRouting\"" | "\"REWRITE\"" | "\"IPv6PT\"" | "\"IPv6protocoltranslation\"" | "\"AppFw\"" | "\"ApplicationFirewall\"" | "\"RESPONDER\"" | "\"HTMLInjection\"" | "\"push\"" | "\"NSPush\"" | "\"NetScalerPush\"" | "\"AppFlow\"" | "\"CloudBridge\"" | "\"ISIS\"" | "\"ISISRouting\"" | "\"CH\"" | "\"CallHome\"" | "\"AppQoE\"" | "\"ContentAccelerator\"" | "\"SYSTEM\"" | "\"RISE\"" | "\"FEO\"" | "\"LSN\"" | "\"LargeScaleNAT\"" | "\"RDPProxy\"" | "\"Rep\"" | "\"Reputation\"" | "\"URLFiltering\"" | "\"VideoOptimization\"" | "\"ForwardProxy\"" | "\"SSLInterception\"" | "\"AdaptiveTCP\"" | "\"CQA\"" | "\"CI\"" | "\"ContentInspection\"" | "\"Bot\"")
feature-kv ::= "\"feature\"" space ":" space feature
feature-rest ::= ( "," space globalbindtype-kv )? globalbindtype-rest
globalbindtype ::= ("\"SYSTEM_GLOBAL\"" | "\"VPN_GLOBAL\"" | "\"RNAT_GLOBAL\"")
globalbindtype-kv ::= "\"globalbindtype\"" space ":" space globalbindtype
globalbindtype-rest ::= ( "," space gotopriorityexpression-kv )? gotopriorityexpression-rest
gotopriorityexpression-kv ::= "\"gotopriorityexpression\"" space ":" space string
gotopriorityexpression-rest ::= ( "," space numpol-kv )? numpol-rest
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
numpol-kv ::= "\"numpol\"" space ":" space integer
numpol-rest ::= ( "," space policyname-kv )? policyname-rest
policyname-kv ::= "\"policyname\"" space ":" space string
policyname-rest ::= ( "," space policytype-kv )? policytype-rest
policytype ::= ("\"Classic Policy\"" | "\"Advanced Policy\"")
policytype-kv ::= "\"policytype\"" space ":" space policytype
policytype-rest ::= ( "," space priority-kv )? priority-rest
priority-kv ::= "\"priority\"" space ":" space integer
priority-rest ::= ( "," space state-kv )? state-rest
root ::= "{" space  (builtin-kv builtin-rest | feature-kv feature-rest | globalbindtype-kv globalbindtype-rest | gotopriorityexpression-kv gotopriorityexpression-rest | numpol-kv numpol-rest | policyname-kv policyname-rest | policytype-kv policytype-rest | priority-kv priority-rest | state-kv state-rest | type-kv )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
state ::= ("\"ENABLED\"" | "\"DISABLED\"")
state-kv ::= "\"state\"" space ":" space state
state-rest ::= ( "," space type-kv )?
string ::= "\"" char* "\""
type ::= ("\"REQ_OVERRIDE\"" | "\"REQ_DEFAULT\"" | "\"RES_OVERRIDE\"" | "\"RES_DEFAULT\"")
type-kv ::= "\"type\"" space ":" space type

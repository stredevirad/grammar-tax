char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
item ::= ref-definitions-ExternalStep
ref-definitions-ExternalStep ::= "{" space  (ref-definitions-ExternalStep-name-kv ref-definitions-ExternalStep-name-rest | ref-definitions-ExternalStep-type-kv ref-definitions-ExternalStep-type-rest | ref-definitions-ExternalStep-tag-kv ref-definitions-ExternalStep-tag-rest | ref-definitions-ExternalStep-exclude-kv ref-definitions-ExternalStep-exclude-rest | ref-definitions-ExternalStep-service-kv ref-definitions-ExternalStep-service-rest | ref-definitions-ExternalStep-services-kv ref-definitions-ExternalStep-services-rest | ref-definitions-ExternalStep-command-kv ref-definitions-ExternalStep-command-rest | ref-definitions-ExternalStep-steps-kv ref-definitions-ExternalStep-steps-rest | ref-definitions-ExternalStep-image-name-kv ref-definitions-ExternalStep-image-name-rest | ref-definitions-ExternalStep-image-tag-kv ref-definitions-ExternalStep-image-tag-rest | ref-definitions-ExternalStep-registry-kv ref-definitions-ExternalStep-registry-rest | ref-definitions-ExternalStep-encrypted-dockercfg-path-kv ref-definitions-ExternalStep-encrypted-dockercfg-path-rest | ref-definitions-ExternalStep-dockercfg-service-kv ref-definitions-ExternalStep-dockercfg-service-rest | ref-definitions-ExternalStep-on-fail-kv )? space "}"
ref-definitions-ExternalStep-command-kv ::= "\"command\"" space ":" space string
ref-definitions-ExternalStep-command-rest ::= ( "," space ref-definitions-ExternalStep-steps-kv )? ref-definitions-ExternalStep-steps-rest
ref-definitions-ExternalStep-dockercfg-service-kv ::= "\"dockercfg_service\"" space ":" space string
ref-definitions-ExternalStep-dockercfg-service-rest ::= ( "," space ref-definitions-ExternalStep-on-fail-kv )?
ref-definitions-ExternalStep-encrypted-dockercfg-path-kv ::= "\"encrypted_dockercfg_path\"" space ":" space string
ref-definitions-ExternalStep-encrypted-dockercfg-path-rest ::= ( "," space ref-definitions-ExternalStep-dockercfg-service-kv )? ref-definitions-ExternalStep-dockercfg-service-rest
ref-definitions-ExternalStep-exclude-kv ::= "\"exclude\"" space ":" space string
ref-definitions-ExternalStep-exclude-rest ::= ( "," space ref-definitions-ExternalStep-service-kv )? ref-definitions-ExternalStep-service-rest
ref-definitions-ExternalStep-image-name-kv ::= "\"image_name\"" space ":" space string
ref-definitions-ExternalStep-image-name-rest ::= ( "," space ref-definitions-ExternalStep-image-tag-kv )? ref-definitions-ExternalStep-image-tag-rest
ref-definitions-ExternalStep-image-tag-kv ::= "\"image_tag\"" space ":" space string
ref-definitions-ExternalStep-image-tag-rest ::= ( "," space ref-definitions-ExternalStep-registry-kv )? ref-definitions-ExternalStep-registry-rest
ref-definitions-ExternalStep-name-kv ::= "\"name\"" space ":" space string
ref-definitions-ExternalStep-name-rest ::= ( "," space ref-definitions-ExternalStep-type-kv )? ref-definitions-ExternalStep-type-rest
ref-definitions-ExternalStep-on-fail ::= "[" space (ref-definitions-ExternalStep-on-fail-item ("," space ref-definitions-ExternalStep-on-fail-item)*)? space "]"
ref-definitions-ExternalStep-on-fail-item ::= ref-definitions-ExternalStep
ref-definitions-ExternalStep-on-fail-kv ::= "\"on_fail\"" space ":" space ref-definitions-ExternalStep-on-fail
ref-definitions-ExternalStep-registry-kv ::= "\"registry\"" space ":" space string
ref-definitions-ExternalStep-registry-rest ::= ( "," space ref-definitions-ExternalStep-encrypted-dockercfg-path-kv )? ref-definitions-ExternalStep-encrypted-dockercfg-path-rest
ref-definitions-ExternalStep-service-kv ::= "\"service\"" space ":" space string
ref-definitions-ExternalStep-service-rest ::= ( "," space ref-definitions-ExternalStep-services-kv )? ref-definitions-ExternalStep-services-rest
ref-definitions-ExternalStep-services ::= "[" space (string ("," space string)*)? space "]"
ref-definitions-ExternalStep-services-kv ::= "\"services\"" space ":" space ref-definitions-ExternalStep-services
ref-definitions-ExternalStep-services-rest ::= ( "," space ref-definitions-ExternalStep-command-kv )? ref-definitions-ExternalStep-command-rest
ref-definitions-ExternalStep-steps ::= "[" space (ref-definitions-ExternalStep-steps-item ("," space ref-definitions-ExternalStep-steps-item)*)? space "]"
ref-definitions-ExternalStep-steps-item ::= ref-definitions-ExternalStep
ref-definitions-ExternalStep-steps-kv ::= "\"steps\"" space ":" space ref-definitions-ExternalStep-steps
ref-definitions-ExternalStep-steps-rest ::= ( "," space ref-definitions-ExternalStep-image-name-kv )? ref-definitions-ExternalStep-image-name-rest
ref-definitions-ExternalStep-tag-kv ::= "\"tag\"" space ":" space string
ref-definitions-ExternalStep-tag-rest ::= ( "," space ref-definitions-ExternalStep-exclude-kv )? ref-definitions-ExternalStep-exclude-rest
ref-definitions-ExternalStep-type ::= ("null" | "\"run\"" | "\"serial\"" | "\"push\"" | "\"parallel\"" | "\"load\"" | "\"manual\"")
ref-definitions-ExternalStep-type-kv ::= "\"type\"" space ":" space ref-definitions-ExternalStep-type
ref-definitions-ExternalStep-type-rest ::= ( "," space ref-definitions-ExternalStep-tag-kv )? ref-definitions-ExternalStep-tag-rest
root ::= "[" space (item ("," space item)*)? space "]"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""

array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
configs ::= "{" space "}"
configs-kv ::= "\"configs\"" space ":" space configs
configs-rest ::= ( "," space networks-kv )? networks-rest
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
networks ::= object
networks-kv ::= "\"networks\"" space ":" space networks
networks-rest ::= ( "," space secrets-kv )? secrets-rest
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
root ::= "{" space version-kv ( "," space ( configs-kv configs-rest | networks-kv networks-rest | secrets-kv secrets-rest | services-kv services-rest | volumes-kv ) )? space "}"
secrets ::= "{" space "}"
secrets-kv ::= "\"secrets\"" space ":" space secrets
secrets-rest ::= ( "," space services-kv )? services-rest
services ::= "{" space "}"
services-kv ::= "\"services\"" space ":" space services
services-rest ::= ( "," space volumes-kv )?
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
value ::= object | array | string | number | boolean | null
version-kv ::= "\"version\"" space ":" space string
volumes ::= "{" space "}"
volumes-kv ::= "\"volumes\"" space ":" space volumes

additional-k ::= ["] ( [b] ([o] ([d] ([y] char+ | [^"y] char*) | [^"d] char*) | [^"o] char*) | [i] ([d] char+ | [^"d] char*) | [o] ([c] ([c] ([u] ([r] ([r] ([e] ([d] char+ | [^"d] char*) | [^"e] char*) | [^"r] char*) | [^"r] char*) | [^"u] char*) | [^"c] char*) | [f] ([f] ([s] ([e] ([t] char+ | [^"t] char*) | [^"e] char*) | [^"s] char*) | [^"f] char*) | [^"cf] char*) | [p] ([r] ([o] ([c] ([e] ([s] ([s] ([e] ([d] char+ | [^"d] char*) | [^"e] char*) | [^"s] char*) | [^"s] char*) | [^"e] char*) | [^"c] char*) | [^"o] char*) | [^"r] char*) | [t] ([y] ([p] ([e] char+ | [^"e] char*) | [^"p] char*) | [^"y] char*) | [^"biopt] char* )? ["]
additional-kv ::= additional-k ":" space value
array ::= "[" space ( value ("," space value)* )? space "]"
body ::= "{" space  (body-group-id-kv body-group-id-rest | body-payload-kv body-payload-rest | body-push-id-kv body-push-id-rest | body-trimmed-kv body-trimmed-rest | body-additional-kv ( "," space body-additional-kv )* )? space "}"
body-additional-k ::= ["] ( [g] ([r] ([o] ([u] ([p] ([_] ([i] ([d] char+ | [^"d] char*) | [^"i] char*) | [^"_] char*) | [^"p] char*) | [^"u] char*) | [^"o] char*) | [^"r] char*) | [p] ([a] ([y] ([l] ([o] ([a] ([d] char+ | [^"d] char*) | [^"a] char*) | [^"o] char*) | [^"l] char*) | [^"y] char*) | [u] ([s] ([h] ([_] ([i] ([d] char+ | [^"d] char*) | [^"i] char*) | [^"_] char*) | [^"h] char*) | [^"s] char*) | [^"au] char*) | [t] ([r] ([i] ([m] ([m] ([e] ([d] char+ | [^"d] char*) | [^"e] char*) | [^"m] char*) | [^"m] char*) | [^"i] char*) | [^"r] char*) | [^"gpt] char* )? ["]
body-additional-kv ::= body-additional-k ":" space value
body-group-id-kv ::= "\"group_id\"" space ":" space string
body-group-id-rest ::= ( "," space body-payload-kv )? body-payload-rest
body-kv ::= "\"body\"" space ":" space body
body-payload ::= "\"" ((body-payload-1{4,4})* (body-payload-1{4,4} | body-payload-1{3,3} "=" | body-payload-1{2,2} "==")) "\""
body-payload-1 ::= [A-Za-z0-9+/]
body-payload-kv ::= "\"payload\"" space ":" space body-payload
body-payload-rest ::= ( "," space body-push-id-kv )? body-push-id-rest
body-push-id-kv ::= "\"push_id\"" space ":" space string
body-push-id-rest ::= ( "," space body-trimmed-kv )? body-trimmed-rest
body-rest ::= ( "," space id-kv )? id-rest
body-trimmed-kv ::= "\"trimmed\"" space ":" space boolean
body-trimmed-rest ::= ( "," space body-additional-kv )*
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
id-kv ::= "\"id\"" space ":" space string
id-rest ::= ( "," space occurred-kv )? occurred-rest
integral-part ::= [0] | [1-9] [0-9]{0,15}
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
occurred-kv ::= "\"occurred\"" space ":" space string
occurred-rest ::= ( "," space offset-kv )? offset-rest
offset-kv ::= "\"offset\"" space ":" space string
offset-rest ::= ( "," space processed-kv )? processed-rest
processed-kv ::= "\"processed\"" space ":" space string
processed-rest ::= ( "," space type-kv )? type-rest
root ::= "{" space  (body-kv body-rest | id-kv id-rest | occurred-kv occurred-rest | offset-kv offset-rest | processed-kv processed-rest | type-kv type-rest | additional-kv ( "," space additional-kv )* )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
type-kv ::= "\"type\"" space ":" space string
type-rest ::= ( "," space additional-kv )*
value ::= object | array | string | number | boolean | null

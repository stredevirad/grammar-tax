action ::= "\"" char{0,500} "\""
action-kv ::= "\"action\"" space ":" space action
category ::= "\"" char{0,150} "\""
category-kv ::= "\"category\"" space ":" space category
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
label ::= label-0 | null
label-0 ::= "\"" char{0,500} "\""
label-kv ::= "\"label\"" space ":" space label
label-rest ::= ( "," space value-kv )?
null ::= "null"
root ::= "{" space action-kv "," space category-kv ( "," space ( label-kv label-rest | value-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
value- ::= value-0 | null
value-0 ::= ([0] | [1-9] [0-9]{0,15})
value-kv ::= "\"value\"" space ":" space value-

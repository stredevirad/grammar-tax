char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
database-kv ::= "\"database\"" space ":" space string
host-kv ::= "\"host\"" space ":" space string
id-kv ::= "\"id\"" space ":" space string
id-rest ::= ( "," space sshTunnel-kv )?
name-kv ::= "\"name\"" space ":" space string
null ::= "null"
password ::= string | password-1
password-1 ::= "{" space password-1-ec2ParameterStore-kv space "}"
password-1-ec2ParameterStore ::= "{" space password-1-ec2ParameterStore-parameterName-kv space "}"
password-1-ec2ParameterStore-kv ::= "\"ec2ParameterStore\"" space ":" space password-1-ec2ParameterStore
password-1-ec2ParameterStore-parameterName-kv ::= "\"parameterName\"" space ":" space string
password-kv ::= "\"password\"" space ":" space password
port ::= ([1-9] | ([1-8] [0-9] | [9] [0-9]) | ([1-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])) | ([1-8] [0-9]{3} | [9] ([0-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9]))) | ([1-5] [0-9]{4} | [6] ([0-4] [0-9]{3} | [5] ([0-4] [0-9]{2} | [5] ([0-2] [0-9] | [3] [0-5])))))
port-kv ::= "\"port\"" space ":" space port
purpose ::= ("\"ENRICHED_EVENTS\"")
purpose-kv ::= "\"purpose\"" space ":" space purpose
root ::= "{" space database-kv "," space host-kv "," space name-kv "," space password-kv "," space port-kv "," space purpose-kv "," space schema-kv "," space sslMode-kv "," space username-kv ( "," space ( id-kv id-rest | sshTunnel-kv ) )? space "}"
schema-kv ::= "\"schema\"" space ":" space string
space ::= | " " | "\n"{1,2} [ \t]{0,20}
sshTunnel ::= sshTunnel-0 | null
sshTunnel-0 ::= "{" space sshTunnel-0-bastion-kv "," space sshTunnel-0-destination-kv "," space sshTunnel-0-localPort-kv space "}"
sshTunnel-0-bastion ::= "{" space sshTunnel-0-bastion-host-kv "," space sshTunnel-0-bastion-port-kv "," space sshTunnel-0-bastion-user-kv ( "," space ( sshTunnel-0-bastion-key-kv sshTunnel-0-bastion-key-rest | sshTunnel-0-bastion-passphrase-kv ) )? space "}"
sshTunnel-0-bastion-host-kv ::= "\"host\"" space ":" space string
sshTunnel-0-bastion-key ::= "{" space sshTunnel-0-bastion-key-ec2ParameterStore-kv space "}"
sshTunnel-0-bastion-key-ec2ParameterStore ::= "{" space sshTunnel-0-bastion-key-ec2ParameterStore-parameterName-kv space "}"
sshTunnel-0-bastion-key-ec2ParameterStore-kv ::= "\"ec2ParameterStore\"" space ":" space sshTunnel-0-bastion-key-ec2ParameterStore
sshTunnel-0-bastion-key-ec2ParameterStore-parameterName-kv ::= "\"parameterName\"" space ":" space string
sshTunnel-0-bastion-key-kv ::= "\"key\"" space ":" space sshTunnel-0-bastion-key
sshTunnel-0-bastion-key-rest ::= ( "," space sshTunnel-0-bastion-passphrase-kv )?
sshTunnel-0-bastion-kv ::= "\"bastion\"" space ":" space sshTunnel-0-bastion
sshTunnel-0-bastion-passphrase-kv ::= "\"passphrase\"" space ":" space string
sshTunnel-0-bastion-port ::= ([1-9] | ([1-8] [0-9] | [9] [0-9]) | ([1-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])) | ([1-8] [0-9]{3} | [9] ([0-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9]))) | ([1-5] [0-9]{4} | [6] ([0-4] [0-9]{3} | [5] ([0-4] [0-9]{2} | [5] ([0-2] [0-9] | [3] [0-5])))))
sshTunnel-0-bastion-port-kv ::= "\"port\"" space ":" space sshTunnel-0-bastion-port
sshTunnel-0-bastion-user-kv ::= "\"user\"" space ":" space string
sshTunnel-0-destination ::= "{" space sshTunnel-0-destination-host-kv "," space sshTunnel-0-destination-port-kv space "}"
sshTunnel-0-destination-host-kv ::= "\"host\"" space ":" space string
sshTunnel-0-destination-kv ::= "\"destination\"" space ":" space sshTunnel-0-destination
sshTunnel-0-destination-port ::= ([1-9] | ([1-8] [0-9] | [9] [0-9]) | ([1-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])) | ([1-8] [0-9]{3} | [9] ([0-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9]))) | ([1-5] [0-9]{4} | [6] ([0-4] [0-9]{3} | [5] ([0-4] [0-9]{2} | [5] ([0-2] [0-9] | [3] [0-5])))))
sshTunnel-0-destination-port-kv ::= "\"port\"" space ":" space sshTunnel-0-destination-port
sshTunnel-0-localPort ::= ([1-9] | ([1-8] [0-9] | [9] [0-9]) | ([1-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])) | ([1-8] [0-9]{3} | [9] ([0-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9]))) | ([1-5] [0-9]{4} | [6] ([0-4] [0-9]{3} | [5] ([0-4] [0-9]{2} | [5] ([0-2] [0-9] | [3] [0-5])))))
sshTunnel-0-localPort-kv ::= "\"localPort\"" space ":" space sshTunnel-0-localPort
sshTunnel-kv ::= "\"sshTunnel\"" space ":" space sshTunnel
sslMode ::= ("\"DISABLE\"" | "\"REQUIRE\"" | "\"VERIFY_CA\"" | "\"VERIFY_FULL\"")
sslMode-kv ::= "\"sslMode\"" space ":" space sslMode
string ::= "\"" char* "\""
username-kv ::= "\"username\"" space ":" space string

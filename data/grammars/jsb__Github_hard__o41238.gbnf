boolean ::= ("true" | "false")
config ::= "{" space config-Generate-Bids-kv "," space config-Generate-json-kv "," space config-Generate-Raw-kv "," space config-Generate-QA-kv "," space config-Process-Data-kv "," space config-Missing-Data-kv "," space config-Interpolation-Method-kv "," space config-Fill-Value-kv "," space config-gear-log-level-kv "," space config-Dry-Run-kv space "}"
config-Dry-Run-kv ::= "\"Dry-Run\"" space ":" space boolean
config-Fill-Value-kv ::= "\"Fill_Value\"" space ":" space number
config-Generate-Bids-kv ::= "\"Generate_Bids\"" space ":" space boolean
config-Generate-QA-kv ::= "\"Generate_QA\"" space ":" space boolean
config-Generate-Raw-kv ::= "\"Generate_Raw\"" space ":" space boolean
config-Generate-json-kv ::= "\"Generate_json\"" space ":" space boolean
config-Interpolation-Method ::= ("\"fill\"" | "\"linear\"" | "\"nearest\"" | "\"zero\"" | "\"slinear\"" | "\"quadratic\"" | "\"cubic\"" | "\"nan\"")
config-Interpolation-Method-kv ::= "\"Interpolation_Method\"" space ":" space config-Interpolation-Method
config-Missing-Data ::= ("\"gap_fill\"" | "\"uniform\"" | "\"upsample\"" | "\"none\"")
config-Missing-Data-kv ::= "\"Missing_Data\"" space ":" space config-Missing-Data
config-Process-Data-kv ::= "\"Process_Data\"" space ":" space boolean
config-gear-log-level ::= ("\"ERROR\"" | "\"WARNING\"" | "\"INFO\"" | "\"DEBUG\"")
config-gear-log-level-kv ::= "\"gear-log-level\"" space ":" space config-gear-log-level
config-kv ::= "\"config\"" space ":" space config
decimal-part ::= [0-9]{1,16}
inputs ::= "{" space inputs-DICOM-ARCHIVE-kv space "}"
inputs-DICOM-ARCHIVE ::= "{" space  (inputs-DICOM-ARCHIVE-type-kv )? space "}"
inputs-DICOM-ARCHIVE-kv ::= "\"DICOM_ARCHIVE\"" space ":" space inputs-DICOM-ARCHIVE
inputs-DICOM-ARCHIVE-type ::= ("\"dicom\"" | "\"archive\"")
inputs-DICOM-ARCHIVE-type-kv ::= "\"type\"" space ":" space inputs-DICOM-ARCHIVE-type
inputs-kv ::= "\"inputs\"" space ":" space inputs
integral-part ::= [0] | [1-9] [0-9]{0,15}
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
root ::= "{" space config-kv "," space inputs-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}

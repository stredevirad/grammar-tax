-id ::= "\"" char{0,50} "\""
-id-kv ::= "\"_id\"" space ":" space -id
-id-rest ::= ( "," space -sid-kv )? -sid-rest
-sid ::= "\"" char{0,50} "\""
-sid-kv ::= "\"_sid\"" space ":" space -sid
-sid-rest ::= ( "," space servant-id-kv )? servant-id-rest
archetype ::= ("\"product\"" | "\"article\"" | "\"contact\"" | "\"image\"" | "\"tag\"" | "\"tinytext\"")
archetype-kv ::= "\"archetype\"" space ":" space archetype
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
created ::= date-time-string
created-kv ::= "\"created\"" space ":" space created
created-rest ::= ( "," space updated-kv )?
date ::= [0-9]{4} "-" ( "0" [1-9] | "1" [0-2] ) "-" ( "0" [1-9] | [1-2] [0-9] | "3" [0-1] )
date-time ::= date "T" time
date-time-string ::= "\"" date-time "\""
root ::= "{" space tag-kv "," space archetype-kv ( "," space ( -id-kv -id-rest | -sid-kv -sid-rest | servant-id-kv servant-id-rest | state-kv state-rest | created-kv created-rest | updated-kv ) )? space "}"
servant-id ::= "\"" char{0,50} "\""
servant-id-kv ::= "\"servant_id\"" space ":" space servant-id
servant-id-rest ::= ( "," space state-kv )? state-rest
space ::= | " " | "\n"{1,2} [ \t]{0,20}
state ::= ("\"draft\"" | "\"public\"" | "\"private\"" | "\"deleted\"")
state-kv ::= "\"state\"" space ":" space state
state-rest ::= ( "," space created-kv )? created-rest
tag ::= "\"" char{0,140} "\""
tag-kv ::= "\"tag\"" space ":" space tag
time ::= ([01] [0-9] | "2" [0-3]) ":" [0-5] [0-9] ":" [0-5] [0-9] ( "." [0-9]{3} )? ( "Z" | ( "+" | "-" ) ( [01] [0-9] | "2" [0-3] ) ":" [0-5] [0-9] )
updated ::= date-time-string
updated-kv ::= "\"updated\"" space ":" space updated

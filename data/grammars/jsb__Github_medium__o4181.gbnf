-schemaRef-kv ::= "\"$schemaRef\"" space ":" space string
array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
header ::= "{" space header-softwareName-kv "," space header-softwareVersion-kv "," space header-uploaderID-kv ( "," space ( header-gatewayTimestamp-kv header-gatewayTimestamp-rest | header-additional-kv ( "," space header-additional-kv )* ) )? space "}"
header-additional-k ::= ["] ( [g] ([a] ([t] ([e] ([w] ([a] ([y] ([T] ([i] ([m] ([e] ([s] ([t] ([a] ([m] ([p] char+ | [^"p] char*) | [^"m] char*) | [^"a] char*) | [^"t] char*) | [^"s] char*) | [^"e] char*) | [^"m] char*) | [^"i] char*) | [^"T] char*) | [^"y] char*) | [^"a] char*) | [^"w] char*) | [^"e] char*) | [^"t] char*) | [^"a] char*) | [s] ([o] ([f] ([t] ([w] ([a] ([r] ([e] ([N] ([a] ([m] ([e] char+ | [^"e] char*) | [^"m] char*) | [^"a] char*) | [V] ([e] ([r] ([s] ([i] ([o] ([n] char+ | [^"n] char*) | [^"o] char*) | [^"i] char*) | [^"s] char*) | [^"r] char*) | [^"e] char*) | [^"NV] char*) | [^"e] char*) | [^"r] char*) | [^"a] char*) | [^"w] char*) | [^"t] char*) | [^"f] char*) | [^"o] char*) | [u] ([p] ([l] ([o] ([a] ([d] ([e] ([r] ([I] ([D] char+ | [^"D] char*) | [^"I] char*) | [^"r] char*) | [^"e] char*) | [^"d] char*) | [^"a] char*) | [^"o] char*) | [^"l] char*) | [^"p] char*) | [^"gsu] char* )? ["]
header-additional-kv ::= header-additional-k ":" space value
header-gatewayTimestamp-kv ::= "\"gatewayTimestamp\"" space ":" space string
header-gatewayTimestamp-rest ::= ( "," space header-additional-kv )*
header-kv ::= "\"header\"" space ":" space header
header-softwareName-kv ::= "\"softwareName\"" space ":" space string
header-softwareVersion-kv ::= "\"softwareVersion\"" space ":" space string
header-uploaderID-kv ::= "\"uploaderID\"" space ":" space string
integral-part ::= [0] | [1-9] [0-9]{0,15}
message ::= "{" space message-marketId-kv "," space message-ships-kv "," space message-stationName-kv "," space message-systemName-kv "," space message-timestamp-kv ( "," space ( message-horizons-kv ) )? space "}"
message-horizons-kv ::= "\"horizons\"" space ":" space boolean
message-kv ::= "\"message\"" space ":" space message
message-marketId-kv ::= "\"marketId\"" space ":" space number
message-ships ::= "[" space message-ships-item ("," space message-ships-item)* space "]"
message-ships-item ::= "\"" char+ "\""
message-ships-kv ::= "\"ships\"" space ":" space message-ships
message-stationName ::= "\"" char+ "\""
message-stationName-kv ::= "\"stationName\"" space ":" space message-stationName
message-systemName ::= "\"" char+ "\""
message-systemName-kv ::= "\"systemName\"" space ":" space message-systemName
message-timestamp-kv ::= "\"timestamp\"" space ":" space string
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
root ::= "{" space -schemaRef-kv "," space header-kv "," space message-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
value ::= object | array | string | number | boolean | null

char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
root ::= "{" space value-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
value- ::= "{" space value-value1-kv "," space value-value2-kv space "}"
value-kv ::= "\"value\"" space ":" space value-
value-value1-kv ::= "\"value1\"" space ":" space string
value-value2-kv ::= "\"value2\"" space ":" space number

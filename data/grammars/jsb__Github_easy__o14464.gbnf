array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
description-kv ::= "\"description\"" space ":" space string
description-rest ::= ( "," space public-kv )? public-rest
integral-part ::= [0] | [1-9] [0-9]{0,15}
name-kv ::= "\"name\"" space ":" space string
name-rest ::= ( "," space description-kv )? description-rest
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
public-kv ::= "\"public\"" space ":" space boolean
public-rest ::= ( "," space type-kv )? type-rest
root ::= "{" space  (name-kv name-rest | description-kv description-rest | public-kv public-rest | type-kv type-rest | schema-kv )? space "}"
schema ::= object
schema-kv ::= "\"schema\"" space ":" space schema
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
type-kv ::= "\"type\"" space ":" space string
type-rest ::= ( "," space schema-kv )?
value ::= object | array | string | number | boolean | null

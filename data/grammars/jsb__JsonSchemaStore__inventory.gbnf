additional-k ::= ["] ( [a] ([l] ([l] char+ | [^"l] char*) | [^"l] char*) | [u] ([n] ([g] ([r] ([o] ([u] ([p] ([e] ([d] char+ | [^"d] char*) | [^"e] char*) | [^"p] char*) | [^"u] char*) | [^"o] char*) | [^"r] char*) | [^"g] char*) | [^"n] char*) | [^"au] char* )? ["]
additional-kv ::= additional-k ":" space value
all ::= ref-defs-special-group
all-kv ::= "\"all\"" space ":" space all
all-rest ::= ( "," space ungrouped-kv )? ungrouped-rest
array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
ref-defs-group ::= ref-defs-group-0 | null
ref-defs-group-0 ::= "{" space  (ref-defs-group-0-children-kv ref-defs-group-0-children-rest | ref-defs-group-0-hosts-kv ref-defs-group-0-hosts-rest | ref-defs-group-0-vars-kv )? space "}"
ref-defs-group-0-children ::= value
ref-defs-group-0-children-kv ::= "\"children\"" space ":" space ref-defs-group-0-children
ref-defs-group-0-children-rest ::= ( "," space ref-defs-group-0-hosts-kv )? ref-defs-group-0-hosts-rest
ref-defs-group-0-hosts ::= ref-defs-group-0-hosts-0 | string
ref-defs-group-0-hosts-0 ::= object
ref-defs-group-0-hosts-kv ::= "\"hosts\"" space ":" space ref-defs-group-0-hosts
ref-defs-group-0-hosts-rest ::= ( "," space ref-defs-group-0-vars-kv )?
ref-defs-group-0-vars ::= object
ref-defs-group-0-vars-kv ::= "\"vars\"" space ":" space ref-defs-group-0-vars
ref-defs-special-group ::= "{" space  (ref-defs-special-group-children-kv ref-defs-special-group-children-rest | ref-defs-special-group-groups-kv ref-defs-special-group-groups-rest | ref-defs-special-group-hosts-kv ref-defs-special-group-hosts-rest | ref-defs-special-group-vars-kv )? space "}"
ref-defs-special-group-children ::= ref-defs-special-group-children-0 | null
ref-defs-special-group-children-0 ::= object
ref-defs-special-group-children-kv ::= "\"children\"" space ":" space ref-defs-special-group-children
ref-defs-special-group-children-rest ::= ( "," space ref-defs-special-group-groups-kv )? ref-defs-special-group-groups-rest
ref-defs-special-group-groups ::= ref-defs-special-group-groups-0 | null
ref-defs-special-group-groups-0 ::= object
ref-defs-special-group-groups-kv ::= "\"groups\"" space ":" space ref-defs-special-group-groups
ref-defs-special-group-groups-rest ::= ( "," space ref-defs-special-group-hosts-kv )? ref-defs-special-group-hosts-rest
ref-defs-special-group-hosts ::= ref-defs-special-group-hosts-0 | null
ref-defs-special-group-hosts-0 ::= object
ref-defs-special-group-hosts-kv ::= "\"hosts\"" space ":" space ref-defs-special-group-hosts
ref-defs-special-group-hosts-rest ::= ( "," space ref-defs-special-group-vars-kv )?
ref-defs-special-group-vars ::= ref-defs-special-group-vars-0 | null
ref-defs-special-group-vars-0 ::= object
ref-defs-special-group-vars-kv ::= "\"vars\"" space ":" space ref-defs-special-group-vars
root ::= "{" space  (all-kv all-rest | ungrouped-kv ungrouped-rest | additional-kv ( "," space additional-kv )* )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
ungrouped ::= ref-defs-group
ungrouped-kv ::= "\"ungrouped\"" space ":" space ungrouped
ungrouped-rest ::= ( "," space additional-kv )*
value ::= object | array | string | number | boolean | null

addvaryheader ::= ("\"GLOBAL\"" | "\"DISABLED\"" | "\"ENABLED\"")
addvaryheader-kv ::= "\"addvaryheader\"" space ":" space addvaryheader
addvaryheader-rest ::= ( "," space builtin-kv )? builtin-rest
boolean ::= ("true" | "false")
builtin ::= ("\"MODIFIABLE\"" | "\"DELETABLE\"" | "\"IMMUTABLE\"" | "\"PARTITION_ALL\"")
builtin-kv ::= "\"builtin\"" space ":" space builtin
builtin-rest ::= ( "," space cmptype-kv )? cmptype-rest
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
cmptype ::= ("\"compress\"" | "\"gzip\"" | "\"deflate\"" | "\"nocompress\"")
cmptype-kv ::= "\"cmptype\"" space ":" space cmptype
cmptype-rest ::= ( "," space deltatype-kv )? deltatype-rest
deltatype ::= ("\"PERURL\"" | "\"PERPOLICY\"")
deltatype-kv ::= "\"deltatype\"" space ":" space deltatype
deltatype-rest ::= ( "," space feature-kv )? feature-rest
feature ::= ("\"WL\"" | "\"WebLogging\"" | "\"SP\"" | "\"SurgeProtection\"" | "\"LB\"" | "\"LoadBalancing\"" | "\"CS\"" | "\"ContentSwitching\"" | "\"CR\"" | "\"CacheRedirection\"" | "\"SC\"" | "\"SureConnect\"" | "\"CMP\"" | "\"CMPcntl\"" | "\"CompressionControl\"" | "\"PQ\"" | "\"PriorityQueuing\"" | "\"HDOSP\"" | "\"HttpDoSProtection\"" | "\"SSLVPN\"" | "\"AAA\"" | "\"GSLB\"" | "\"GlobalServerLoadBalancing\"" | "\"SSL\"" | "\"SSLOffload\"" | "\"SSLOffloading\"" | "\"CF\"" | "\"ContentFiltering\"" | "\"IC\"" | "\"IntegratedCaching\"" | "\"OSPF\"" | "\"OSPFRouting\"" | "\"RIP\"" | "\"RIPRouting\"" | "\"BGP\"" | "\"BGPRouting\"" | "\"REWRITE\"" | "\"IPv6PT\"" | "\"IPv6protocoltranslation\"" | "\"AppFw\"" | "\"ApplicationFirewall\"" | "\"RESPONDER\"" | "\"HTMLInjection\"" | "\"push\"" | "\"NSPush\"" | "\"NetScalerPush\"" | "\"AppFlow\"" | "\"CloudBridge\"" | "\"ISIS\"" | "\"ISISRouting\"" | "\"CH\"" | "\"CallHome\"" | "\"AppQoE\"" | "\"ContentAccelerator\"" | "\"SYSTEM\"" | "\"RISE\"" | "\"FEO\"" | "\"LSN\"" | "\"LargeScaleNAT\"" | "\"RDPProxy\"" | "\"Rep\"" | "\"Reputation\"" | "\"URLFiltering\"" | "\"VideoOptimization\"" | "\"ForwardProxy\"" | "\"SSLInterception\"" | "\"AdaptiveTCP\"" | "\"CQA\"" | "\"CI\"" | "\"ContentInspection\"" | "\"Bot\"")
feature-kv ::= "\"feature\"" space ":" space feature
feature-rest ::= ( "," space isdefault-kv )? isdefault-rest
isdefault-kv ::= "\"isdefault\"" space ":" space boolean
isdefault-rest ::= ( "," space name-kv )? name-rest
name-kv ::= "\"name\"" space ":" space string
name-rest ::= ( "," space newname-kv )? newname-rest
newname-kv ::= "\"newname\"" space ":" space string
newname-rest ::= ( "," space varyheadervalue-kv )?
root ::= "{" space  (addvaryheader-kv addvaryheader-rest | builtin-kv builtin-rest | cmptype-kv cmptype-rest | deltatype-kv deltatype-rest | feature-kv feature-rest | isdefault-kv isdefault-rest | name-kv name-rest | newname-kv newname-rest | varyheadervalue-kv )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
varyheadervalue-kv ::= "\"varyheadervalue\"" space ":" space string

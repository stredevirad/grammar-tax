boolean ::= ("true" | "false")
brace-style ::= ("\"collapse\"" | "\"expand\"" | "\"end-expand\"" | "\"none\"" | "\"collapse,preserve-inline\"" | "\"expand,preserve-inline\"" | "\"end-expand,preserve-inline\"" | "\"none,preserve-inline\"")
brace-style-kv ::= "\"brace_style\"" space ":" space brace-style
break-chained-methods-kv ::= "\"break_chained_methods\"" space ":" space boolean
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
comma-first-kv ::= "\"comma_first\"" space ":" space boolean
content-unformatted ::= "[" space (string ("," space string)*)? space "]"
content-unformatted-kv ::= "\"content_unformatted\"" space ":" space content-unformatted
decimal-part ::= [0-9]{1,16}
e4x-kv ::= "\"e4x\"" space ":" space boolean
end-with-newline-kv ::= "\"end_with_newline\"" space ":" space boolean
eol-kv ::= "\"eol\"" space ":" space string
extra-liners ::= "[" space (string ("," space string)*)? space "]"
extra-liners-kv ::= "\"extra_liners\"" space ":" space extra-liners
indent-body-inner-html-kv ::= "\"indent_body_inner_html\"" space ":" space boolean
indent-char ::= "\"" char? "\""
indent-char-kv ::= "\"indent_char\"" space ":" space indent-char
indent-handlebars-kv ::= "\"indent_handlebars\"" space ":" space boolean
indent-head-inner-html-kv ::= "\"indent_head_inner_html\"" space ":" space boolean
indent-inner-html-kv ::= "\"indent_inner_html\"" space ":" space boolean
indent-level-kv ::= "\"indent_level\"" space ":" space integer
indent-scripts ::= ("\"keep\"" | "\"separate\"" | "\"normal\"")
indent-scripts-kv ::= "\"indent_scripts\"" space ":" space indent-scripts
indent-size-kv ::= "\"indent_size\"" space ":" space integer
indent-with-tabs-kv ::= "\"indent_with_tabs\"" space ":" space boolean
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
jslint-happy-kv ::= "\"jslint_happy\"" space ":" space boolean
keep-array-indentation-kv ::= "\"keep_array_indentation\"" space ":" space boolean
keep-function-indentation-kv ::= "\"keep_function_indentation\"" space ":" space boolean
max-preserve-newlines-kv ::= "\"max_preserve_newlines\"" space ":" space integer
newline-between-rules-kv ::= "\"newline_between_rules\"" space ":" space boolean
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
operator-position ::= ("\"before-newline\"" | "\"after-newline\"" | "\"preserve-newline\"")
operator-position-kv ::= "\"operator_position\"" space ":" space operator-position
preserve-newlines-kv ::= "\"preserve_newlines\"" space ":" space boolean
root ::= "{" space indent-size-kv "," space indent-char-kv "," space eol-kv "," space indent-with-tabs-kv "," space end-with-newline-kv "," space preserve-newlines-kv "," space max-preserve-newlines-kv "," space brace-style-kv "," space wrap-line-length-kv "," space selector-separator-newline-kv "," space newline-between-rules-kv "," space space-around-selector-separator-kv "," space space-around-combinator-kv "," space void-elements-kv "," space wrap-attributes-kv "," space wrap-attributes-indent-size-kv "," space indent-inner-html-kv "," space indent-scripts-kv "," space unformatted-kv "," space content-unformatted-kv "," space extra-liners-kv "," space indent-body-inner-html-kv "," space indent-head-inner-html-kv "," space indent-handlebars-kv "," space indent-level-kv "," space space-in-paren-kv "," space space-in-empty-paren-kv "," space jslint-happy-kv "," space space-after-anon-function-kv "," space break-chained-methods-kv "," space keep-array-indentation-kv "," space keep-function-indentation-kv "," space space-before-conditional-kv "," space unescape-strings-kv "," space comma-first-kv "," space operator-position-kv "," space e4x-kv "," space unindent-chained-methods-kv space "}"
selector-separator-newline-kv ::= "\"selector_separator_newline\"" space ":" space boolean
space ::= | " " | "\n"{1,2} [ \t]{0,20}
space-after-anon-function-kv ::= "\"space_after_anon_function\"" space ":" space boolean
space-around-combinator-kv ::= "\"space_around_combinator\"" space ":" space boolean
space-around-selector-separator-kv ::= "\"space_around_selector_separator\"" space ":" space boolean
space-before-conditional-kv ::= "\"space_before_conditional\"" space ":" space boolean
space-in-empty-paren-kv ::= "\"space_in_empty_paren\"" space ":" space boolean
space-in-paren-kv ::= "\"space_in_paren\"" space ":" space boolean
string ::= "\"" char* "\""
unescape-strings-kv ::= "\"unescape_strings\"" space ":" space boolean
unformatted ::= "[" space (string ("," space string)*)? space "]"
unformatted-kv ::= "\"unformatted\"" space ":" space unformatted
unindent-chained-methods-kv ::= "\"unindent_chained_methods\"" space ":" space boolean
void-elements ::= "[" space (string ("," space string)*)? space "]"
void-elements-kv ::= "\"void_elements\"" space ":" space void-elements
wrap-attributes ::= ("\"auto\"" | "\"force\"" | "\"force-aligned\"" | "\"force-expand-multiline\"")
wrap-attributes-indent-size-kv ::= "\"wrap_attributes_indent_size\"" space ":" space number
wrap-attributes-kv ::= "\"wrap_attributes\"" space ":" space wrap-attributes
wrap-line-length-kv ::= "\"wrap_line_length\"" space ":" space integer

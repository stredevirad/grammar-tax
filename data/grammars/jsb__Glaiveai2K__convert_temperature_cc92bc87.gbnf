decimal-part ::= [0-9]{1,16}
from-unit ::= ("\"Celsius\"" | "\"Fahrenheit\"" | "\"Kelvin\"")
from-unit-kv ::= "\"from_unit\"" space ":" space from-unit
integral-part ::= [0] | [1-9] [0-9]{0,15}
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
root ::= "{" space from-unit-kv "," space temperature-kv "," space to-unit-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
temperature-kv ::= "\"temperature\"" space ":" space number
to-unit ::= ("\"Celsius\"" | "\"Fahrenheit\"" | "\"Kelvin\"")
to-unit-kv ::= "\"to_unit\"" space ":" space to-unit

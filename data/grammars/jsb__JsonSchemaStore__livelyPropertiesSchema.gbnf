additional-kv ::= string ":" space additional-value
additional-value ::= additional-value-0 | additional-value-1 | additional-value-2 | additional-value-3 | additional-value-4 | additional-value-5 | additional-value-6 | additional-value-7
additional-value-0 ::= "{" space additional-value-0-text-kv "," space additional-value-0-max-kv "," space additional-value-0-min-kv "," space additional-value-0-step-kv ( "," space ( additional-value-0-type-kv additional-value-0-type-rest | additional-value-0-value-kv ) )? space "}"
additional-value-0-max-kv ::= "\"max\"" space ":" space number
additional-value-0-min-kv ::= "\"min\"" space ":" space number
additional-value-0-step-kv ::= "\"step\"" space ":" space number
additional-value-0-text-kv ::= "\"text\"" space ":" space string
additional-value-0-type ::= "\"slider\""
additional-value-0-type-kv ::= "\"type\"" space ":" space additional-value-0-type
additional-value-0-type-rest ::= ( "," space additional-value-0-value-kv )?
additional-value-0-value-kv ::= "\"value\"" space ":" space number
additional-value-1 ::= "{" space additional-value-1-text-kv ( "," space ( additional-value-1-type-kv additional-value-1-type-rest | additional-value-1-value-kv ) )? space "}"
additional-value-1-text-kv ::= "\"text\"" space ":" space string
additional-value-1-type ::= "\"textbox\""
additional-value-1-type-kv ::= "\"type\"" space ":" space additional-value-1-type
additional-value-1-type-rest ::= ( "," space additional-value-1-value-kv )?
additional-value-1-value-kv ::= "\"value\"" space ":" space string
additional-value-2 ::= "{" space additional-value-2-text-kv "," space additional-value-2-items-kv ( "," space ( additional-value-2-type-kv additional-value-2-type-rest | additional-value-2-value-kv ) )? space "}"
additional-value-2-items-kv ::= "\"items\"" space ":" space array
additional-value-2-text-kv ::= "\"text\"" space ":" space string
additional-value-2-type ::= "\"dropdown\""
additional-value-2-type-kv ::= "\"type\"" space ":" space additional-value-2-type
additional-value-2-type-rest ::= ( "," space additional-value-2-value-kv )?
additional-value-2-value-kv ::= "\"value\"" space ":" space integer
additional-value-3 ::= "{" space additional-value-3-text-kv "," space additional-value-3-filter-kv "," space additional-value-3-folder-kv ( "," space ( additional-value-3-type-kv additional-value-3-type-rest | additional-value-3-value-kv ) )? space "}"
additional-value-3-filter-kv ::= "\"filter\"" space ":" space string
additional-value-3-folder-kv ::= "\"folder\"" space ":" space string
additional-value-3-text-kv ::= "\"text\"" space ":" space string
additional-value-3-type ::= "\"folderDropdown\""
additional-value-3-type-kv ::= "\"type\"" space ":" space additional-value-3-type
additional-value-3-type-rest ::= ( "," space additional-value-3-value-kv )?
additional-value-3-value-kv ::= "\"value\"" space ":" space string
additional-value-4 ::= "{" space additional-value-4-text-kv ( "," space ( additional-value-4-type-kv additional-value-4-type-rest | additional-value-4-value-kv ) )? space "}"
additional-value-4-text-kv ::= "\"text\"" space ":" space string
additional-value-4-type ::= "\"button\""
additional-value-4-type-kv ::= "\"type\"" space ":" space additional-value-4-type
additional-value-4-type-rest ::= ( "," space additional-value-4-value-kv )?
additional-value-4-value-kv ::= "\"value\"" space ":" space string
additional-value-5 ::= "{" space  (additional-value-5-type-kv additional-value-5-type-rest | additional-value-5-value-kv )? space "}"
additional-value-5-type ::= "\"label\""
additional-value-5-type-kv ::= "\"type\"" space ":" space additional-value-5-type
additional-value-5-type-rest ::= ( "," space additional-value-5-value-kv )?
additional-value-5-value-kv ::= "\"value\"" space ":" space string
additional-value-6 ::= "{" space additional-value-6-text-kv ( "," space ( additional-value-6-type-kv additional-value-6-type-rest | additional-value-6-value-kv ) )? space "}"
additional-value-6-text-kv ::= "\"text\"" space ":" space string
additional-value-6-type ::= "\"color\""
additional-value-6-type-kv ::= "\"type\"" space ":" space additional-value-6-type
additional-value-6-type-rest ::= ( "," space additional-value-6-value-kv )?
additional-value-6-value-kv ::= "\"value\"" space ":" space string
additional-value-7 ::= "{" space additional-value-7-text-kv ( "," space ( additional-value-7-type-kv additional-value-7-type-rest | additional-value-7-value-kv ) )? space "}"
additional-value-7-text-kv ::= "\"text\"" space ":" space string
additional-value-7-type ::= "\"checkbox\""
additional-value-7-type-kv ::= "\"type\"" space ":" space additional-value-7-type
additional-value-7-type-rest ::= ( "," space additional-value-7-value-kv )?
additional-value-7-value-kv ::= "\"value\"" space ":" space boolean
array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
root ::= "{" space  (additional-kv ( "," space additional-kv )* )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
value ::= object | array | string | number | boolean | null

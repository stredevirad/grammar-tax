array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
item ::= "{" space  (item-site-kv item-site-rest | item-url-kv item-url-rest | item-additional-kv ( "," space item-additional-kv )* )? space "}"
item-additional-k ::= ["] ( [s] ([i] ([t] ([e] char+ | [^"e] char*) | [^"t] char*) | [^"i] char*) | [u] ([r] ([l] char+ | [^"l] char*) | [^"r] char*) | [^"su] char* )? ["]
item-additional-kv ::= item-additional-k ":" space value
item-site-kv ::= "\"site\"" space ":" space string
item-site-rest ::= ( "," space item-url-kv )? item-url-rest
item-url-kv ::= "\"url\"" space ":" space string
item-url-rest ::= ( "," space item-additional-kv )*
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
root ::= "[" space (item ("," space item)*)? space "]"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
value ::= object | array | string | number | boolean | null

array ::= "[" space ( value ("," space value)* )? space "]"
attributes ::= attributes-0 | null
attributes-0 ::= object
attributes-kv ::= "\"attributes\"" space ":" space attributes
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
cpuPlatform ::= "\"" char{0,64} "\""
cpuPlatform-kv ::= "\"cpuPlatform\"" space ":" space cpuPlatform
decimal-part ::= [0-9]{1,16}
hostname ::= "\"" char{0,255} "\""
hostname-kv ::= "\"hostname\"" space ":" space hostname
id ::= "\"" char{0,32} "\""
id-kv ::= "\"id\"" space ":" space id
image ::= "\"" char{0,128} "\""
image-kv ::= "\"image\"" space ":" space image
integral-part ::= [0] | [1-9] [0-9]{0,15}
machineType ::= "\"" char{0,64} "\""
machineType-kv ::= "\"machineType\"" space ":" space machineType
name ::= "\"" char{0,64} "\""
name-kv ::= "\"name\"" space ":" space name
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
root ::= "{" space attributes-kv "," space cpuPlatform-kv "," space hostname-kv "," space id-kv "," space image-kv "," space machineType-kv "," space name-kv "," space tags-kv "," space zone-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
tags ::= tags-0 | null
tags-0 ::= "[" space (string ("," space string)*)? space "]"
tags-kv ::= "\"tags\"" space ":" space tags
value ::= object | array | string | number | boolean | null
zone ::= "\"" char{0,64} "\""
zone-kv ::= "\"zone\"" space ":" space zone

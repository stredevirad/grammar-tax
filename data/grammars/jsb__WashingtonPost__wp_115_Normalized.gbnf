-id ::= string
-id-kv ::= "\"_id\"" space ":" space -id
-id-rest ::= ( "," space additional-properties-kv )? additional-properties-rest
additional-properties ::= ref-definitions-traits-trait-additional-properties-json
additional-properties-kv ::= "\"additional_properties\"" space ":" space additional-properties
additional-properties-rest ::= ( "," space description-kv )? description-rest
array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
description-kv ::= "\"description\"" space ":" space string
description-rest ::= ( "," space parent-id-kv )? parent-id-rest
integral-part ::= [0] | [1-9] [0-9]{0,15}
name-kv ::= "\"name\"" space ":" space string
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
parent-id-kv ::= "\"parent_id\"" space ":" space string
parent-id-rest ::= ( "," space path-kv )? path-rest
path-kv ::= "\"path\"" space ":" space string
path-rest ::= ( "," space primary-kv )?
primary-kv ::= "\"primary\"" space ":" space boolean
ref-definitions-traits-trait-additional-properties-json ::= object
ref-definitions-traits-trait-version-json ::= ("\"0.10.9\"")
root ::= "{" space name-kv "," space type-kv "," space version-kv ( "," space ( -id-kv -id-rest | additional-properties-kv additional-properties-rest | description-kv description-rest | parent-id-kv parent-id-rest | path-kv path-rest | primary-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
type ::= ("\"site\"")
type-kv ::= "\"type\"" space ":" space type
value ::= object | array | string | number | boolean | null
version ::= ref-definitions-traits-trait-version-json
version-kv ::= "\"version\"" space ":" space version

-schema-kv ::= "\"$schema\"" space ":" space string
-schema-rest ::= ( "," space dest-kv )? dest-rest
array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
dest-kv ::= "\"dest\"" space ":" space string
dest-rest ::= ( "," space lib-kv )? lib-rest
integral-part ::= [0] | [1-9] [0-9]{0,15}
lib ::= "{" space  (lib-entryFile-kv lib-entryFile-rest | lib-externals-kv lib-externals-rest | lib-flatModuleFile-kv lib-flatModuleFile-rest | lib-jsx-kv )? space "}"
lib-entryFile-kv ::= "\"entryFile\"" space ":" space string
lib-entryFile-rest ::= ( "," space lib-externals-kv )? lib-externals-rest
lib-externals ::= object
lib-externals-kv ::= "\"externals\"" space ":" space lib-externals
lib-externals-rest ::= ( "," space lib-flatModuleFile-kv )? lib-flatModuleFile-rest
lib-flatModuleFile-kv ::= "\"flatModuleFile\"" space ":" space string
lib-flatModuleFile-rest ::= ( "," space lib-jsx-kv )?
lib-jsx ::= ("\"preserve\"" | "\"react\"" | "\"react-native\"")
lib-jsx-kv ::= "\"jsx\"" space ":" space lib-jsx
lib-kv ::= "\"lib\"" space ":" space lib
lib-rest ::= ( "," space src-kv )? src-rest
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
root ::= "{" space  (-schema-kv -schema-rest | dest-kv dest-rest | lib-kv lib-rest | src-kv src-rest | workingDirectory-kv )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
src-kv ::= "\"src\"" space ":" space string
src-rest ::= ( "," space workingDirectory-kv )?
string ::= "\"" char* "\""
value ::= object | array | string | number | boolean | null
workingDirectory-kv ::= "\"workingDirectory\"" space ":" space string

char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
content ::= "{" space  (content-helpTopics-kv )? space "}"
content-helpTopics ::= content-helpTopics-0 | null
content-helpTopics-0 ::= "[" space (content-helpTopics-0-item ("," space content-helpTopics-0-item)*)? space "]"
content-helpTopics-0-item ::= "{" space content-helpTopics-0-item-title-kv "," space content-helpTopics-0-item-url-kv space "}"
content-helpTopics-0-item-title-kv ::= "\"title\"" space ":" space string
content-helpTopics-0-item-url-kv ::= "\"url\"" space ":" space string
content-helpTopics-kv ::= "\"helpTopics\"" space ":" space content-helpTopics
content-kv ::= "\"content\"" space ":" space content
description-kv ::= "\"description\"" space ":" space string
image-kv ::= "\"image\"" space ":" space string
image-rest ::= ( "," space content-kv )?
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
null ::= "null"
order-kv ::= "\"order\"" space ":" space integer
root ::= "{" space title-kv "," space description-kv "," space order-kv ( "," space ( image-kv image-rest | content-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
title-kv ::= "\"title\"" space ":" space string

boolean ::= ("true" | "false")
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
ref-definitions-display ::= "{" space ref-definitions-display-width-kv "," space ref-definitions-display-height-kv "," space ref-definitions-display-touch-kv "," space ref-definitions-display-size-kv space "}"
ref-definitions-display-height ::= ref-definitions-display-height-0 | null
ref-definitions-display-height-0 ::= ([0] | [1-9] [0-9]{0,15})
ref-definitions-display-height-kv ::= "\"height\"" space ":" space ref-definitions-display-height
ref-definitions-display-size ::= number | null
ref-definitions-display-size-kv ::= "\"size\"" space ":" space ref-definitions-display-size
ref-definitions-display-touch ::= boolean | null
ref-definitions-display-touch-kv ::= "\"touch\"" space ":" space ref-definitions-display-touch
ref-definitions-display-width ::= ref-definitions-display-width-0 | null
ref-definitions-display-width-0 ::= ([0] | [1-9] [0-9]{0,15})
ref-definitions-display-width-kv ::= "\"width\"" space ":" space ref-definitions-display-width
root ::= ref-definitions-display
space ::= | " " | "\n"{1,2} [ \t]{0,20}

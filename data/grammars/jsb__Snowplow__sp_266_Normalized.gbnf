char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
null ::= "null"
previousSessionId ::= null | string
previousSessionId-kv ::= "\"previousSessionId\"" space ":" space previousSessionId
root ::= "{" space previousSessionId-kv "," space sessionId-kv "," space sessionIndex-kv "," space storageMechanism-kv "," space userId-kv space "}"
sessionId-kv ::= "\"sessionId\"" space ":" space string
sessionIndex ::= ([0-9] | ([1-8] [0-9] | [9] [0-9]) | ([1-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])) | ([1-8] [0-9]{3} | [9] ([0-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9]))) | ([1-8] [0-9]{4} | [9] ([0-8] [0-9]{3} | [9] ([0-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])))) | ([1-8] [0-9]{5} | [9] ([0-8] [0-9]{4} | [9] ([0-8] [0-9]{3} | [9] ([0-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9]))))) | ([1-8] [0-9]{6} | [9] ([0-8] [0-9]{5} | [9] ([0-8] [0-9]{4} | [9] ([0-8] [0-9]{3} | [9] ([0-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])))))) | ([1-8] [0-9]{7} | [9] ([0-8] [0-9]{6} | [9] ([0-8] [0-9]{5} | [9] ([0-8] [0-9]{4} | [9] ([0-8] [0-9]{3} | [9] ([0-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9]))))))) | ([1-8] [0-9]{8} | [9] ([0-8] [0-9]{7} | [9] ([0-8] [0-9]{6} | [9] ([0-8] [0-9]{5} | [9] ([0-8] [0-9]{4} | [9] ([0-8] [0-9]{3} | [9] ([0-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])))))))) | ([1] [0-9]{9} | [2] ([0] [0-9]{8} | [1] ([0-3] [0-9]{7} | [4] ([0-6] [0-9]{6} | [7] ([0-3] [0-9]{5} | [4] ([0-7] [0-9]{4} | [8] ([0-2] [0-9]{3} | [3] ([0-5] [0-9]{2} | [6] ([0-3] [0-9] | [4] [0-7]))))))))))
sessionIndex-kv ::= "\"sessionIndex\"" space ":" space sessionIndex
space ::= | " " | "\n"{1,2} [ \t]{0,20}
storageMechanism ::= ("\"SQLITE\"" | "\"COOKIE_1\"" | "\"COOKIE_3\"" | "\"LOCAL_STORAGE\"" | "\"FLASH_LSO\"")
storageMechanism-kv ::= "\"storageMechanism\"" space ":" space storageMechanism
string ::= "\"" char* "\""
userId ::= string
userId-kv ::= "\"userId\"" space ":" space userId

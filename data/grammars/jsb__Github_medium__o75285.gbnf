attributes ::= "{" space  (attributes-price-kv attributes-price-rest | attributes-start-at-kv attributes-start-at-rest | attributes-end-at-kv )? space "}"
attributes-end-at-kv ::= "\"end_at\"" space ":" space string
attributes-kv ::= "\"attributes\"" space ":" space attributes
attributes-price-kv ::= "\"price\"" space ":" space number
attributes-price-rest ::= ( "," space attributes-start-at-kv )? attributes-start-at-rest
attributes-rest ::= ( "," space relationships-kv )? relationships-rest
attributes-start-at-kv ::= "\"start_at\"" space ":" space string
attributes-start-at-rest ::= ( "," space attributes-end-at-kv )?
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
id-kv ::= "\"id\"" space ":" space string
id-rest ::= ( "," space type-kv )? type-rest
integral-part ::= [0] | [1-9] [0-9]{0,15}
links ::= "{" space  (links-self-kv )? space "}"
links-kv ::= "\"links\"" space ":" space links
links-rest ::= ( "," space meta-kv )?
links-self-kv ::= "\"self\"" space ":" space string
meta ::= "{" space "}"
meta-kv ::= "\"meta\"" space ":" space meta
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
relationships ::= "{" space "}"
relationships-kv ::= "\"relationships\"" space ":" space relationships
relationships-rest ::= ( "," space links-kv )? links-rest
root ::= "{" space  (id-kv id-rest | type-kv type-rest | attributes-kv attributes-rest | relationships-kv relationships-rest | links-kv links-rest | meta-kv )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
type ::= "\"" ("markdown_prices") "\""
type-kv ::= "\"type\"" space ":" space type
type-rest ::= ( "," space attributes-kv )? attributes-rest

char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
created ::= string
created-kv ::= "\"created\"" space ":" space created
id-kv ::= "\"id\"" space ":" space integer
image-kv ::= "\"image\"" space ":" space string
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
modified ::= string
modified-kv ::= "\"modified\"" space ":" space modified
name-kv ::= "\"name\"" space ":" space string
pokemon ::= ref-definitions-namedResource
pokemon-kv ::= "\"pokemon\"" space ":" space pokemon
ref-definitions-namedResource ::= "{" space ref-definitions-namedResource-name-kv "," space ref-definitions-namedResource-resource-uri-kv space "}"
ref-definitions-namedResource-name-kv ::= "\"name\"" space ":" space string
ref-definitions-namedResource-resource-uri-kv ::= "\"resource_uri\"" space ":" space string
resource-uri-kv ::= "\"resource_uri\"" space ":" space string
root ::= "{" space created-kv "," space id-kv "," space image-kv "," space modified-kv "," space name-kv "," space pokemon-kv "," space resource-uri-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""

-id ::= string
-id-kv ::= "\"_id\"" space ":" space -id
-id-rest ::= ( "," space additional-properties-kv )? additional-properties-rest
additional-properties ::= ref-definitions-traits-trait-additional-properties-json
additional-properties-kv ::= "\"additional_properties\"" space ":" space additional-properties
additional-properties-rest ::= ( "," space alignment-kv )? alignment-rest
alignment ::= ref-definitions-traits-trait-alignment-json
alignment-kv ::= "\"alignment\"" space ":" space alignment
alignment-rest ::= ( "," space channels-kv )? channels-rest
array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
channels ::= ref-definitions-traits-trait-channel-json
channels-kv ::= "\"channels\"" space ":" space channels
channels-rest ::= ( "," space subtype-kv )?
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
ref-definitions-traits-trait-additional-properties-json ::= object
ref-definitions-traits-trait-alignment-json ::= ("\"left\"" | "\"right\"" | "\"center\"")
ref-definitions-traits-trait-channel-json ::= "[" space (string ("," space string)*)? space "]"
referent ::= "{" space referent-id-kv ( "," space ( referent-provider-kv referent-provider-rest | referent-referent-properties-kv referent-referent-properties-rest | referent-service-kv referent-service-rest | referent-type-kv referent-type-rest | referent-website-kv ) )? space "}"
referent-id-kv ::= "\"id\"" space ":" space string
referent-kv ::= "\"referent\"" space ":" space referent
referent-provider-kv ::= "\"provider\"" space ":" space string
referent-provider-rest ::= ( "," space referent-referent-properties-kv )? referent-referent-properties-rest
referent-referent-properties ::= object
referent-referent-properties-kv ::= "\"referent_properties\"" space ":" space referent-referent-properties
referent-referent-properties-rest ::= ( "," space referent-service-kv )? referent-service-rest
referent-service-kv ::= "\"service\"" space ":" space string
referent-service-rest ::= ( "," space referent-type-kv )? referent-type-rest
referent-type-kv ::= "\"type\"" space ":" space string
referent-type-rest ::= ( "," space referent-website-kv )?
referent-website-kv ::= "\"website\"" space ":" space string
root ::= "{" space referent-kv "," space type-kv ( "," space ( -id-kv -id-rest | additional-properties-kv additional-properties-rest | alignment-kv alignment-rest | channels-kv channels-rest | subtype-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
subtype ::= string
subtype-kv ::= "\"subtype\"" space ":" space subtype
type ::= ("\"reference\"")
type-kv ::= "\"type\"" space ":" space type
value ::= object | array | string | number | boolean | null

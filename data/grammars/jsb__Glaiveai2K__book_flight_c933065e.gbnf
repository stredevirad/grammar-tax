char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
departure-date-kv ::= "\"departure_date\"" space ":" space string
destination-kv ::= "\"destination\"" space ":" space string
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
origin-kv ::= "\"origin\"" space ":" space string
passengers-kv ::= "\"passengers\"" space ":" space integer
return-date-kv ::= "\"return_date\"" space ":" space string
root ::= "{" space departure-date-kv "," space destination-kv "," space origin-kv "," space passengers-kv ( "," space ( return-date-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""

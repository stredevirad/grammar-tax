alternative-0 ::= "{" space  (alternative-0-additional-properties-kv alternative-0-additional-properties-rest | alternative-0-category-kv alternative-0-category-rest | alternative-0-mode-kv alternative-0-mode-rest | alternative-0-name-kv alternative-0-name-rest | alternative-0-subcategory-kv )? space "}"
alternative-0-additional-properties ::= ref-definitions-trait-additional-properties-json
alternative-0-additional-properties-kv ::= "\"additional_properties\"" space ":" space alternative-0-additional-properties
alternative-0-additional-properties-rest ::= ( "," space alternative-0-category-kv )? alternative-0-category-rest
alternative-0-category ::= ("\"staff\"" | "\"wires\"" | "\"freelance\"" | "\"stock\"" | "\"handout\"" | "\"other\"")
alternative-0-category-kv ::= "\"category\"" space ":" space alternative-0-category
alternative-0-category-rest ::= ( "," space alternative-0-mode-kv )? alternative-0-mode-rest
alternative-0-mode ::= ("\"custom\"")
alternative-0-mode-kv ::= "\"mode\"" space ":" space alternative-0-mode
alternative-0-mode-rest ::= ( "," space alternative-0-name-kv )? alternative-0-name-rest
alternative-0-name-kv ::= "\"name\"" space ":" space string
alternative-0-name-rest ::= ( "," space alternative-0-subcategory-kv )?
alternative-0-subcategory-kv ::= "\"subcategory\"" space ":" space string
alternative-1 ::= "{" space alternative-1-mode-kv "," space alternative-1-reference-id-kv space "}"
alternative-1-mode ::= ("\"reference\"")
alternative-1-mode-kv ::= "\"mode\"" space ":" space alternative-1-mode
alternative-1-reference-id-kv ::= "\"reference_id\"" space ":" space string
array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
ref-definitions-trait-additional-properties-json ::= object
root ::= alternative-0 | alternative-1
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
value ::= object | array | string | number | boolean | null

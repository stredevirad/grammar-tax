-id ::= string
-id-kv ::= "\"_id\"" space ":" space -id
-schema ::= string
-schema-kv ::= "\"_schema\"" space ":" space -schema
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
comment ::= "\"" char{0,65535} "\""
comment-kv ::= "\"comment\"" space ":" space comment
created-at ::= "\"" (created-at-1{1,1} created-at-2{12,15}) "\""
created-at-1 ::= [1-9]
created-at-2 ::= [0-9]
created-at-kv ::= "\"created_at\"" space ":" space created-at
published-at ::= "\"" (published-at-1{1,1} published-at-2{12,15}) "\""
published-at-1 ::= [1-9]
published-at-2 ::= [0-9]
published-at-kv ::= "\"published_at\"" space ":" space published-at
published-at-rest ::= ( "," space comment-kv )?
root ::= "{" space -schema-kv "," space -id-kv "," space created-at-kv ( "," space ( updated-at-kv updated-at-rest | published-at-kv published-at-rest | comment-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
updated-at ::= "\"" (updated-at-1{1,1} updated-at-2{12,15}) "\""
updated-at-1 ::= [1-9]
updated-at-2 ::= [0-9]
updated-at-kv ::= "\"updated_at\"" space ":" space updated-at
updated-at-rest ::= ( "," space published-at-kv )? published-at-rest

array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
data ::= "{" space data-selectionStrategy-kv ( "," space ( data-batchesUri-kv data-batchesUri-rest | data-batches-kv data-batches-rest | data-customData-kv ) )? space "}"
data-batches ::= "[" space (data-batches-item ("," space data-batches-item)*)? space "]"
data-batches-item ::= "{" space data-batches-item-priority-kv "," space data-batches-item-recipes-kv ( "," space ( data-batches-item-name-kv data-batches-item-name-rest | data-batches-item-dependencies-kv ) )? space "}"
data-batches-item-dependencies ::= "[" space (data-batches-item-dependencies-item ("," space data-batches-item-dependencies-item)*)? space "]"
data-batches-item-dependencies-item ::= "{" space data-batches-item-dependencies-item-dependent-kv "," space data-batches-item-dependencies-item-dependency-kv space "}"
data-batches-item-dependencies-item-dependency-kv ::= "\"dependency\"" space ":" space string
data-batches-item-dependencies-item-dependent-kv ::= "\"dependent\"" space ":" space string
data-batches-item-dependencies-kv ::= "\"dependencies\"" space ":" space data-batches-item-dependencies
data-batches-item-name-kv ::= "\"name\"" space ":" space string
data-batches-item-name-rest ::= ( "," space data-batches-item-dependencies-kv )?
data-batches-item-priority-kv ::= "\"priority\"" space ":" space integer
data-batches-item-recipes ::= "[" space (data-batches-item-recipes-item ("," space data-batches-item-recipes-item)*)? space "]"
data-batches-item-recipes-item ::= "{" space data-batches-item-recipes-item-id-kv "," space data-batches-item-recipes-item-testCase-kv ( "," space ( data-batches-item-recipes-item-constraints-kv ) )? space "}"
data-batches-item-recipes-item-constraints ::= "[" space (data-batches-item-recipes-item-constraints-item ("," space data-batches-item-recipes-item-constraints-item)*)? space "]"
data-batches-item-recipes-item-constraints-item ::= "{" space data-batches-item-recipes-item-constraints-item-key-kv "," space data-batches-item-recipes-item-constraints-item-value-kv space "}"
data-batches-item-recipes-item-constraints-item-key-kv ::= "\"key\"" space ":" space string
data-batches-item-recipes-item-constraints-item-value ::= value
data-batches-item-recipes-item-constraints-item-value-kv ::= "\"value\"" space ":" space data-batches-item-recipes-item-constraints-item-value
data-batches-item-recipes-item-constraints-kv ::= "\"constraints\"" space ":" space data-batches-item-recipes-item-constraints
data-batches-item-recipes-item-id ::= "\"" (data-batches-item-recipes-item-id-1{8,8} "-" data-batches-item-recipes-item-id-1{4,4} "-" [1-5] data-batches-item-recipes-item-id-1{3,3} "-" [89ab] data-batches-item-recipes-item-id-1{3,3} "-" data-batches-item-recipes-item-id-1{12,12}) "\""
data-batches-item-recipes-item-id-1 ::= [0-9a-f]
data-batches-item-recipes-item-id-kv ::= "\"id\"" space ":" space data-batches-item-recipes-item-id
data-batches-item-recipes-item-testCase ::= "{" space data-batches-item-recipes-item-testCase-id-kv ( "," space ( data-batches-item-recipes-item-testCase-tracker-kv data-batches-item-recipes-item-testCase-tracker-rest | data-batches-item-recipes-item-testCase-uri-kv ) )? space "}"
data-batches-item-recipes-item-testCase-id-kv ::= "\"id\"" space ":" space string
data-batches-item-recipes-item-testCase-kv ::= "\"testCase\"" space ":" space data-batches-item-recipes-item-testCase
data-batches-item-recipes-item-testCase-tracker-kv ::= "\"tracker\"" space ":" space string
data-batches-item-recipes-item-testCase-tracker-rest ::= ( "," space data-batches-item-recipes-item-testCase-uri-kv )?
data-batches-item-recipes-item-testCase-uri-kv ::= "\"uri\"" space ":" space string
data-batches-item-recipes-kv ::= "\"recipes\"" space ":" space data-batches-item-recipes
data-batches-kv ::= "\"batches\"" space ":" space data-batches
data-batches-rest ::= ( "," space data-customData-kv )?
data-batchesUri-kv ::= "\"batchesUri\"" space ":" space string
data-batchesUri-rest ::= ( "," space data-batches-kv )? data-batches-rest
data-customData ::= "[" space (data-customData-item ("," space data-customData-item)*)? space "]"
data-customData-item ::= "{" space data-customData-item-key-kv "," space data-customData-item-value-kv space "}"
data-customData-item-key-kv ::= "\"key\"" space ":" space string
data-customData-item-value ::= value
data-customData-item-value-kv ::= "\"value\"" space ":" space data-customData-item-value
data-customData-kv ::= "\"customData\"" space ":" space data-customData
data-kv ::= "\"data\"" space ":" space data
data-selectionStrategy ::= "{" space data-selectionStrategy-id-kv ( "," space ( data-selectionStrategy-tracker-kv data-selectionStrategy-tracker-rest | data-selectionStrategy-uri-kv ) )? space "}"
data-selectionStrategy-id-kv ::= "\"id\"" space ":" space string
data-selectionStrategy-kv ::= "\"selectionStrategy\"" space ":" space data-selectionStrategy
data-selectionStrategy-tracker-kv ::= "\"tracker\"" space ":" space string
data-selectionStrategy-tracker-rest ::= ( "," space data-selectionStrategy-uri-kv )?
data-selectionStrategy-uri-kv ::= "\"uri\"" space ":" space string
decimal-part ::= [0-9]{1,16}
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
links ::= "[" space (links-item ("," space links-item)*)? space "]"
links-item ::= "{" space links-item-type-kv "," space links-item-target-kv space "}"
links-item-target-kv ::= "\"target\"" space ":" space string
links-item-type-kv ::= "\"type\"" space ":" space string
links-kv ::= "\"links\"" space ":" space links
meta ::= "{" space meta-id-kv "," space meta-type-kv "," space meta-version-kv "," space meta-time-kv ( "," space ( meta-tags-kv meta-tags-rest | meta-source-kv meta-source-rest | meta-security-kv ) )? space "}"
meta-id ::= "\"" (meta-id-1{8,8} "-" meta-id-1{4,4} "-" [1-5] meta-id-1{3,3} "-" [89ab] meta-id-1{3,3} "-" meta-id-1{12,12}) "\""
meta-id-1 ::= [0-9a-f]
meta-id-kv ::= "\"id\"" space ":" space meta-id
meta-kv ::= "\"meta\"" space ":" space meta
meta-security ::= "{" space meta-security-authorIdentity-kv ( "," space ( meta-security-integrityProtection-kv meta-security-integrityProtection-rest | meta-security-sequenceProtection-kv ) )? space "}"
meta-security-authorIdentity-kv ::= "\"authorIdentity\"" space ":" space string
meta-security-integrityProtection ::= "{" space meta-security-integrityProtection-signature-kv "," space meta-security-integrityProtection-alg-kv ( "," space ( meta-security-integrityProtection-publicKey-kv ) )? space "}"
meta-security-integrityProtection-alg ::= ("\"HS256\"" | "\"HS384\"" | "\"HS512\"" | "\"RS256\"" | "\"RS384\"" | "\"RS512\"" | "\"ES256\"" | "\"ES384\"" | "\"ES512\"" | "\"PS256\"" | "\"PS384\"" | "\"PS512\"")
meta-security-integrityProtection-alg-kv ::= "\"alg\"" space ":" space meta-security-integrityProtection-alg
meta-security-integrityProtection-kv ::= "\"integrityProtection\"" space ":" space meta-security-integrityProtection
meta-security-integrityProtection-publicKey-kv ::= "\"publicKey\"" space ":" space string
meta-security-integrityProtection-rest ::= ( "," space meta-security-sequenceProtection-kv )?
meta-security-integrityProtection-signature-kv ::= "\"signature\"" space ":" space string
meta-security-kv ::= "\"security\"" space ":" space meta-security
meta-security-sequenceProtection ::= "[" space (meta-security-sequenceProtection-item ("," space meta-security-sequenceProtection-item)*)? space "]"
meta-security-sequenceProtection-item ::= "{" space meta-security-sequenceProtection-item-sequenceName-kv "," space meta-security-sequenceProtection-item-position-kv space "}"
meta-security-sequenceProtection-item-position-kv ::= "\"position\"" space ":" space integer
meta-security-sequenceProtection-item-sequenceName-kv ::= "\"sequenceName\"" space ":" space string
meta-security-sequenceProtection-kv ::= "\"sequenceProtection\"" space ":" space meta-security-sequenceProtection
meta-source ::= "{" space  (meta-source-domainId-kv meta-source-domainId-rest | meta-source-host-kv meta-source-host-rest | meta-source-name-kv meta-source-name-rest | meta-source-serializer-kv meta-source-serializer-rest | meta-source-uri-kv )? space "}"
meta-source-domainId-kv ::= "\"domainId\"" space ":" space string
meta-source-domainId-rest ::= ( "," space meta-source-host-kv )? meta-source-host-rest
meta-source-host-kv ::= "\"host\"" space ":" space string
meta-source-host-rest ::= ( "," space meta-source-name-kv )? meta-source-name-rest
meta-source-kv ::= "\"source\"" space ":" space meta-source
meta-source-name-kv ::= "\"name\"" space ":" space string
meta-source-name-rest ::= ( "," space meta-source-serializer-kv )? meta-source-serializer-rest
meta-source-rest ::= ( "," space meta-security-kv )?
meta-source-serializer ::= string
meta-source-serializer-kv ::= "\"serializer\"" space ":" space meta-source-serializer
meta-source-serializer-rest ::= ( "," space meta-source-uri-kv )?
meta-source-uri-kv ::= "\"uri\"" space ":" space string
meta-tags ::= "[" space (string ("," space string)*)? space "]"
meta-tags-kv ::= "\"tags\"" space ":" space meta-tags
meta-tags-rest ::= ( "," space meta-source-kv )? meta-source-rest
meta-time-kv ::= "\"time\"" space ":" space integer
meta-type ::= ("\"EiffelTestExecutionRecipeCollectionCreatedEvent\"")
meta-type-kv ::= "\"type\"" space ":" space meta-type
meta-version ::= ("\"4.0.0\"")
meta-version-kv ::= "\"version\"" space ":" space meta-version
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
root ::= "{" space meta-kv "," space data-kv "," space links-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
value ::= object | array | string | number | boolean | null

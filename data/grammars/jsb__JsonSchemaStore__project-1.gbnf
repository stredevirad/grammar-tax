ref-definitions-compilationOptions ::= "{" space  (ref-definitions-compilationOptions-define-kv ref-definitions-compilationOptions-define-rest | ref-definitions-compilationOptions-warningsAsErrors-kv ref-definitions-compilationOptions-warningsAsErrors-rest | ref-definitions-compilationOptions-allowUnsafe-kv ref-definitions-compilationOptions-allowUnsafe-rest | ref-definitions-compilationOptions-optimize-kv ref-definitions-compilationOptions-optimize-rest | ref-definitions-compilationOptions-languageVersion-kv )? space "}"

boolean ::= ("true" | "false")
config ::= "{" space config-cost-kv "," space config-nocleanup-kv "," space config-verbose-kv space "}"
config-cost ::= ("\"mutualinfo\"" | "\"corratio\"" | "\"normcorr\"" | "\"normmi\"" | "\"leastsq\"" | "\"labeldiff\"" | "\"bbr\"")
config-cost-kv ::= "\"cost\"" space ":" space config-cost
config-kv ::= "\"config\"" space ":" space config
config-nocleanup-kv ::= "\"nocleanup\"" space ":" space boolean
config-verbose-kv ::= "\"verbose\"" space ":" space boolean
inputs ::= "{" space inputs-infile-kv ( "," space ( inputs-template-kv inputs-template-rest | inputs-facemask-kv ) )? space "}"
inputs-facemask ::= "{" space  (inputs-facemask-type-kv )? space "}"
inputs-facemask-kv ::= "\"facemask\"" space ":" space inputs-facemask
inputs-facemask-type ::= ("\"nifti\"")
inputs-facemask-type-kv ::= "\"type\"" space ":" space inputs-facemask-type
inputs-infile ::= "{" space  (inputs-infile-type-kv )? space "}"
inputs-infile-kv ::= "\"infile\"" space ":" space inputs-infile
inputs-infile-type ::= ("\"nifti\"")
inputs-infile-type-kv ::= "\"type\"" space ":" space inputs-infile-type
inputs-kv ::= "\"inputs\"" space ":" space inputs
inputs-template ::= "{" space  (inputs-template-type-kv )? space "}"
inputs-template-kv ::= "\"template\"" space ":" space inputs-template
inputs-template-rest ::= ( "," space inputs-facemask-kv )?
inputs-template-type ::= ("\"nifti\"")
inputs-template-type-kv ::= "\"type\"" space ":" space inputs-template-type
root ::= "{" space config-kv "," space inputs-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}

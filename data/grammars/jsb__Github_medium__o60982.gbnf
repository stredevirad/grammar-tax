-release-kv ::= "\"_release\"" space ":" space string
array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
details ::= ref-definitions-github-extracted-details
details-kv ::= "\"details\"" space ":" space details
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
ref-definitions-github-extracted-details ::= "{" space  (ref-definitions-github-extracted-details-forks-count-kv ref-definitions-github-extracted-details-forks-count-rest | ref-definitions-github-extracted-details-last-year-commits-kv ref-definitions-github-extracted-details-last-year-commits-rest | ref-definitions-github-extracted-details-open-issues-count-kv ref-definitions-github-extracted-details-open-issues-count-rest | ref-definitions-github-extracted-details-stargazers-count-kv ref-definitions-github-extracted-details-stargazers-count-rest | ref-definitions-github-extracted-details-subscribers-count-kv ref-definitions-github-extracted-details-subscribers-count-rest | ref-definitions-github-extracted-details-contributors-count-kv ref-definitions-github-extracted-details-contributors-count-rest | ref-definitions-github-extracted-details-topics-kv ref-definitions-github-extracted-details-topics-rest | ref-definitions-github-extracted-details-license-kv )? space "}"
ref-definitions-github-extracted-details-contributors-count-kv ::= "\"contributors_count\"" space ":" space integer
ref-definitions-github-extracted-details-contributors-count-rest ::= ( "," space ref-definitions-github-extracted-details-topics-kv )? ref-definitions-github-extracted-details-topics-rest
ref-definitions-github-extracted-details-forks-count-kv ::= "\"forks_count\"" space ":" space integer
ref-definitions-github-extracted-details-forks-count-rest ::= ( "," space ref-definitions-github-extracted-details-last-year-commits-kv )? ref-definitions-github-extracted-details-last-year-commits-rest
ref-definitions-github-extracted-details-last-year-commits ::= ref-definitions-github-last-year-commits-details
ref-definitions-github-extracted-details-last-year-commits-kv ::= "\"last_year_commits\"" space ":" space ref-definitions-github-extracted-details-last-year-commits
ref-definitions-github-extracted-details-last-year-commits-rest ::= ( "," space ref-definitions-github-extracted-details-open-issues-count-kv )? ref-definitions-github-extracted-details-open-issues-count-rest
ref-definitions-github-extracted-details-license ::= object
ref-definitions-github-extracted-details-license-kv ::= "\"license\"" space ":" space ref-definitions-github-extracted-details-license
ref-definitions-github-extracted-details-open-issues-count-kv ::= "\"open_issues_count\"" space ":" space integer
ref-definitions-github-extracted-details-open-issues-count-rest ::= ( "," space ref-definitions-github-extracted-details-stargazers-count-kv )? ref-definitions-github-extracted-details-stargazers-count-rest
ref-definitions-github-extracted-details-stargazers-count-kv ::= "\"stargazers_count\"" space ":" space integer
ref-definitions-github-extracted-details-stargazers-count-rest ::= ( "," space ref-definitions-github-extracted-details-subscribers-count-kv )? ref-definitions-github-extracted-details-subscribers-count-rest
ref-definitions-github-extracted-details-subscribers-count-kv ::= "\"subscribers_count\"" space ":" space integer
ref-definitions-github-extracted-details-subscribers-count-rest ::= ( "," space ref-definitions-github-extracted-details-contributors-count-kv )? ref-definitions-github-extracted-details-contributors-count-rest
ref-definitions-github-extracted-details-topics ::= "[" space (string ("," space string)*)? space "]"
ref-definitions-github-extracted-details-topics-kv ::= "\"topics\"" space ":" space ref-definitions-github-extracted-details-topics
ref-definitions-github-extracted-details-topics-rest ::= ( "," space ref-definitions-github-extracted-details-license-kv )?
ref-definitions-github-last-year-commits-details ::= "{" space ref-definitions-github-last-year-commits-details-sum-kv "," space ref-definitions-github-last-year-commits-details-weekly-kv space "}"
ref-definitions-github-last-year-commits-details-sum-kv ::= "\"sum\"" space ":" space integer
ref-definitions-github-last-year-commits-details-weekly ::= "[" space (integer ("," space integer)*)? space "]"
ref-definitions-github-last-year-commits-details-weekly-kv ::= "\"weekly\"" space ":" space ref-definitions-github-last-year-commits-details-weekly
root ::= "{" space status-kv "," space details-kv "," space summary-kv ( "," space ( schema-kv schema-rest | -release-kv ) )? space "}"
schema ::= "{" space schema-name-kv "," space schema-version-kv ( "," space ( schema-url-kv ) )? space "}"
schema-kv ::= "\"schema\"" space ":" space schema
schema-name ::= "\"" ([a-zA-Z0-9_]+) "\""
schema-name-kv ::= "\"name\"" space ":" space schema-name
schema-rest ::= ( "," space -release-kv )?
schema-url-kv ::= "\"url\"" space ":" space string
schema-version ::= "\"" ([0-9]+ "-" [0-9]+ "-" [0-9]+) "\""
schema-version-kv ::= "\"version\"" space ":" space schema-version
space ::= | " " | "\n"{1,2} [ \t]{0,20}
status ::= ("\"success\"" | "\"error\"" | "\"unknown\"")
status-kv ::= "\"status\"" space ":" space status
string ::= "\"" char* "\""
summary ::= "[" space (string ("," space string)*)? space "]"
summary-kv ::= "\"summary\"" space ":" space summary
value ::= object | array | string | number | boolean | null

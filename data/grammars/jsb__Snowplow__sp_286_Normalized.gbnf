char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
elementClasses ::= elementClasses-0 | null
elementClasses-0 ::= "[" space (elementClasses-0-item ("," space elementClasses-0-item)*)? space "]"
elementClasses-0-item ::= "\"" char{0,4096} "\""
elementClasses-kv ::= "\"elementClasses\"" space ":" space elementClasses
elementClasses-rest ::= ( "," space elementType-kv )?
elementId ::= "\"" char{0,4096} "\""
elementId-kv ::= "\"elementId\"" space ":" space elementId
elementType ::= elementType-0 | elementType-1
elementType-0 ::= ("\"button\"" | "\"checkbox\"" | "\"color\"" | "\"date\"" | "\"datetime\"" | "\"datetime-local\"" | "\"email\"" | "\"file\"" | "\"hidden\"" | "\"image\"" | "\"month\"" | "\"number\"" | "\"password\"" | "\"radio\"" | "\"range\"" | "\"reset\"" | "\"search\"" | "\"submit\"" | "\"tel\"" | "\"text\"" | "\"time\"" | "\"url\"" | "\"week\"")
elementType-1 ::= ("\"button\"" | "\"checkbox\"" | "\"color\"" | "\"date\"" | "\"datetime\"" | "\"datetime-local\"" | "\"email\"" | "\"file\"" | "\"hidden\"" | "\"image\"" | "\"month\"" | "\"number\"" | "\"password\"" | "\"radio\"" | "\"range\"" | "\"reset\"" | "\"search\"" | "\"submit\"" | "\"tel\"" | "\"text\"" | "\"time\"" | "\"url\"" | "\"week\"")
elementType-kv ::= "\"elementType\"" space ":" space elementType
formId ::= "\"" char{0,4096} "\""
formId-kv ::= "\"formId\"" space ":" space formId
nodeName ::= ("\"INPUT\"" | "\"TEXTAREA\"" | "\"SELECT\"")
nodeName-kv ::= "\"nodeName\"" space ":" space nodeName
null ::= "null"
root ::= "{" space elementId-kv "," space formId-kv "," space nodeName-kv "," space value-kv ( "," space ( elementClasses-kv elementClasses-rest | elementType-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
value- ::= value-0 | null
value-0 ::= "\"" char{0,65535} "\""
value-kv ::= "\"value\"" space ":" space value-

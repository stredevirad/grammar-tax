-schema ::= "\"" char{9,} "\""
-schema-kv ::= "\"$schema\"" space ":" space -schema
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
description-kv ::= "\"description\"" space ":" space string
description-rest ::= ( "," space subscription-amount-kv )?
dot ::= [^\x0A\x0D]
integral-part ::= [0] | [1-9] [0-9]{0,15}
name ::= "\"" char{2,} "\""
name-kv ::= "\"name\"" space ":" space name
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
organisation ::= "{" space  (organisation--ref-kv )? space "}"
organisation--ref ::= "\"" ("https://ils" dot "rero" dot "ch/api/organisations/" dot*?) "\""
organisation--ref-kv ::= "\"$ref\"" space ":" space organisation--ref
organisation-kv ::= "\"organisation\"" space ":" space organisation
pid ::= "\"" char+ "\""
pid-kv ::= "\"pid\"" space ":" space pid
root ::= "{" space -schema-kv "," space pid-kv "," space name-kv "," space organisation-kv ( "," space ( description-kv description-rest | subscription-amount-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
subscription-amount-kv ::= "\"subscription_amount\"" space ":" space number

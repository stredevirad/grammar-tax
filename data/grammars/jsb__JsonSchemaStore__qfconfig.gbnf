boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
connectEditor2DB-kv ::= "\"connectEditor2DB\"" space ":" space boolean
connectEditor2DB-rest ::= ( "," space helperAssemblies-kv )? helperAssemblies-rest
defaultConnection-kv ::= "\"defaultConnection\"" space ":" space string
defaultConnection-rest ::= ( "," space provider-kv )? provider-rest
dtoSuffix-kv ::= "\"dtoSuffix\"" space ":" space string
generators ::= "[" space (generators-item ("," space generators-item)*)? space "]"
generators-item ::= ref-definitions-generator
generators-kv ::= "\"generators\"" space ":" space generators
generators-rest ::= ( "," space connectEditor2DB-kv )? connectEditor2DB-rest
helperAssemblies ::= "[" space (string ("," space string)*)? space "]"
helperAssemblies-kv ::= "\"helperAssemblies\"" space ":" space helperAssemblies
helperAssemblies-rest ::= ( "," space makeSelfTest-kv )? makeSelfTest-rest
makeSelfTest-kv ::= "\"makeSelfTest\"" space ":" space boolean
makeSelfTest-rest ::= ( "," space repoSuffix-kv )? repoSuffix-rest
provider ::= ("\"Microsoft.Data.SqlClient\"" | "\"MySql.Data.MySqlClient\"" | "\"Npgsql\"" | "\"System.Data.SqlClient\"")
provider-kv ::= "\"provider\"" space ":" space provider
provider-rest ::= ( "," space generators-kv )? generators-rest
ref-definitions-generator ::= "{" space ref-definitions-generator-name-kv ( "," space ( ref-definitions-generator-options-kv ) )? space "}"
ref-definitions-generator-name ::= ("\"CSharp\"" | "\"TsInterfaceFromDto\"")
ref-definitions-generator-name-kv ::= "\"name\"" space ":" space ref-definitions-generator-name
ref-definitions-generator-options ::= "{" space  (ref-definitions-generator-options-additional-kv ( "," space ref-definitions-generator-options-additional-kv )* )? space "}"
ref-definitions-generator-options-additional-kv ::= string ":" space string
ref-definitions-generator-options-kv ::= "\"options\"" space ":" space ref-definitions-generator-options
repoSuffix-kv ::= "\"repoSuffix\"" space ":" space string
repoSuffix-rest ::= ( "," space dtoSuffix-kv )?
root ::= "{" space  (defaultConnection-kv defaultConnection-rest | provider-kv provider-rest | generators-kv generators-rest | connectEditor2DB-kv connectEditor2DB-rest | helperAssemblies-kv helperAssemblies-rest | makeSelfTest-kv makeSelfTest-rest | repoSuffix-kv repoSuffix-rest | dtoSuffix-kv )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""

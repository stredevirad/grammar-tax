char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
invoice-number-kv ::= "\"invoice_number\"" space ":" space string
items ::= "[" space (items-item ("," space items-item)*)? space "]"
items-item ::= "{" space items-item-description-kv "," space items-item-quantity-kv "," space items-item-unit-price-kv space "}"
items-item-description-kv ::= "\"description\"" space ":" space string
items-item-quantity-kv ::= "\"quantity\"" space ":" space integer
items-item-unit-price-kv ::= "\"unit_price\"" space ":" space number
items-kv ::= "\"items\"" space ":" space items
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
root ::= "{" space invoice-number-kv "," space items-kv ( "," space ( tax-rate-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
tax-rate-kv ::= "\"tax_rate\"" space ":" space number

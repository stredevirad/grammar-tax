ref-definitions-webResponse-body-kv ::= "\"body\"" space ":" space ref-definitions-webResponse-body
ref-definitions-webResponse-body-rest ::= ( "," space ref-definitions-webResponse-noResponseReceived-kv )? ref-definitions-webResponse-noResponseReceived-rest
ref-definitions-webResponse-headers ::= "{" space  (ref-definitions-webResponse-headers-additional-kv ( "," space ref-definitions-webResponse-headers-additional-kv )* )? space "}"
ref-definitions-webResponse-headers-additional-kv ::= string ":" space string
ref-definitions-webResponse-headers-kv ::= "\"headers\"" space ":" space ref-definitions-webResponse-headers
ref-definitions-webResponse-headers-rest ::= ( "," space ref-definitions-webResponse-body-kv )? ref-definitions-webResponse-body-rest
ref-definitions-webResponse-index ::= ("-" ([0-1]) | [0] | [1-9] [0-9]{0,15})
ref-definitions-webResponse-index-kv ::= "\"index\"" space ":" space ref-definitions-webResponse-index
ref-definitions-webResponse-index-rest ::= ( "," space ref-definitions-webResponse-protocol-kv )? ref-definitions-webResponse-protocol-rest
ref-definitions-webResponse-noResponseReceived-kv ::= "\"noResponseReceived\"" space ":" space boolean
ref-definitions-webResponse-noResponseReceived-rest ::= ( "," space ref-definitions-webResponse-properties-kv )?
ref-definitions-webResponse-properties ::= ref-definitions-propertyBag
ref-definitions-webResponse-properties-kv ::= "\"properties\"" space ":" space ref-definitions-webResponse-properties
ref-definitions-webResponse-protocol-kv ::= "\"protocol\"" space ":" space string
ref-definitions-webResponse-protocol-rest ::= ( "," space ref-definitions-webResponse-version-kv )? ref-definitions-webResponse-version-rest
ref-definitions-webResponse-reasonPhrase-kv ::= "\"reasonPhrase\"" space ":" space string
ref-definitions-webResponse-reasonPhrase-rest ::= ( "," space ref-definitions-webResponse-headers-kv )? ref-definitions-webResponse-headers-rest
ref-definitions-webResponse-statusCode-kv ::= "\"statusCode\"" space ":" space integer
ref-definitions-webResponse-statusCode-rest ::= ( "," space ref-definitions-webResponse-reasonPhrase-kv )? ref-definitions-webResponse-reasonPhrase-rest
ref-definitions-webResponse-version-kv ::= "\"version\"" space ":" space string
ref-definitions-webResponse-version-rest ::= ( "," space ref-definitions-webResponse-statusCode-kv )? ref-definitions-webResponse-statusCode-rest
root ::= "{" space version-kv "," space runs-kv ( "," space ( -schema-kv -schema-rest | inlineExternalProperties-kv inlineExternalProperties-rest | properties-kv ) )? space "}"
runs ::= "[" space (runs-item ("," space runs-item)*)? space "]"
runs-item ::= ref-definitions-run
runs-kv ::= "\"runs\"" space ":" space runs
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
time ::= ([01] [0-9] | "2" [0-3]) ":" [0-5] [0-9] ":" [0-5] [0-9] ( "." [0-9]{3} )? ( "Z" | ( "+" | "-" ) ( [01] [0-9] | "2" [0-3] ) ":" [0-5] [0-9] )
uuid ::= "\"" [0-9a-fA-F]{8} "-" [0-9a-fA-F]{4} "-" [0-9a-fA-F]{4} "-" [0-9a-fA-F]{4} "-" [0-9a-fA-F]{12} "\""
value ::= object | array | string | number | boolean | null
version ::= ("\"2.1.0\"")
version-kv ::= "\"version\"" space ":" space version

additional-k ::= ["] ( [b] ([r] ([o] ([w] ([s] ([e] ([r] ([V] ([e] ([r] ([s] ([i] ([o] ([n] char+ | [^"n] char*) | [^"o] char*) | [^"i] char*) | [^"s] char*) | [^"r] char*) | [^"e] char*) | [^"V] char*) | [^"r] char*) | [^"e] char*) | [^"s] char*) | [^"w] char*) | [^"o] char*) | [^"r] char*) | [d] ([e] ([v] ([i] ([c] ([e] ([T] ([y] ([p] ([e] char+ | [^"e] char*) | [^"p] char*) | [^"y] char*) | [^"T] char*) | [^"e] char*) | [^"c] char*) | [^"i] char*) | [^"v] char*) | [^"e] char*) | [i] ([p] char+ | [^"p] char*) | [l] ([o] ([c] ([a] ([t] ([i] ([o] ([n] ([C] ([i] ([t] ([y] char+ | [^"y] char*) | [^"t] char*) | [o] ([u] ([n] ([t] ([r] ([y] char+ | [^"y] char*) | [^"r] char*) | [^"t] char*) | [^"n] char*) | [^"u] char*) | [^"io] char*) | [R] ([e] ([g] ([i] ([o] ([n] char+ | [^"n] char*) | [^"o] char*) | [^"i] char*) | [^"g] char*) | [^"e] char*) | [^"CR] char*) | [^"n] char*) | [^"o] char*) | [^"i] char*) | [^"t] char*) | [^"a] char*) | [^"c] char*) | [^"o] char*) | [m] ([o] ([b] ([i] ([l] ([e] ([I] ([d] char+ | [^"d] char*) | [^"I] char*) | [^"e] char*) | [^"l] char*) | [^"i] char*) | [^"b] char*) | [^"o] char*) | [o] ([s] char+ | [^"s] char*) | [p] ([l] ([a] ([t] ([f] ([o] ([r] ([m] ([I] ([d] char+ | [^"d] char*) | [V] ([e] ([r] ([s] ([i] ([o] ([n] char+ | [^"n] char*) | [^"o] char*) | [^"i] char*) | [^"s] char*) | [^"r] char*) | [^"e] char*) | [^"IV] char*) | [^"m] char*) | [^"r] char*) | [^"o] char*) | [^"f] char*) | [^"t] char*) | [^"a] char*) | [^"l] char*) | [r] ([e] ([f] ([e] ([r] ([r] ([e] ([r] char+ | [^"r] char*) | [^"e] char*) | [^"r] char*) | [^"r] char*) | [^"e] char*) | [^"f] char*) | [^"e] char*) | [^"bdilmopr] char* )? ["]
additional-kv ::= additional-k ":" space value
array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
browser ::= string | null
browser-kv ::= "\"browser\"" space ":" space browser
browser-rest ::= ( "," space browserVersion-kv )? browserVersion-rest
browserVersion ::= string | null
browserVersion-kv ::= "\"browserVersion\"" space ":" space browserVersion
browserVersion-rest ::= ( "," space device-kv )? device-rest
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
device ::= string | null
device-kv ::= "\"device\"" space ":" space device
device-rest ::= ( "," space deviceType-kv )? deviceType-rest
deviceType ::= string | null
deviceType-kv ::= "\"deviceType\"" space ":" space deviceType
deviceType-rest ::= ( "," space ip-kv )? ip-rest
integral-part ::= [0] | [1-9] [0-9]{0,15}
ip ::= string | null
ip-kv ::= "\"ip\"" space ":" space ip
ip-rest ::= ( "," space locationCity-kv )? locationCity-rest
locationCity ::= string | null
locationCity-kv ::= "\"locationCity\"" space ":" space locationCity
locationCity-rest ::= ( "," space locationCountry-kv )? locationCountry-rest
locationCountry ::= string | null
locationCountry-kv ::= "\"locationCountry\"" space ":" space locationCountry
locationCountry-rest ::= ( "," space locationRegion-kv )? locationRegion-rest
locationRegion ::= string | null
locationRegion-kv ::= "\"locationRegion\"" space ":" space locationRegion
locationRegion-rest ::= ( "," space mobile-kv )? mobile-rest
mobile ::= boolean | null
mobile-kv ::= "\"mobile\"" space ":" space mobile
mobile-rest ::= ( "," space mobileId-kv )? mobileId-rest
mobileId ::= string | null
mobileId-kv ::= "\"mobileId\"" space ":" space mobileId
mobileId-rest ::= ( "," space os-kv )? os-rest
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
os ::= string | null
os-kv ::= "\"os\"" space ":" space os
os-rest ::= ( "," space platformId-kv )? platformId-rest
platformId ::= string | null
platformId-kv ::= "\"platformId\"" space ":" space platformId
platformId-rest ::= ( "," space platformVersion-kv )? platformVersion-rest
platformVersion ::= string | null
platformVersion-kv ::= "\"platformVersion\"" space ":" space platformVersion
platformVersion-rest ::= ( "," space referrer-kv )? referrer-rest
referrer ::= string | null
referrer-kv ::= "\"referrer\"" space ":" space referrer
referrer-rest ::= ( "," space additional-kv )*
root ::= "{" space  (browser-kv browser-rest | browserVersion-kv browserVersion-rest | device-kv device-rest | deviceType-kv deviceType-rest | ip-kv ip-rest | locationCity-kv locationCity-rest | locationCountry-kv locationCountry-rest | locationRegion-kv locationRegion-rest | mobile-kv mobile-rest | mobileId-kv mobileId-rest | os-kv os-rest | platformId-kv platformId-rest | platformVersion-kv platformVersion-rest | referrer-kv referrer-rest | additional-kv ( "," space additional-kv )* )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
value ::= object | array | string | number | boolean | null

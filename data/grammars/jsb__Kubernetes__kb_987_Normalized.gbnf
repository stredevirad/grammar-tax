char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
name ::= string | null
name-kv ::= "\"name\"" space ":" space name
name-rest ::= ( "," space namespace-kv )? namespace-rest
namespace ::= string | null
namespace-kv ::= "\"namespace\"" space ":" space namespace
namespace-rest ::= ( "," space port-kv )?
null ::= "null"
port ::= integer | null
port-kv ::= "\"port\"" space ":" space port
root ::= "{" space  (name-kv name-rest | namespace-kv namespace-rest | port-kv )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""

boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
config ::= "{" space config-save-on-error-kv "," space config-dry-run-kv "," space config-fMRIName-kv "," space config-BiasCorrection-kv "," space config-MotionCorrection-kv "," space config-AnatomyRegDOF-kv "," space config-RegName-kv ( "," space ( config-FREESURFER-LICENSE-kv ) )? space "}"
config-AnatomyRegDOF ::= ("6" | "12")
config-AnatomyRegDOF-kv ::= "\"AnatomyRegDOF\"" space ":" space config-AnatomyRegDOF
config-BiasCorrection ::= ("\"NONE\"" | "\"SEBased\"" | "\"Legacy\"")
config-BiasCorrection-kv ::= "\"BiasCorrection\"" space ":" space config-BiasCorrection
config-FREESURFER-LICENSE-kv ::= "\"FREESURFER_LICENSE\"" space ":" space string
config-MotionCorrection ::= ("\"MCFLIRT\"" | "\"FLIRT\"")
config-MotionCorrection-kv ::= "\"MotionCorrection\"" space ":" space config-MotionCorrection
config-RegName ::= ("\"Empty\"" | "\"FS\"" | "\"MSMSulc\"")
config-RegName-kv ::= "\"RegName\"" space ":" space config-RegName
config-dry-run-kv ::= "\"dry-run\"" space ":" space boolean
config-fMRIName ::= ("\"rfMRI_REST1_RL\"" | "\"rfMRI_REST1_LR\"" | "\"rfMRI_REST2_RL\"" | "\"rfMRI_REST2_LR\"" | "\"tfMRI_WM_RL\"" | "\"tfMRI_WM_LR\"" | "\"tfMRI_GAMBLING_RL\"" | "\"tfMRI_GAMBLING_LR\"" | "\"tfMRI_MOTOR_RL\"" | "\"tfMRI_MOTOR_LR\"" | "\"tfMRI_LANGUAGE_RL\"" | "\"tfMRI_LANGUAGE_LR\"" | "\"tfMRI_SOCIAL_RL\"" | "\"tfMRI_SOCIAL_LR\"" | "\"tfMRI_RELATIONAL_RL\"" | "\"tfMRI_RELATIONAL_LR\"" | "\"tfMRI_EMOTION_RL\"" | "\"tfMRI_EMOTION_LR\"")
config-fMRIName-kv ::= "\"fMRIName\"" space ":" space config-fMRIName
config-kv ::= "\"config\"" space ":" space config
config-save-on-error-kv ::= "\"save-on-error\"" space ":" space boolean
inputs ::= "{" space inputs-StructZip-kv "," space inputs-fMRITimeSeries-kv ( "," space ( inputs-fMRIScout-kv inputs-fMRIScout-rest | inputs-GradientCoeff-kv inputs-GradientCoeff-rest | inputs-SpinEchoPositive-kv inputs-SpinEchoPositive-rest | inputs-SpinEchoNegative-kv inputs-SpinEchoNegative-rest | inputs-SiemensGREMagnitude-kv inputs-SiemensGREMagnitude-rest | inputs-SiemensGREPhase-kv inputs-SiemensGREPhase-rest | inputs-FreeSurferLicense-kv ) )? space "}"
inputs-FreeSurferLicense ::= "{" space "}"
inputs-FreeSurferLicense-kv ::= "\"FreeSurferLicense\"" space ":" space inputs-FreeSurferLicense
inputs-GradientCoeff ::= "{" space "}"
inputs-GradientCoeff-kv ::= "\"GradientCoeff\"" space ":" space inputs-GradientCoeff
inputs-GradientCoeff-rest ::= ( "," space inputs-SpinEchoPositive-kv )? inputs-SpinEchoPositive-rest
inputs-SiemensGREMagnitude ::= "{" space  (inputs-SiemensGREMagnitude-type-kv )? space "}"
inputs-SiemensGREMagnitude-kv ::= "\"SiemensGREMagnitude\"" space ":" space inputs-SiemensGREMagnitude
inputs-SiemensGREMagnitude-rest ::= ( "," space inputs-SiemensGREPhase-kv )? inputs-SiemensGREPhase-rest
inputs-SiemensGREMagnitude-type ::= ("\"nifti\"")
inputs-SiemensGREMagnitude-type-kv ::= "\"type\"" space ":" space inputs-SiemensGREMagnitude-type
inputs-SiemensGREPhase ::= "{" space  (inputs-SiemensGREPhase-type-kv )? space "}"
inputs-SiemensGREPhase-kv ::= "\"SiemensGREPhase\"" space ":" space inputs-SiemensGREPhase
inputs-SiemensGREPhase-rest ::= ( "," space inputs-FreeSurferLicense-kv )?
inputs-SiemensGREPhase-type ::= ("\"nifti\"")
inputs-SiemensGREPhase-type-kv ::= "\"type\"" space ":" space inputs-SiemensGREPhase-type
inputs-SpinEchoNegative ::= "{" space  (inputs-SpinEchoNegative-type-kv )? space "}"
inputs-SpinEchoNegative-kv ::= "\"SpinEchoNegative\"" space ":" space inputs-SpinEchoNegative
inputs-SpinEchoNegative-rest ::= ( "," space inputs-SiemensGREMagnitude-kv )? inputs-SiemensGREMagnitude-rest
inputs-SpinEchoNegative-type ::= ("\"nifti\"")
inputs-SpinEchoNegative-type-kv ::= "\"type\"" space ":" space inputs-SpinEchoNegative-type
inputs-SpinEchoPositive ::= "{" space  (inputs-SpinEchoPositive-type-kv )? space "}"
inputs-SpinEchoPositive-kv ::= "\"SpinEchoPositive\"" space ":" space inputs-SpinEchoPositive
inputs-SpinEchoPositive-rest ::= ( "," space inputs-SpinEchoNegative-kv )? inputs-SpinEchoNegative-rest
inputs-SpinEchoPositive-type ::= ("\"nifti\"")
inputs-SpinEchoPositive-type-kv ::= "\"type\"" space ":" space inputs-SpinEchoPositive-type
inputs-StructZip ::= "{" space  (inputs-StructZip-type-kv )? space "}"
inputs-StructZip-kv ::= "\"StructZip\"" space ":" space inputs-StructZip
inputs-StructZip-type ::= ("\"archive\"")
inputs-StructZip-type-kv ::= "\"type\"" space ":" space inputs-StructZip-type
inputs-fMRIScout ::= "{" space  (inputs-fMRIScout-type-kv )? space "}"
inputs-fMRIScout-kv ::= "\"fMRIScout\"" space ":" space inputs-fMRIScout
inputs-fMRIScout-rest ::= ( "," space inputs-GradientCoeff-kv )? inputs-GradientCoeff-rest
inputs-fMRIScout-type ::= ("\"nifti\"")
inputs-fMRIScout-type-kv ::= "\"type\"" space ":" space inputs-fMRIScout-type
inputs-fMRITimeSeries ::= "{" space  (inputs-fMRITimeSeries-type-kv )? space "}"
inputs-fMRITimeSeries-kv ::= "\"fMRITimeSeries\"" space ":" space inputs-fMRITimeSeries
inputs-fMRITimeSeries-type ::= ("\"nifti\"")
inputs-fMRITimeSeries-type-kv ::= "\"type\"" space ":" space inputs-fMRITimeSeries-type
inputs-kv ::= "\"inputs\"" space ":" space inputs
root ::= "{" space config-kv "," space inputs-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""

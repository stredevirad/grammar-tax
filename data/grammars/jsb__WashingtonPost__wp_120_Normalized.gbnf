-id-kv ::= "\"_id\"" space ":" space string
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
name-kv ::= "\"name\"" space ":" space string
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
root ::= "{" space -id-kv "," space score-kv "," space uid-kv ( "," space ( name-kv ) )? space "}"
score-kv ::= "\"score\"" space ":" space number
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
uid-kv ::= "\"uid\"" space ":" space string

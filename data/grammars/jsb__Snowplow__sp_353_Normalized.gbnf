boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
enabled-kv ::= "\"enabled\"" space ":" space boolean
name-kv ::= "\"name\"" space ":" space string
parameters ::= "{" space parameters-cache-kv "," space parameters-database-kv "," space parameters-inputs-kv "," space parameters-output-kv "," space parameters-query-kv space "}"
parameters-cache ::= "{" space parameters-cache-size-kv "," space parameters-cache-ttl-kv space "}"
parameters-cache-kv ::= "\"cache\"" space ":" space parameters-cache
parameters-cache-size ::= ([0] | [1-9] [0-9]{0,15})
parameters-cache-size-kv ::= "\"size\"" space ":" space parameters-cache-size
parameters-cache-ttl ::= ([0-9] | ([1-8] [0-9] | [9] [0-9]) | ([1-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])) | ([1-8] [0-9]{3} | [9] ([0-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9]))) | ([1-7] [0-9]{4} | [8] ([0-5] [0-9]{3} | [6] ([0-3] [0-9]{2} | [4] "00"))))
parameters-cache-ttl-kv ::= "\"ttl\"" space ":" space parameters-cache-ttl
parameters-database ::= parameters-database-0 | parameters-database-1
parameters-database-0 ::= "{" space parameters-database-0-postgresql-kv space "}"
parameters-database-0-postgresql ::= "{" space parameters-database-0-postgresql-database-kv "," space parameters-database-0-postgresql-host-kv "," space parameters-database-0-postgresql-password-kv "," space parameters-database-0-postgresql-port-kv "," space parameters-database-0-postgresql-sslMode-kv "," space parameters-database-0-postgresql-username-kv space "}"
parameters-database-0-postgresql-database ::= "\"" char+ "\""
parameters-database-0-postgresql-database-kv ::= "\"database\"" space ":" space parameters-database-0-postgresql-database
parameters-database-0-postgresql-host-kv ::= "\"host\"" space ":" space string
parameters-database-0-postgresql-kv ::= "\"postgresql\"" space ":" space parameters-database-0-postgresql
parameters-database-0-postgresql-password-kv ::= "\"password\"" space ":" space string
parameters-database-0-postgresql-port ::= ([1-9] | ([1-8] [0-9] | [9] [0-9]) | ([1-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])) | ([1-8] [0-9]{3} | [9] ([0-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9]))) | ([1-5] [0-9]{4} | [6] ([0-4] [0-9]{3} | [5] ([0-4] [0-9]{2} | [5] ([0-2] [0-9] | [3] [0-5])))))
parameters-database-0-postgresql-port-kv ::= "\"port\"" space ":" space parameters-database-0-postgresql-port
parameters-database-0-postgresql-sslMode-kv ::= "\"sslMode\"" space ":" space boolean
parameters-database-0-postgresql-username ::= "\"" char+ "\""
parameters-database-0-postgresql-username-kv ::= "\"username\"" space ":" space parameters-database-0-postgresql-username
parameters-database-1 ::= "{" space parameters-database-1-mysql-kv space "}"
parameters-database-1-mysql ::= "{" space parameters-database-1-mysql-database-kv "," space parameters-database-1-mysql-host-kv "," space parameters-database-1-mysql-password-kv "," space parameters-database-1-mysql-port-kv "," space parameters-database-1-mysql-sslMode-kv "," space parameters-database-1-mysql-username-kv space "}"
parameters-database-1-mysql-database ::= "\"" char+ "\""
parameters-database-1-mysql-database-kv ::= "\"database\"" space ":" space parameters-database-1-mysql-database
parameters-database-1-mysql-host-kv ::= "\"host\"" space ":" space string
parameters-database-1-mysql-kv ::= "\"mysql\"" space ":" space parameters-database-1-mysql
parameters-database-1-mysql-password-kv ::= "\"password\"" space ":" space string
parameters-database-1-mysql-port ::= ([1-9] | ([1-8] [0-9] | [9] [0-9]) | ([1-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])) | ([1-8] [0-9]{3} | [9] ([0-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9]))) | ([1-5] [0-9]{4} | [6] ([0-4] [0-9]{3} | [5] ([0-4] [0-9]{2} | [5] ([0-2] [0-9] | [3] [0-5])))))
parameters-database-1-mysql-port-kv ::= "\"port\"" space ":" space parameters-database-1-mysql-port
parameters-database-1-mysql-sslMode-kv ::= "\"sslMode\"" space ":" space boolean
parameters-database-1-mysql-username ::= "\"" char+ "\""
parameters-database-1-mysql-username-kv ::= "\"username\"" space ":" space parameters-database-1-mysql-username
parameters-database-kv ::= "\"database\"" space ":" space parameters-database
parameters-inputs ::= "[" space (parameters-inputs-item ("," space parameters-inputs-item)*)? space "]"
parameters-inputs-item ::= "{" space parameters-inputs-item-placeholder-kv ( "," space ( parameters-inputs-item-json-kv parameters-inputs-item-json-rest | parameters-inputs-item-pojo-kv ) )? space "}"
parameters-inputs-item-json ::= "{" space parameters-inputs-item-json-field-kv "," space parameters-inputs-item-json-jsonPath-kv "," space parameters-inputs-item-json-schemaCriterion-kv space "}"
parameters-inputs-item-json-field ::= ("\"unstruct_event\"" | "\"contexts\"" | "\"derived_contexts\"")
parameters-inputs-item-json-field-kv ::= "\"field\"" space ":" space parameters-inputs-item-json-field
parameters-inputs-item-json-jsonPath-kv ::= "\"jsonPath\"" space ":" space string
parameters-inputs-item-json-kv ::= "\"json\"" space ":" space parameters-inputs-item-json
parameters-inputs-item-json-rest ::= ( "," space parameters-inputs-item-pojo-kv )?
parameters-inputs-item-json-schemaCriterion ::= "\"" ("iglu:" ([a-zA-Z0-9-_.]+) "/" ([a-zA-Z0-9-_]+) "/" ([a-zA-Z0-9-_]+) "/" ([1-9] [0-9]* | "*") "-" (("0" | [1-9] [0-9]*) | "*") "-" (("0" | [1-9] [0-9]*) | "*")) "\""
parameters-inputs-item-json-schemaCriterion-kv ::= "\"schemaCriterion\"" space ":" space parameters-inputs-item-json-schemaCriterion
parameters-inputs-item-placeholder ::= ([1-9] | ([1-5] [0-9] | [6] [0-4]))
parameters-inputs-item-placeholder-kv ::= "\"placeholder\"" space ":" space parameters-inputs-item-placeholder
parameters-inputs-item-pojo ::= "{" space parameters-inputs-item-pojo-field-kv space "}"
parameters-inputs-item-pojo-field-kv ::= "\"field\"" space ":" space string
parameters-inputs-item-pojo-kv ::= "\"pojo\"" space ":" space parameters-inputs-item-pojo
parameters-inputs-kv ::= "\"inputs\"" space ":" space parameters-inputs
parameters-kv ::= "\"parameters\"" space ":" space parameters
parameters-output ::= "{" space  (parameters-output-expectedRows-kv parameters-output-expectedRows-rest | parameters-output-json-kv )? space "}"
parameters-output-expectedRows ::= ("\"AT_LEAST_ONE\"" | "\"AT_LEAST_ZERO\"" | "\"AT_MOST_ONE\"" | "\"EXACTLY_ONE\"")
parameters-output-expectedRows-kv ::= "\"expectedRows\"" space ":" space parameters-output-expectedRows
parameters-output-expectedRows-rest ::= ( "," space parameters-output-json-kv )?
parameters-output-json ::= "{" space parameters-output-json-describes-kv "," space parameters-output-json-propertyNames-kv "," space parameters-output-json-schema-kv space "}"
parameters-output-json-describes ::= ("\"ALL_ROWS\"" | "\"EVERY_ROW\"")
parameters-output-json-describes-kv ::= "\"describes\"" space ":" space parameters-output-json-describes
parameters-output-json-kv ::= "\"json\"" space ":" space parameters-output-json
parameters-output-json-propertyNames ::= ("\"AS_IS\"" | "\"CAMEL_CASE\"" | "\"PASCAL_CASE\"" | "\"SNAKE_CASE\"" | "\"LOWER_CASE\"" | "\"UPPER_CASE\"")
parameters-output-json-propertyNames-kv ::= "\"propertyNames\"" space ":" space parameters-output-json-propertyNames
parameters-output-json-schema ::= "\"" ("iglu:" ([a-zA-Z0-9-_.]+) "/" ([a-zA-Z0-9-_]+) "/" ([a-zA-Z0-9-_]+) "/" ([1-9] [0-9]* parameters-output-json-schema-1{2,2})) "\""
parameters-output-json-schema-1 ::= ("-" ("0" | [1-9] [0-9]*))
parameters-output-json-schema-kv ::= "\"schema\"" space ":" space parameters-output-json-schema
parameters-output-kv ::= "\"output\"" space ":" space parameters-output
parameters-query ::= "{" space parameters-query-sql-kv space "}"
parameters-query-kv ::= "\"query\"" space ":" space parameters-query
parameters-query-sql-kv ::= "\"sql\"" space ":" space string
root ::= "{" space enabled-kv "," space name-kv "," space parameters-kv "," space vendor-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
vendor-kv ::= "\"vendor\"" space ":" space string

actions ::= "[" space (string ("," space string)*)? space "]"
actions-kv ::= "\"actions\"" space ":" space actions
channel-kv ::= "\"channel\"" space ":" space string
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
command-kv ::= "\"command\"" space ":" space string
root ::= "{" space actions-kv "," space channel-kv "," space command-kv "," space tags-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
tags ::= "[" space (string ("," space string)*)? space "]"
tags-kv ::= "\"tags\"" space ":" space tags

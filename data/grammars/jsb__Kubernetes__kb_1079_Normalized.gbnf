char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
effect ::= string | null
effect-kv ::= "\"effect\"" space ":" space effect
effect-rest ::= ( "," space key-kv )? key-rest
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
key ::= string | null
key-kv ::= "\"key\"" space ":" space key
key-rest ::= ( "," space operator-kv )? operator-rest
null ::= "null"
operator ::= string | null
operator-kv ::= "\"operator\"" space ":" space operator
operator-rest ::= ( "," space tolerationSeconds-kv )? tolerationSeconds-rest
root ::= "{" space  (effect-kv effect-rest | key-kv key-rest | operator-kv operator-rest | tolerationSeconds-kv tolerationSeconds-rest | value-kv )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
tolerationSeconds ::= integer | null
tolerationSeconds-kv ::= "\"tolerationSeconds\"" space ":" space tolerationSeconds
tolerationSeconds-rest ::= ( "," space value-kv )?
value- ::= string | null
value-kv ::= "\"value\"" space ":" space value-

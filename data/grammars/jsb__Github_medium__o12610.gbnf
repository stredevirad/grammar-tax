boolean ::= ("true" | "false")
channel ::= ([1-9] | ([1-8] [0-9] | [9] [0-9]) | "1" ([0-5] [0-9] | [6] [0-5]))
channel-kv ::= "\"channel\"" space ":" space channel
channel-rest ::= ( "," space htmode-kv )? htmode-rest
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
htmode ::= ("null" | "\"HT20\"" | "\"HT40+\"" | "\"HT40-\"" | "\"VHT20\"" | "\"VHT40\"" | "\"VHT80\"")
htmode-kv ::= "\"htmode\"" space ":" space htmode
htmode-rest ::= ( "," space hwmode-kv )? hwmode-rest
hwmode ::= ("\"11b\"" | "\"11g\"" | "\"11a\"")
hwmode-kv ::= "\"hwmode\"" space ":" space hwmode
hwmode-rest ::= ( "," space id-kv )? id-rest
id-kv ::= "\"id\"" space ":" space string
id-rest ::= ( "," space rx-stbc-kv )? rx-stbc-rest
root ::= "{" space  (channel-kv channel-rest | htmode-kv htmode-rest | hwmode-kv hwmode-rest | id-kv id-rest | rx-stbc-kv rx-stbc-rest | short-gi-20-kv short-gi-20-rest | short-gi-40-kv short-gi-40-rest | short-gi-80-kv short-gi-80-rest | tx-stbc-kv )? space "}"
rx-stbc ::= ([0-1])
rx-stbc-kv ::= "\"rx_stbc\"" space ":" space rx-stbc
rx-stbc-rest ::= ( "," space short-gi-20-kv )? short-gi-20-rest
short-gi-20-kv ::= "\"short_gi_20\"" space ":" space boolean
short-gi-20-rest ::= ( "," space short-gi-40-kv )? short-gi-40-rest
short-gi-40-kv ::= "\"short_gi_40\"" space ":" space boolean
short-gi-40-rest ::= ( "," space short-gi-80-kv )? short-gi-80-rest
short-gi-80-kv ::= "\"short_gi_80\"" space ":" space boolean
short-gi-80-rest ::= ( "," space tx-stbc-kv )?
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
tx-stbc ::= ([0-1])
tx-stbc-kv ::= "\"tx_stbc\"" space ":" space tx-stbc

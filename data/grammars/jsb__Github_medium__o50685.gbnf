actions ::= "{" space  (actions-create-kv actions-create-rest | actions-read-one-kv actions-read-one-rest | actions-read-many-kv actions-read-many-rest | actions-update-kv actions-update-rest | actions-delete-kv )? space "}"
actions-create-kv ::= "\"create\"" space ":" space boolean
actions-create-rest ::= ( "," space actions-read-one-kv )? actions-read-one-rest
actions-delete-kv ::= "\"delete\"" space ":" space boolean
actions-kv ::= "\"actions\"" space ":" space actions
actions-read-many-kv ::= "\"read_many\"" space ":" space boolean
actions-read-many-rest ::= ( "," space actions-update-kv )? actions-update-rest
actions-read-one-kv ::= "\"read_one\"" space ":" space boolean
actions-read-one-rest ::= ( "," space actions-read-many-kv )? actions-read-many-rest
actions-rest ::= ( "," space pagination-kv )? pagination-rest
actions-update-kv ::= "\"update\"" space ":" space boolean
actions-update-rest ::= ( "," space actions-delete-kv )?
array ::= "[" space ( value ("," space value)* )? space "]"
attributes ::= object
attributes-kv ::= "\"attributes\"" space ":" space attributes
attributes-rest ::= ( "," space meta-kv )? meta-rest
boolean ::= ("true" | "false")
built-in-meta ::= "{" space  (built-in-meta-created-at-kv built-in-meta-created-at-rest | built-in-meta-updated-at-kv )? space "}"
built-in-meta-created-at-kv ::= "\"created_at\"" space ":" space boolean
built-in-meta-created-at-rest ::= ( "," space built-in-meta-updated-at-kv )?
built-in-meta-kv ::= "\"built_in_meta\"" space ":" space built-in-meta
built-in-meta-updated-at-kv ::= "\"updated_at\"" space ":" space boolean
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
meta ::= object
meta-kv ::= "\"meta\"" space ":" space meta
meta-rest ::= ( "," space relationships-kv )? relationships-rest
name-kv ::= "\"name\"" space ":" space string
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
pagination ::= pagination-0 | boolean
pagination-0 ::= "{" space  (pagination-0-default-page-size-kv pagination-0-default-page-size-rest | pagination-0-default-page-number-kv pagination-0-default-page-number-rest | pagination-0-enabled-kv )? space "}"
pagination-0-default-page-number ::= ([0] | [1-9] [0-9]{0,15})
pagination-0-default-page-number-kv ::= "\"default_page_number\"" space ":" space pagination-0-default-page-number
pagination-0-default-page-number-rest ::= ( "," space pagination-0-enabled-kv )?
pagination-0-default-page-size ::= ([1-9] [0-9]{0,15})
pagination-0-default-page-size-kv ::= "\"default_page_size\"" space ":" space pagination-0-default-page-size
pagination-0-default-page-size-rest ::= ( "," space pagination-0-default-page-number-kv )? pagination-0-default-page-number-rest
pagination-0-enabled-kv ::= "\"enabled\"" space ":" space boolean
pagination-kv ::= "\"pagination\"" space ":" space pagination
pagination-rest ::= ( "," space attributes-kv )? attributes-rest
plural-form-kv ::= "\"plural_form\"" space ":" space string
plural-form-rest ::= ( "," space actions-kv )? actions-rest
relationships ::= object
relationships-kv ::= "\"relationships\"" space ":" space relationships
relationships-rest ::= ( "," space built-in-meta-kv )?
root ::= "{" space name-kv ( "," space ( plural-form-kv plural-form-rest | actions-kv actions-rest | pagination-kv pagination-rest | attributes-kv attributes-rest | meta-kv meta-rest | relationships-kv relationships-rest | built-in-meta-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
value ::= object | array | string | number | boolean | null

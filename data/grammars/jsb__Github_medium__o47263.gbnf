char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
item ::= "{" space item-Sample-ID-kv "," space item-Sample-Name-kv "," space item-Sample-Project-kv "," space item-I7-Index-ID-kv "," space item-index-kv ( "," space ( item-Lane-kv item-Lane-rest | item-I5-Index-ID-kv item-I5-Index-ID-rest | item-index2-kv item-index2-rest | item-Sample-Plate-kv item-Sample-Plate-rest | item-Sample-Well-kv item-Sample-Well-rest | item-Description-kv ) )? space "}"
item-Description ::= string
item-Description-kv ::= "\"Description\"" space ":" space item-Description
item-I5-Index-ID-kv ::= "\"I5_Index_ID\"" space ":" space string
item-I5-Index-ID-rest ::= ( "," space item-index2-kv )? item-index2-rest
item-I7-Index-ID-kv ::= "\"I7_Index_ID\"" space ":" space string
item-Lane ::= ("\"1\"" | "\"2\"" | "\"3\"" | "\"4\"" | "\"5\"" | "\"6\"" | "\"7\"" | "\"8\"")
item-Lane-kv ::= "\"Lane\"" space ":" space item-Lane
item-Lane-rest ::= ( "," space item-I5-Index-ID-kv )? item-I5-Index-ID-rest
item-Sample-ID ::= "\"" ("IGF" [a-zA-Z0-9-_]+) "\""
item-Sample-ID-kv ::= "\"Sample_ID\"" space ":" space item-Sample-ID
item-Sample-Name ::= "\"" ([a-zA-Z0-9-]+) "\""
item-Sample-Name-kv ::= "\"Sample_Name\"" space ":" space item-Sample-Name
item-Sample-Plate-kv ::= "\"Sample_Plate\"" space ":" space string
item-Sample-Plate-rest ::= ( "," space item-Sample-Well-kv )? item-Sample-Well-rest
item-Sample-Project ::= "\"" ("IGF" [a-zA-Z0-9-_]+) "\""
item-Sample-Project-kv ::= "\"Sample_Project\"" space ":" space item-Sample-Project
item-Sample-Well-kv ::= "\"Sample_Well\"" space ":" space string
item-Sample-Well-rest ::= ( "," space item-Description-kv )?
item-index ::= string
item-index-kv ::= "\"index\"" space ":" space item-index
item-index2 ::= string
item-index2-kv ::= "\"index2\"" space ":" space item-index2
item-index2-rest ::= ( "," space item-Sample-Plate-kv )? item-Sample-Plate-rest
root ::= "[" space item ("," space item)* space "]"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""

char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
checksum-kv ::= "\"checksum\"" space ":" space string
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
recordType-kv ::= "\"recordType\"" space ":" space string
root ::= "{" space url-kv "," space checksum-kv "," space size-kv "," space version-kv "," space recordType-kv space "}"
size-kv ::= "\"size\"" space ":" space number
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
url-kv ::= "\"url\"" space ":" space string
version-kv ::= "\"version\"" space ":" space string

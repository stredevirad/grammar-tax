char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
filters-kv ::= "\"filters\"" space ":" space string
filters-rest ::= ( "," space ids-kv )?
ids ::= "\"" ([a-z0-9:]+) "\""
ids-kv ::= "\"ids\"" space ":" space ids
metrics-kv ::= "\"metrics\"" space ":" space string
root ::= "{" space metrics-kv ( "," space ( filters-kv filters-rest | ids-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""

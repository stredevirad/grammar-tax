char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
descriptions ::= ref-definitions-translations
descriptions-kv ::= "\"descriptions\"" space ":" space descriptions
index-number ::= ([1-9] [0-9]{0,15})
index-number-kv ::= "\"index_number\"" space ":" space index-number
names ::= ref-definitions-translations
names-kv ::= "\"names\"" space ":" space names
ref-definitions-translations ::= "{" space ref-definitions-translations-de-kv "," space ref-definitions-translations-en-kv ( "," space ( ref-definitions-translations-cz-kv ref-definitions-translations-cz-rest | ref-definitions-translations-dk-kv ref-definitions-translations-dk-rest | ref-definitions-translations-fr-kv ref-definitions-translations-fr-rest | ref-definitions-translations-gr-kv ref-definitions-translations-gr-rest | ref-definitions-translations-it-kv ref-definitions-translations-it-rest | ref-definitions-translations-pl-kv ref-definitions-translations-pl-rest | ref-definitions-translations-tr-kv ref-definitions-translations-tr-rest | ref-definitions-translations-jp-kv ref-definitions-translations-jp-rest | ref-definitions-translations-es-kv ) )? space "}"
ref-definitions-translations-cz-kv ::= "\"cz\"" space ":" space string
ref-definitions-translations-cz-rest ::= ( "," space ref-definitions-translations-dk-kv )? ref-definitions-translations-dk-rest
ref-definitions-translations-de-kv ::= "\"de\"" space ":" space string
ref-definitions-translations-dk-kv ::= "\"dk\"" space ":" space string
ref-definitions-translations-dk-rest ::= ( "," space ref-definitions-translations-fr-kv )? ref-definitions-translations-fr-rest
ref-definitions-translations-en-kv ::= "\"en\"" space ":" space string
ref-definitions-translations-es-kv ::= "\"es\"" space ":" space string
ref-definitions-translations-fr-kv ::= "\"fr\"" space ":" space string
ref-definitions-translations-fr-rest ::= ( "," space ref-definitions-translations-gr-kv )? ref-definitions-translations-gr-rest
ref-definitions-translations-gr-kv ::= "\"gr\"" space ":" space string
ref-definitions-translations-gr-rest ::= ( "," space ref-definitions-translations-it-kv )? ref-definitions-translations-it-rest
ref-definitions-translations-it-kv ::= "\"it\"" space ":" space string
ref-definitions-translations-it-rest ::= ( "," space ref-definitions-translations-pl-kv )? ref-definitions-translations-pl-rest
ref-definitions-translations-jp-kv ::= "\"jp\"" space ":" space string
ref-definitions-translations-jp-rest ::= ( "," space ref-definitions-translations-es-kv )?
ref-definitions-translations-pl-kv ::= "\"pl\"" space ":" space string
ref-definitions-translations-pl-rest ::= ( "," space ref-definitions-translations-tr-kv )? ref-definitions-translations-tr-rest
ref-definitions-translations-tr-kv ::= "\"tr\"" space ":" space string
ref-definitions-translations-tr-rest ::= ( "," space ref-definitions-translations-jp-kv )? ref-definitions-translations-jp-rest
root ::= "{" space index-number-kv "," space names-kv "," space descriptions-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""

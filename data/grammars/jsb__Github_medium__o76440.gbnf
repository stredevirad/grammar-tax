-debug ::= "{" space  (-debug-crawlLog-kv -debug-crawlLog-rest | -debug-chromeDriverLog-kv -debug-chromeDriverLog-rest | -debug-screenshot-kv )? space "}"
-debug-chromeDriverLog ::= "\"" char{1,512} "\""
-debug-chromeDriverLog-kv ::= "\"chromeDriverLog\"" space ":" space -debug-chromeDriverLog
-debug-chromeDriverLog-rest ::= ( "," space -debug-screenshot-kv )?
-debug-crawlLog ::= "\"" char{1,512} "\""
-debug-crawlLog-kv ::= "\"crawlLog\"" space ":" space -debug-crawlLog
-debug-crawlLog-rest ::= ( "," space -debug-chromeDriverLog-kv )? -debug-chromeDriverLog-rest
-debug-kv ::= "\"_debug\"" space ":" space -debug
-debug-rest ::= ( "," space additional-kv )*
-debug-screenshot ::= "\"" char{1,512} "\""
-debug-screenshot-kv ::= "\"screenshot\"" space ":" space -debug-screenshot
-metadata ::= "{" space -metadata-status-kv "," space -metadata-crawlTime-kv "," space -metadata-spider-kv "," space -metadata-crawlArgs-kv space "}"
-metadata-crawlArgs ::= "[" space (-metadata-crawlArgs-item ("," space -metadata-crawlArgs-item)*)? space "]"
-metadata-crawlArgs-item ::= "\"" ("sha256:" -metadata-crawlArgs-item-1{64,64}) "\""
-metadata-crawlArgs-item-1 ::= [a-f0-9]
-metadata-crawlArgs-kv ::= "\"crawlArgs\"" space ":" space -metadata-crawlArgs
-metadata-crawlTime ::= "{" space -metadata-crawlTime-started-kv "," space -metadata-crawlTime-durationInMs-kv space "}"
-metadata-crawlTime-durationInMs ::= ([0] | [1-9] [0-9]{0,15})
-metadata-crawlTime-durationInMs-kv ::= "\"durationInMs\"" space ":" space -metadata-crawlTime-durationInMs
-metadata-crawlTime-kv ::= "\"crawlTime\"" space ":" space -metadata-crawlTime
-metadata-crawlTime-started-kv ::= "\"started\"" space ":" space string
-metadata-kv ::= "\"_metadata\"" space ":" space -metadata
-metadata-spider ::= "{" space -metadata-spider-name-kv "," space -metadata-spider-version-kv space "}"
-metadata-spider-kv ::= "\"spider\"" space ":" space -metadata-spider
-metadata-spider-name-kv ::= "\"name\"" space ":" space string
-metadata-spider-version ::= "\"" ("sha256:" -metadata-spider-version-1{64,64}) "\""
-metadata-spider-version-1 ::= [a-f0-9]
-metadata-spider-version-kv ::= "\"version\"" space ":" space -metadata-spider-version
-metadata-status ::= "{" space -metadata-status-code-kv "," space -metadata-status-message-kv space "}"
-metadata-status-code ::= ([0] | [1-9] [0-9]{0,15})
-metadata-status-code-kv ::= "\"code\"" space ":" space -metadata-status-code
-metadata-status-kv ::= "\"status\"" space ":" space -metadata-status
-metadata-status-message-kv ::= "\"message\"" space ":" space string
additional-k ::= ["] ( [_] ([d] ([e] ([b] ([u] ([g] char+ | [^"g] char*) | [^"u] char*) | [^"b] char*) | [^"e] char*) | [m] ([e] ([t] ([a] ([d] ([a] ([t] ([a] char+ | [^"a] char*) | [^"t] char*) | [^"a] char*) | [^"d] char*) | [^"a] char*) | [^"t] char*) | [^"e] char*) | [^"dm] char*) | [^"_] char* )? ["]
additional-kv ::= additional-k ":" space value
array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
root ::= "{" space -metadata-kv ( "," space ( -debug-kv -debug-rest | additional-kv ( "," space additional-kv )* ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
value ::= object | array | string | number | boolean | null

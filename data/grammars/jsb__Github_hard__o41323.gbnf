array ::= "[" space ( value ("," space value)* )? space "]"
boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
config ::= "{" space config-basetime-kv "," space config-mni-kv "," space config-cpus-kv "," space config-no-axialize-kv "," space config-keep-int-kv "," space config-tpattern-gen-kv "," space config-native-kv "," space config-daw-kv ( "," space ( config-tr-kv ) )? space "}"
config-basetime-kv ::= "\"basetime\"" space ":" space string
config-cpus-kv ::= "\"cpus\"" space ":" space integer
config-daw-kv ::= "\"daw\"" space ":" space integer
config-keep-int-kv ::= "\"keep_int\"" space ":" space boolean
config-kv ::= "\"config\"" space ":" space config
config-mni-kv ::= "\"mni\"" space ":" space boolean
config-native-kv ::= "\"native\"" space ":" space boolean
config-no-axialize-kv ::= "\"no_axialize\"" space ":" space boolean
config-tpattern-gen-kv ::= "\"tpattern_gen\"" space ":" space boolean
config-tr-kv ::= "\"tr\"" space ":" space number
decimal-part ::= [0-9]{1,16}
inputs ::= "{" space inputs-api-key-kv "," space inputs-functional-kv ( "," space ( inputs-anatomical-kv inputs-anatomical-rest | inputs-slice-timing-kv ) )? space "}"
inputs-anatomical ::= "{" space  (inputs-anatomical-type-kv )? space "}"
inputs-anatomical-kv ::= "\"anatomical\"" space ":" space inputs-anatomical
inputs-anatomical-rest ::= ( "," space inputs-slice-timing-kv )?
inputs-anatomical-type ::= ("\"nifti\"")
inputs-anatomical-type-kv ::= "\"type\"" space ":" space inputs-anatomical-type
inputs-api-key ::= object
inputs-api-key-kv ::= "\"api_key\"" space ":" space inputs-api-key
inputs-functional ::= "{" space  (inputs-functional-type-kv )? space "}"
inputs-functional-kv ::= "\"functional\"" space ":" space inputs-functional
inputs-functional-type ::= ("\"dicom\"")
inputs-functional-type-kv ::= "\"type\"" space ":" space inputs-functional-type
inputs-kv ::= "\"inputs\"" space ":" space inputs
inputs-slice-timing ::= "{" space  (inputs-slice-timing-type-kv )? space "}"
inputs-slice-timing-kv ::= "\"slice_timing\"" space ":" space inputs-slice-timing
inputs-slice-timing-type ::= ("\"text\"")
inputs-slice-timing-type-kv ::= "\"type\"" space ":" space inputs-slice-timing-type
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
root ::= "{" space config-kv "," space inputs-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
value ::= object | array | string | number | boolean | null

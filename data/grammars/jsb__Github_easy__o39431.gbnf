char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
projectDetails ::= "[" space (projectDetails-item ("," space projectDetails-item)*)? space "]"
projectDetails-item ::= ref-definitions-ProjectDetails
projectDetails-kv ::= "\"projectDetails\"" space ":" space projectDetails
ref-definitions-ProjectDetails ::= "{" space  (ref-definitions-ProjectDetails-name-kv )? space "}"
ref-definitions-ProjectDetails-name-kv ::= "\"name\"" space ":" space string
root ::= "{" space totalSize-kv ( "," space ( projectDetails-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
totalSize-kv ::= "\"totalSize\"" space ":" space integer

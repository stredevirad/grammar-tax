additional-k ::= ["] ( [a] ([s] ([m] ([_] ([g] ([r] ([o] ([u] ([p] ([_] ([i] ([d] char+ | [^"d] char*) | [^"i] char*) | [^"_] char*) | [^"p] char*) | [^"u] char*) | [^"o] char*) | [^"r] char*) | [^"g] char*) | [^"_] char*) | [^"m] char*) | [^"s] char*) | [c] ([a] ([t] ([e] ([g] ([o] ([r] ([y] char+ | [^"y] char*) | [^"r] char*) | [^"o] char*) | [^"g] char*) | [^"e] char*) | [^"t] char*) | [^"a] char*) | [e] ([m] ([a] ([i] ([l] char+ | [^"l] char*) | [^"i] char*) | [^"a] char*) | [^"m] char*) | [i] ([p] char+ | [^"p] char*) | [m] ([a] ([r] ([k] ([e] ([t] ([i] ([n] ([g] ([_] ([c] ([a] ([m] ([p] ([a] ([i] ([g] ([n] ([_] ([i] ([d] char+ | [^"d] char*) | [n] ([a] ([m] ([e] char+ | [^"e] char*) | [^"m] char*) | [^"a] char*) | [s] ([p] ([l] ([i] ([t] ([_] ([i] ([d] char+ | [^"d] char*) | [^"i] char*) | [^"_] char*) | [^"t] char*) | [^"i] char*) | [^"l] char*) | [^"p] char*) | [v] ([e] ([r] ([s] ([i] ([o] ([n] char+ | [^"n] char*) | [^"o] char*) | [^"i] char*) | [^"s] char*) | [^"r] char*) | [^"e] char*) | [^"insv] char*) | [^"_] char*) | [^"n] char*) | [^"g] char*) | [^"i] char*) | [^"a] char*) | [^"p] char*) | [^"m] char*) | [^"a] char*) | [^"c] char*) | [^"_] char*) | [^"g] char*) | [^"n] char*) | [^"i] char*) | [^"t] char*) | [^"e] char*) | [^"k] char*) | [^"r] char*) | [^"a] char*) | [s] ([g] ([_] ([e] ([v] ([e] ([n] ([t] ([_] ([i] ([d] char+ | [^"d] char*) | [^"i] char*) | [^"_] char*) | [^"t] char*) | [^"n] char*) | [^"e] char*) | [^"v] char*) | [m] ([e] ([s] ([s] ([a] ([g] ([e] ([_] ([i] ([d] char+ | [^"d] char*) | [^"i] char*) | [^"_] char*) | [^"e] char*) | [^"g] char*) | [^"a] char*) | [^"s] char*) | [^"s] char*) | [^"e] char*) | [^"em] char*) | [^"_] char*) | [m] ([t] ([p] ([-] ([i] ([d] char+ | [^"d] char*) | [^"i] char*) | [^"-] char*) | [^"p] char*) | [^"t] char*) | [^"gm] char*) | [t] ([i] ([m] ([e] ([s] ([t] ([a] ([m] ([p] char+ | [^"p] char*) | [^"m] char*) | [^"a] char*) | [^"t] char*) | [^"s] char*) | [^"e] char*) | [^"m] char*) | [^"i] char*) | [u] ([r] ([l] char+ | [^"l] char*) | [s] ([e] ([r] ([a] ([g] ([e] ([n] ([t] char+ | [^"t] char*) | [^"n] char*) | [^"e] char*) | [^"g] char*) | [^"a] char*) | [^"r] char*) | [^"e] char*) | [^"rs] char*) | [^"aceimstu] char* )? ["]
additional-kv ::= additional-k ":" space value
array ::= "[" space ( value ("," space value)* )? space "]"
asm-group-id ::= ([0-9] | ([1-8] [0-9] | [9] [0-9]) | ([1-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])) | ([1-8] [0-9]{3} | [9] ([0-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9]))) | ([1-2] [0-9]{4} | [3] ([0-1] [0-9]{3} | [2] ([0-6] [0-9]{2} | [7] ([0-5] [0-9] | [6] [0-7])))))
asm-group-id-kv ::= "\"asm_group_id\"" space ":" space asm-group-id
asm-group-id-rest ::= ( "," space category-kv )? category-rest
boolean ::= ("true" | "false")
category ::= category-0 | string
category-0 ::= "[" space (string ("," space string)*)? space "]"
category-kv ::= "\"category\"" space ":" space category
category-rest ::= ( "," space email-kv )? email-rest
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
email-kv ::= "\"email\"" space ":" space string
email-rest ::= ( "," space ip-kv )? ip-rest
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
ip-kv ::= "\"ip\"" space ":" space string
ip-rest ::= ( "," space marketing-campaign-id-kv )? marketing-campaign-id-rest
marketing-campaign-id-kv ::= "\"marketing_campaign_id\"" space ":" space integer
marketing-campaign-id-rest ::= ( "," space marketing-campaign-name-kv )? marketing-campaign-name-rest
marketing-campaign-name-kv ::= "\"marketing_campaign_name\"" space ":" space string
marketing-campaign-name-rest ::= ( "," space marketing-campaign-split-id-kv )? marketing-campaign-split-id-rest
marketing-campaign-split-id-kv ::= "\"marketing_campaign_split_id\"" space ":" space integer
marketing-campaign-split-id-rest ::= ( "," space marketing-campaign-version-kv )? marketing-campaign-version-rest
marketing-campaign-version-kv ::= "\"marketing_campaign_version\"" space ":" space string
marketing-campaign-version-rest ::= ( "," space sg-event-id-kv )? sg-event-id-rest
null ::= "null"
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? space "}"
root ::= "{" space  (asm-group-id-kv asm-group-id-rest | category-kv category-rest | email-kv email-rest | ip-kv ip-rest | marketing-campaign-id-kv marketing-campaign-id-rest | marketing-campaign-name-kv marketing-campaign-name-rest | marketing-campaign-split-id-kv marketing-campaign-split-id-rest | marketing-campaign-version-kv marketing-campaign-version-rest | sg-event-id-kv sg-event-id-rest | sg-message-id-kv sg-message-id-rest | smtp-id-kv smtp-id-rest | timestamp-kv timestamp-rest | url-kv url-rest | useragent-kv useragent-rest | additional-kv ( "," space additional-kv )* )? space "}"
sg-event-id ::= "\"" char{22,4096} "\""
sg-event-id-kv ::= "\"sg_event_id\"" space ":" space sg-event-id
sg-event-id-rest ::= ( "," space sg-message-id-kv )? sg-message-id-rest
sg-message-id-kv ::= "\"sg_message_id\"" space ":" space string
sg-message-id-rest ::= ( "," space smtp-id-kv )? smtp-id-rest
smtp-id-kv ::= "\"smtp-id\"" space ":" space string
smtp-id-rest ::= ( "," space timestamp-kv )? timestamp-rest
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
timestamp-kv ::= "\"timestamp\"" space ":" space string
timestamp-rest ::= ( "," space url-kv )? url-rest
url-kv ::= "\"url\"" space ":" space string
url-rest ::= ( "," space useragent-kv )? useragent-rest
useragent-kv ::= "\"useragent\"" space ":" space string
useragent-rest ::= ( "," space additional-kv )*
value ::= object | array | string | number | boolean | null

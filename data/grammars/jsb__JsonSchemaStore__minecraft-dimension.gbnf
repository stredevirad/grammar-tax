boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
generator ::= "{" space  (generator-type-kv )? space "}"
generator-kv ::= "\"generator\"" space ":" space generator
generator-type ::= ("\"minecraft:flat\"" | "\"minecraft:noise\"" | "\"minecraft:debug\"")
generator-type-kv ::= "\"type\"" space ":" space generator-type
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
ref-definitions-dimensionType ::= "{" space  (ref-definitions-dimensionType-name-kv ref-definitions-dimensionType-name-rest | ref-definitions-dimensionType-ultrawarm-kv ref-definitions-dimensionType-ultrawarm-rest | ref-definitions-dimensionType-natural-kv ref-definitions-dimensionType-natural-rest | ref-definitions-dimensionType-coordinate-scale-kv ref-definitions-dimensionType-coordinate-scale-rest | ref-definitions-dimensionType-has-skylight-kv ref-definitions-dimensionType-has-skylight-rest | ref-definitions-dimensionType-has-ceiling-kv ref-definitions-dimensionType-has-ceiling-rest | ref-definitions-dimensionType-ambient-light-kv ref-definitions-dimensionType-ambient-light-rest | ref-definitions-dimensionType-fixed-time-kv ref-definitions-dimensionType-fixed-time-rest | ref-definitions-dimensionType-piglin-safe-kv ref-definitions-dimensionType-piglin-safe-rest | ref-definitions-dimensionType-bed-works-kv ref-definitions-dimensionType-bed-works-rest | ref-definitions-dimensionType-respawn-anchor-works-kv ref-definitions-dimensionType-respawn-anchor-works-rest | ref-definitions-dimensionType-has-raids-kv ref-definitions-dimensionType-has-raids-rest | ref-definitions-dimensionType-logical-height-kv ref-definitions-dimensionType-logical-height-rest | ref-definitions-dimensionType-min-y-kv ref-definitions-dimensionType-min-y-rest | ref-definitions-dimensionType-height-kv ref-definitions-dimensionType-height-rest | ref-definitions-dimensionType-infiniburn-kv ref-definitions-dimensionType-infiniburn-rest | ref-definitions-dimensionType-effects-kv )? space "}"
ref-definitions-dimensionType-ambient-light-kv ::= "\"ambient_light\"" space ":" space number
ref-definitions-dimensionType-ambient-light-rest ::= ( "," space ref-definitions-dimensionType-fixed-time-kv )? ref-definitions-dimensionType-fixed-time-rest
ref-definitions-dimensionType-bed-works-kv ::= "\"bed_works\"" space ":" space boolean
ref-definitions-dimensionType-bed-works-rest ::= ( "," space ref-definitions-dimensionType-respawn-anchor-works-kv )? ref-definitions-dimensionType-respawn-anchor-works-rest
ref-definitions-dimensionType-coordinate-scale-kv ::= "\"coordinate_scale\"" space ":" space number
ref-definitions-dimensionType-coordinate-scale-rest ::= ( "," space ref-definitions-dimensionType-has-skylight-kv )? ref-definitions-dimensionType-has-skylight-rest
ref-definitions-dimensionType-effects ::= ("\"minecraft:overworld\"" | "\"minecraft:the_nether\"" | "\"minecraft:the_end\"")
ref-definitions-dimensionType-effects-kv ::= "\"effects\"" space ":" space ref-definitions-dimensionType-effects
ref-definitions-dimensionType-fixed-time ::= boolean | ref-definitions-dimensionType-fixed-time-1
ref-definitions-dimensionType-fixed-time-1 ::= ([0-9] | ([1-8] [0-9] | [9] [0-9]) | ([1-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])) | ([1-8] [0-9]{3} | [9] ([0-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9]))) | ([1] [0-9]{4} | [2] ([0-3] [0-9]{3} | [4] "000")))
ref-definitions-dimensionType-fixed-time-kv ::= "\"fixed_time\"" space ":" space ref-definitions-dimensionType-fixed-time
ref-definitions-dimensionType-fixed-time-rest ::= ( "," space ref-definitions-dimensionType-piglin-safe-kv )? ref-definitions-dimensionType-piglin-safe-rest
ref-definitions-dimensionType-has-ceiling-kv ::= "\"has_ceiling\"" space ":" space boolean
ref-definitions-dimensionType-has-ceiling-rest ::= ( "," space ref-definitions-dimensionType-ambient-light-kv )? ref-definitions-dimensionType-ambient-light-rest
ref-definitions-dimensionType-has-raids-kv ::= "\"has_raids\"" space ":" space boolean
ref-definitions-dimensionType-has-raids-rest ::= ( "," space ref-definitions-dimensionType-logical-height-kv )? ref-definitions-dimensionType-logical-height-rest
ref-definitions-dimensionType-has-skylight-kv ::= "\"has_skylight\"" space ":" space boolean
ref-definitions-dimensionType-has-skylight-rest ::= ( "," space ref-definitions-dimensionType-has-ceiling-kv )? ref-definitions-dimensionType-has-ceiling-rest
ref-definitions-dimensionType-height ::= ([0-9] | ([1-8] [0-9] | [9] [0-9]) | ([1-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])) | ([1-3] [0-9]{3} | [4] "0" ([0-8] [0-9] | [9] [0-6])))
ref-definitions-dimensionType-height-kv ::= "\"height\"" space ":" space ref-definitions-dimensionType-height
ref-definitions-dimensionType-height-rest ::= ( "," space ref-definitions-dimensionType-infiniburn-kv )? ref-definitions-dimensionType-infiniburn-rest
ref-definitions-dimensionType-infiniburn-kv ::= "\"infiniburn\"" space ":" space string
ref-definitions-dimensionType-infiniburn-rest ::= ( "," space ref-definitions-dimensionType-effects-kv )?
ref-definitions-dimensionType-logical-height-kv ::= "\"logical_height\"" space ":" space integer
ref-definitions-dimensionType-logical-height-rest ::= ( "," space ref-definitions-dimensionType-min-y-kv )? ref-definitions-dimensionType-min-y-rest
ref-definitions-dimensionType-min-y ::= ("-" ([0-9] | ([1-8] [0-9] | [9] [0-9]) | ([1-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])) | ([1] [0-9]{3} | [2] "0" ([0-2] [0-9] | [3] [0-2]))) | [0-9] | ([1-8] [0-9] | [9] [0-9]) | ([1-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])) | ([1] [0-9]{3} | [2] "0" ([0-2] [0-9] | [3] [0-1])))
ref-definitions-dimensionType-min-y-kv ::= "\"min_y\"" space ":" space ref-definitions-dimensionType-min-y
ref-definitions-dimensionType-min-y-rest ::= ( "," space ref-definitions-dimensionType-height-kv )? ref-definitions-dimensionType-height-rest
ref-definitions-dimensionType-name-kv ::= "\"name\"" space ":" space string
ref-definitions-dimensionType-name-rest ::= ( "," space ref-definitions-dimensionType-ultrawarm-kv )? ref-definitions-dimensionType-ultrawarm-rest
ref-definitions-dimensionType-natural-kv ::= "\"natural\"" space ":" space boolean
ref-definitions-dimensionType-natural-rest ::= ( "," space ref-definitions-dimensionType-coordinate-scale-kv )? ref-definitions-dimensionType-coordinate-scale-rest
ref-definitions-dimensionType-piglin-safe-kv ::= "\"piglin_safe\"" space ":" space boolean
ref-definitions-dimensionType-piglin-safe-rest ::= ( "," space ref-definitions-dimensionType-bed-works-kv )? ref-definitions-dimensionType-bed-works-rest
ref-definitions-dimensionType-respawn-anchor-works-kv ::= "\"respawn_anchor_works\"" space ":" space boolean
ref-definitions-dimensionType-respawn-anchor-works-rest ::= ( "," space ref-definitions-dimensionType-has-raids-kv )? ref-definitions-dimensionType-has-raids-rest
ref-definitions-dimensionType-ultrawarm-kv ::= "\"ultrawarm\"" space ":" space boolean
ref-definitions-dimensionType-ultrawarm-rest ::= ( "," space ref-definitions-dimensionType-natural-kv )? ref-definitions-dimensionType-natural-rest
root ::= "{" space  (type-kv type-rest | generator-kv )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
type ::= type-0 | type-1
type-0 ::= ("\"minecraft:overworld\"" | "\"minecraft:overworld_caves\"" | "\"minecraft:the_nether\"" | "\"minecraft:the_end\"")
type-1 ::= ref-definitions-dimensionType
type-kv ::= "\"type\"" space ":" space type
type-rest ::= ( "," space generator-kv )?

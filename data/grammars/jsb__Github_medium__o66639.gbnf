boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
domains ::= "[" space (domains-item ("," space domains-item)*)? space "]"
domains-item ::= "{" space domains-item-id-kv "," space domains-item-subtitle-kv "," space domains-item-title-kv space "}"
domains-item-id-kv ::= "\"id\"" space ":" space string
domains-item-subtitle-kv ::= "\"subtitle\"" space ":" space string
domains-item-title-kv ::= "\"title\"" space ":" space string
domains-kv ::= "\"domains\"" space ":" space domains
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
metadata ::= "{" space  (metadata-author-kv metadata-author-rest | metadata-description-kv metadata-description-rest | metadata-title-kv )? space "}"
metadata-author-kv ::= "\"author\"" space ":" space string
metadata-author-rest ::= ( "," space metadata-description-kv )? metadata-description-rest
metadata-description-kv ::= "\"description\"" space ":" space string
metadata-description-rest ::= ( "," space metadata-title-kv )?
metadata-kv ::= "\"metadata\"" space ":" space metadata
metadata-title-kv ::= "\"title\"" space ":" space string
root ::= "{" space domains-kv "," space steps-kv ( "," space ( metadata-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
steps ::= "[" space (steps-item ("," space steps-item)*)? space "]"
steps-item ::= "{" space steps-item-domain-kv "," space steps-item-id-kv "," space steps-item-title-kv "," space steps-item-type-kv ( "," space ( steps-item-emphasized-kv steps-item-emphasized-rest | steps-item-predecessors-kv steps-item-predecessors-rest | steps-item-problems-kv steps-item-problems-rest | steps-item-value-generic-kv steps-item-value-generic-rest | steps-item-value-specific-kv ) )? space "}"
steps-item-domain ::= "{" space steps-item-domain-id-kv "," space steps-item-domain-region-kv space "}"
steps-item-domain-id-kv ::= "\"id\"" space ":" space string
steps-item-domain-kv ::= "\"domain\"" space ":" space steps-item-domain
steps-item-domain-region ::= "{" space steps-item-domain-region-type-kv "," space steps-item-domain-region-with-domain-kv space "}"
steps-item-domain-region-kv ::= "\"region\"" space ":" space steps-item-domain-region
steps-item-domain-region-type ::= ("\"independent\"" | "\"surrogate\"" | "\"direct_leading\"" | "\"direct_shared\"")
steps-item-domain-region-type-kv ::= "\"type\"" space ":" space steps-item-domain-region-type
steps-item-domain-region-with-domain-kv ::= "\"with_domain\"" space ":" space string
steps-item-emphasized-kv ::= "\"emphasized\"" space ":" space boolean
steps-item-emphasized-rest ::= ( "," space steps-item-predecessors-kv )? steps-item-predecessors-rest
steps-item-id-kv ::= "\"id\"" space ":" space string
steps-item-predecessors ::= "[" space (steps-item-predecessors-item ("," space steps-item-predecessors-item)*)? space "]"
steps-item-predecessors-item ::= "{" space steps-item-predecessors-item-id-kv "," space steps-item-predecessors-item-type-kv ( "," space ( steps-item-predecessors-item-title-kv ) )? space "}"
steps-item-predecessors-item-id-kv ::= "\"id\"" space ":" space string
steps-item-predecessors-item-title-kv ::= "\"title\"" space ":" space string
steps-item-predecessors-item-type ::= ("\"normal_relationship\"" | "\"loose_temporal_relationship\"")
steps-item-predecessors-item-type-kv ::= "\"type\"" space ":" space steps-item-predecessors-item-type
steps-item-predecessors-kv ::= "\"predecessors\"" space ":" space steps-item-predecessors
steps-item-predecessors-rest ::= ( "," space steps-item-problems-kv )? steps-item-problems-rest
steps-item-problems ::= "[" space (steps-item-problems-item ("," space steps-item-problems-item)*)? space "]"
steps-item-problems-item ::= "{" space  (steps-item-problems-item-description-kv steps-item-problems-item-description-rest | steps-item-problems-item-type-kv )? space "}"
steps-item-problems-item-description-kv ::= "\"description\"" space ":" space string
steps-item-problems-item-description-rest ::= ( "," space steps-item-problems-item-type-kv )?
steps-item-problems-item-type ::= ("\"inconvenient\"" | "\"confusing\"" | "\"difficult\"" | "\"likely_to_fail\"")
steps-item-problems-item-type-kv ::= "\"type\"" space ":" space steps-item-problems-item-type
steps-item-problems-kv ::= "\"problems\"" space ":" space steps-item-problems
steps-item-problems-rest ::= ( "," space steps-item-value-generic-kv )? steps-item-value-generic-rest
steps-item-title-kv ::= "\"title\"" space ":" space string
steps-item-type ::= ("\"process\"" | "\"decision\"" | "\"wait\"" | "\"divergent_process\"")
steps-item-type-kv ::= "\"type\"" space ":" space steps-item-type
steps-item-value-generic-kv ::= "\"value_generic\"" space ":" space integer
steps-item-value-generic-rest ::= ( "," space steps-item-value-specific-kv )?
steps-item-value-specific-kv ::= "\"value_specific\"" space ":" space integer
steps-kv ::= "\"steps\"" space ":" space steps
string ::= "\"" char* "\""

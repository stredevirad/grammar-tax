char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
name-kv ::= "\"name\"" space ":" space string
null ::= "null"
pattern ::= string | null
pattern-kv ::= "\"pattern\"" space ":" space pattern
root ::= "{" space name-kv ( "," space ( type-kv type-rest | pattern-kv ) )? space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
type ::= ("\"any\"" | "\"int\"" | "\"string\"" | "\"boolean\"")
type-kv ::= "\"type\"" space ":" space type
type-rest ::= ( "," space pattern-kv )?
